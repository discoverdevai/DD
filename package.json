{
  "name": "discoverdev-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cf": "npm run build && npx wrangler dev",
    "check": "astro check",
    "lint": "node scripts/css-logical-lint.mjs && node scripts/i18n-gate.mjs && node scripts/token-lint.mjs",
    "qa:static": "node qa/check-dist.mjs dist",
    "qa": "npm run check && npm run lint && npm run test:unit && npm run build && npm run qa:static && npm run test:gates",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:gates": "node scripts/cta-ids.mjs && node scripts/inbound-links.mjs && node scripts/jsonld-check.mjs && node scripts/consent-gate.mjs && node scripts/redirects-test.mjs --static && node scripts/section-contract.mjs",
    "test:redirects": "node scripts/redirects-test.mjs --base http://localhost:8787",
    "qa:events": "node qa/events.mjs http://127.0.0.1:4400",
    "qa:functional": "node qa/functional.mjs http://localhost:4321",
    "knip": "knip --no-exit-code",
    "build:all": "RELEASE_ALL=1 astro build --outDir dist-all",
    "release-map": "node scripts/release-map.mjs --write"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "posthog-js": "1.438.11"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "chrome-launcher": "1.2.2",
    "knip": "^6.42.1",
    "lighthouse": "13.5.0",
    "playwright": "1.64.1",
    "satori": "0.62.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "wrangler": "4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
