---
// Base layout (07 §16): lang/dir from the locale registry, SEO head per 05 §6, fonts per 06 §4, skip link, shell.
import { Font } from 'astro:assets';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import StickyBookBar from '../components/layout/StickyBookBar.astro';
import { LOCALES, localeOf } from '../i18n/locales';
import { t, AR_PAGES } from '../i18n/t';
import { canonical } from '../lib/seo';
import { OG_PAGES, ogPath } from '../data/og';
import { PUBLIC_CF_BEACON_TOKEN } from 'astro:env/client';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/patterns.css';

type PageType = 'home' | 'offer' | 'service' | 'partners' | 'work_index' | 'case_study' | 'insights_hub' | 'article' | 'about' | 'book' | 'book_confirmed' | 'quiz' | 'legal' | '404' | 'design_system';
interface Props {
  title: string;
  description?: string;
  pageType: PageType;
  jsonLd?: object;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  header?: 'default' | 'minimal';
  stickyBar?: boolean;
  stickyKind?: 'clarity' | 'review';
  footerProof?: boolean;
  footerCore?: boolean;
}
const { title, description, pageType, jsonLd, noindex = false, ogImage: ogImageProp, ogType = 'website', header = 'default', stickyBar = header === 'default', stickyKind = 'clarity', footerProof = true, footerCore = true } = Astro.props;
const locale = localeOf(Astro.currentLocale);
const L = LOCALES[locale];
// A locale that is not live yet (Arabic until reviewed) is never indexed.
const hidden = L.status !== 'live';
const url = canonical(Astro.url.pathname);
// Each page's own build-time card (src/data/og.ts); articles pass theirs; anything else uses the default card.
const route = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '') || '/';
const enRoute = route === '/ar' ? '/' : route.replace(/^\/ar(?=\/)/, '');
const ogImage = ogImageProp ?? (enRoute in OG_PAGES ? ogPath(enRoute) : '/og/default.png');
// hreflang (05): only for pages that exist in both languages, self-referencing and reciprocal; x-default is the English page.
const hasPair = (LOCALES.ar.status as string) === 'live' && (AR_PAGES as readonly string[]).includes(enRoute) && !noindex;
const alt = (r: string) => canonical(r === '/' ? '/' : r);
const altEn = alt(enRoute);
const altAr = alt(enRoute === '/' ? '/ar' : `/ar${enRoute}`);
const ogAbs = new URL(ogImage, 'https://discoverdev.ai').href;
---
<!doctype html>
<html lang={L.code} dir={L.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex || hidden ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={url} />}
    {hasPair && <><link rel="alternate" hreflang="en" href={altEn} /><link rel="alternate" hreflang="ar" href={altAr} /><link rel="alternate" hreflang="x-default" href={altEn} /></>}
    <meta name="theme-color" content="#01082D" /> {/* token-lint-ignore: a meta attribute cannot use CSS variables; equals --blue-975 */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Preload only the face the H1 uses: Manrope on English pages, Plex Arabic 700 on Arabic pages. */}
    <Font cssVariable="--font-heading" preload={locale !== 'ar'} />
    {/* Audit Oct 29: /book's first text is body copy, so Rubik loads early there (CLS 0.154 before). */}
    <Font cssVariable="--font-body" preload={locale !== 'ar' && pageType === 'book'} />
    <Font cssVariable="--font-mono" />
    {/* Arabic: 700 for the H1 and 400 for body text (audit Oct 29: /ar/terms jumped, CLS 0.277). */}
    {locale === 'ar' && <Font cssVariable="--font-arabic" preload={[{ weight: '700' }, { weight: '400' }]} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DiscoverDev" />
    <meta property="og:locale" content={L.ogLocale} />
    {hasPair && <meta property="og:locale:alternate" content={LOCALES[locale === 'ar' ? 'en' : 'ar'].ogLocale} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageType === 'home' ? 'DiscoverDev logo with the line: Turn your idea into a live product in weeks.' : title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogAbs} />
    <slot name="head" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body data-page-type={pageType}>
    <a class="skip-link" href="#main">{t('skip', locale)}</a>
    <Header variant={header} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer proof={footerProof} core={footerCore} />
    {stickyBar && <StickyBookBar kind={stickyKind} />}
    <script>
      // Pointer-tracked light for [data-spotlight] cards on every page (fine pointers only; CSS vars via CSSOM, CSP-safe).
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        // One read + write per frame (rAF): reading the rect right after the last write forced a style recalc per move.
        let last: PointerEvent | null = null;
        const paint = () => {
          const e = last; last = null;
          const el = (e?.target as Element | null)?.closest?.<HTMLElement>('[data-spotlight]');
          if (!e || !el) return;
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        };
        document.addEventListener('pointermove', (e) => { if (!last) requestAnimationFrame(paint); last = e; }, { passive: true });
      }
    </script>
    {PUBLIC_CF_BEACON_TOKEN && Astro.site?.hostname === 'discoverdev.ai' && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: PUBLIC_CF_BEACON_TOKEN })}></script>
    )}
  </body>
</html>

<script>
  // Analytics on every page (07 §9): delegated cta/outbound listeners + PostHog after load. Inert off discoverdev.ai.
  import { initAnalytics } from '../lib/analytics';
  initAnalytics();
</script>

<style>
  .skip-link { position: fixed; inset-block-start: var(--space-2); inset-inline-start: var(--space-2); z-index: var(--z-skip); padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); background: var(--neutral-0); color: var(--blue-800); font-weight: var(--weight-medium); translate: 0 -200%; }
  .skip-link:focus-visible { translate: 0 0; }
  main:focus { outline: none; }
</style>
