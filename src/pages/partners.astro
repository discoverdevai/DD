---
// /partners (04 §4.4, journey J3). Copy: 03 §8 with §0.7 applied (see partners.ts). Schema: 05 §4.2 Service (+ optional FAQPage, 05 §4.8).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/sections/Section.astro';
import CardGrid from '../components/blocks/CardGrid.astro';
import CheckList from '../components/blocks/CheckList.astro';
import FaqSplit from '../components/sections/FaqSplit.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import CtaLink from '../components/ui/CtaLink.astro';
import PartnerModels from '../components/partners/PartnerModels.astro';
import ComparisonTable from '../components/partners/ComparisonTable.astro';
import PartnerProof from '../components/partners/PartnerProof.astro';
import { partners as c } from '../content/copy/en/partners';
import { t } from '../i18n/t';
import { bookHref } from '../data/routes';
import { graph, orgStub, webPage, canonical, faqPage, service } from '../lib/seo';

const url = canonical('/partners');
const priceRow = c.models.rows.find((r) => r.label === 'Price');
const offerTerms = priceRow ? c.models.columns.map((col, i) => `${col}: ${priceRow.cells[i]}.`).join(' ') : c.models.answer;
const serviceLd = service(url, {
  name: 'Partner delivery', serviceType: 'White-label development and staff augmentation', description: c.seo.description,
  audience: 'Software houses and agencies',
  offers: { url: `${url}#models`, description: offerTerms },
});
const faqLd = faqPage(`${url}#faq`, c.faq.items);
const jsonLd = graph(orgStub, serviceLd, webPage('/partners', c.seo.title, c.seo.description, 'WebPage', { mainEntity: { '@id': `${url}#service` } }), faqLd);
---
<BaseLayout title={c.seo.title} description={c.seo.description} pageType="partners" jsonLd={jsonLd}>
  <PageHero page="partners" eyebrow={c.hero.eyebrow} h1={c.hero.h1} lead={c.hero.body} cta="partner">
    <PartnerModels slot="aside" models={c.hero.models} />
  </PageHero>

  <Section id="why" surface="ink" title={c.why.title}>
    <CardGrid items={c.why.cards} />
  </Section>

  <Section id="models" surface="raised" title={c.models.title} lead={c.models.answer}>
    <ComparisonTable id="models-table" caption={c.models.caption} columns={c.models.columns} rows={c.models.rows} />
    <div class="mid-cta">
      <CtaLink href={bookHref('partner')} ctaId="partners_mid_partner" tier="partner" position="mid" target="partner" variant="secondary">{t('cta.partner')}</CtaLink>
    </div>
  </Section>

  <Section id="fit" surface="ink" title={c.fit.title}>
    <CheckList items={c.fit.items} tone="machine" />
  </Section>

  <Section id="quality" surface="ink" title={c.quality.title} divider>
    <p class="answer">{c.quality.body}</p>
  </Section>

  <Section id="proof" surface="ink" title={c.proof.title}>
    <PartnerProof items={c.proof.items} />
  </Section>

  <FaqSplit title={c.faq.title} items={c.faq.items} />

  <CtaBand title={c.band.title} kind="partner" page="partners" />
</BaseLayout>

<style>
  .mid-cta { margin-block-start: var(--space-8); }
  .answer { font-size: var(--text-lg); max-inline-size: var(--measure-lead); }
</style>
