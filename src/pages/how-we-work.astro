---
// /how-we-work (03 §7.13, 04 Oct 16 addition): the detailed DiscoverDev Way. Hero → two ways in (greenfield /
// brownfield) → who does what (journey visual) → the four steps in depth (time, body, you get, frameworks with
// text-free artifact drawings) → FAQ → closer. Home keeps the short version and links here.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import WayFlow from '../components/scenes/WayFlow.astro';
import FaqSplit from '../components/sections/FaqSplit.astro';
import Closer from '../components/sections/Closer.astro';
import Artifact from '../components/how/Artifact.astro';
import { howWeWork as c } from '../content/copy/en/how-we-work';
import { home } from '../content/copy/en/home';
import { href } from '../data/routes';
import { graph, orgStub, webPage, canonical, faqPage } from '../lib/seo';

const url = canonical('/how-we-work');
// HowTo is banned (scripts/jsonld-check.mjs; Google retired HowTo results), so the steps are an ItemList.
const howTo = {
  '@type': 'ItemList', '@id': `${url}#steps`, name: c.steps.title,
  itemListElement: c.steps.items.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.title, description: `${s.body} ${c.steps.getsLabel}: ${s.gets}` })),
};
const faqLd = faqPage(`${url}#faq`, c.faq.items);
const jsonLd = graph(orgStub, webPage('/how-we-work', c.seo.title, c.seo.description, 'WebPage', { mainEntity: { '@id': `${url}#steps` } }), howTo, faqLd);
import SectionHead from '../components/ui/SectionHead.astro';
---
<BaseLayout title={c.seo.title} description={c.seo.description} pageType="about" jsonLd={jsonLd}>
  <PageHero page="how_we_work" eyebrow={c.hero.eyebrow} h1={c.hero.h1} lead={c.hero.lead} cta="clarity" />

  <section class="hw hw--paths" data-surface="ink" aria-labelledby="paths-title">
    <div class="container">
      <SectionHead id="paths-title" title={c.paths.title} measure={24} />
      <p class="hw__lead">{c.paths.lead}</p>
      <ul role="list" class="hw__paths">
        {c.paths.items.map((p) => (
          <li class="hw__path">
            <p class="hw__tag">{p.tag}</p>
            <h3 class="hw__h3"><a href={href(p.key)}>{p.title}</a></h3>
            <p class="hw__body">{p.body}</p>
            <p class="hw__more" aria-hidden="true">{p.link}<span class="icon--dir">→</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="hw" data-surface="ink" aria-labelledby="roles-title">
    <div class="container">
      <SectionHead id="roles-title" label={c.roles.label} title={c.roles.title} measure={24} />
      <p class="hw__lead">{c.roles.body}</p>
      <WayFlow {...home.agile.flow} />
    </div>
  </section>

  <section class="hw" data-surface="ink" aria-labelledby="steps-title">
    <div class="container">
      <SectionHead id="steps-title" label={c.steps.label} title={c.steps.title} measure={24} />
      <ol role="list" class="hw__steps">
        {c.steps.items.map((s, i) => (
          <li class="hw__step">
            <div class="hw__stephead">
              <p class="hw__n">0{i + 1}</p>
              <h3 class="hw__h3">{s.title}</h3>
              <p class="hw__when">{s.when}</p>
              <p class="hw__body">{s.body}</p>
              <p class="hw__gets"><span>{c.steps.getsLabel}</span>{s.gets}</p>
            </div>
            <div class="hw__tools">
              <p class="hw__toolslabel">{c.steps.toolsLabel}</p>
              <ul role="list" class="hw__toolgrid">
                {s.tools.map((tool) => (
                  <li class="hw__tool">
                    <div class="hw__art"><Artifact name={tool.name} /></div>
                    <p class="hw__toolname">{tool.name}</p>
                    <p class="hw__toolwhat">{tool.what}</p>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FaqSplit title={c.faq.title} items={c.faq.items} ctaPage="how_we_work" />
  <Closer title={home.band.title} body={home.band.body} page="how_we_work" />
</BaseLayout>

<style>
  .hw { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .hw__lead { max-inline-size: 44rem; margin-block: var(--space-4) var(--stack-lg); font-size: var(--text-lg); line-height: 1.55; color: var(--color-text-muted); }
  .hw__h3 { font-family: var(--ff-heading); font-size: var(--text-xl); font-weight: var(--weight-bold); color: var(--color-heading); }
  .hw__body { color: var(--color-text-muted); line-height: 1.55; }

  /* Two ways in */
  .hw__paths { display: grid; gap: var(--space-4); }
  @media (width >= 48rem) { .hw__paths { grid-template-columns: 1fr 1fr; } }
  .hw__path { position: relative; display: grid; gap: var(--space-3); align-content: start; padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: color-mix(in oklab, var(--blue-300) 4%, transparent); }
  .hw__path:last-child { border-color: color-mix(in oklab, var(--color-human-mark) 30%, transparent); }
  .hw__tag { justify-self: start; font-family: var(--ff-mono); font-size: var(--text-xs); padding: 2px 8px; border-radius: var(--radius-pill); border: 1px solid var(--color-hairline); color: var(--color-machine-text); }
  .hw__path h3 a { color: inherit; text-decoration: none; }
  .hw__path h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .hw__path:has(a:focus-visible) { outline: var(--focus-width) solid var(--blue-300); outline-offset: var(--focus-offset); }
  .hw__path a:focus-visible { outline: none; }
  .hw__more { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-link); }
  @media (hover: hover) { .hw__path:hover { border-color: color-mix(in oklab, var(--blue-300) 40%, transparent); } }

  /* Steps in depth: step summary left, frameworks with drawings right. */
  .hw__steps { display: grid; gap: var(--space-6); margin-block-start: var(--stack-lg); }
  .hw__step { display: grid; gap: var(--space-6); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: var(--color-surface); }
  @media (width >= 64rem) { .hw__step { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-10); padding: var(--space-8); } }
  .hw__stephead { display: grid; gap: var(--space-3); align-content: start; }
  .hw__n { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .hw__when { justify-self: start; font-family: var(--ff-mono); font-size: var(--text-xs); padding: 2px 8px; border-radius: var(--radius-pill); border: 1px solid color-mix(in oklab, var(--blue-300) 30%, transparent); color: var(--color-machine-text); }
  .hw__gets { display: grid; gap: 2px; padding: var(--space-3); border-radius: var(--radius-md); background: color-mix(in oklab, var(--color-human-mark) 8%, transparent); border: 1px solid color-mix(in oklab, var(--color-human-mark) 25%, transparent); font-size: var(--text-sm); }
  .hw__gets span { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-human-text); }
  .hw__toolslabel { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); margin-block-end: var(--space-3); }
  .hw__toolgrid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); }
  .hw__tool { display: grid; gap: var(--space-2); align-content: start; }
  .hw__art { padding: var(--space-2); border-radius: var(--radius-md); background: var(--color-bg); border: 1px solid var(--color-hairline); }
  .hw__toolname { font-family: var(--ff-heading); font-weight: var(--weight-semibold); color: var(--color-heading); }
  .hw__toolwhat { font-size: var(--text-sm); line-height: 1.45; color: var(--color-text-muted); }
</style>
