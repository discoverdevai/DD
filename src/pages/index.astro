---
// Home v3 (03 §2A, 04 §4.1, docs/strategy-v2.md): DiscoverDev as a product and engineering company built on DiscoverDev Way.
// All-ink "workshop": centred hero + delivery scene, proof band, DiscoverDev Way split, lifecycle timeline, engagements,
// capabilities board, case metric, two-tone why + pillars, split FAQ, horizon closer.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroV2 from '../components/home/HeroV2.astro';
import ProofBand from '../components/home/ProofBand.astro';
import Statement from '../components/home/Statement.astro';
import AgileSplit from '../components/home/AgileSplit.astro';
import WayFlow from '../components/home/WayFlow.astro';
import ProcessTimeline from '../components/home/ProcessTimeline.astro';
import Engagements from '../components/home/Engagements.astro';
import Capabilities from '../components/home/Capabilities.astro';
import CaseMetric from '../components/home/CaseMetric.astro';
import Pillars from '../components/home/Pillars.astro';
import FaqSplit from '../components/home/FaqSplit.astro';
import Closer from '../components/home/Closer.astro';
import { home as c } from '../content/copy/en/home';
import { graph, orgFull, website, webPage, ORG_ID } from '../lib/seo';

const faqLd = { '@type': 'FAQPage', '@id': 'https://discoverdev.ai/#faq', mainEntity: c.faq.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })) };
const jsonLd = graph(orgFull, website, webPage('/', c.seo.title, c.seo.description, 'WebPage', { about: { '@id': ORG_ID } }), faqLd);
---
<BaseLayout title={c.seo.title} description={c.seo.description} pageType="home" jsonLd={jsonLd}>
  <HeroV2 />
  <ProofBand title={c.proofStrip.title} logosTitle={c.proofStrip.logosTitle} items={c.proofStrip.items} projects={c.proofStrip.projects} />
  <Statement id="how-we-work" label={c.agile.label} bright={c.agile.bright} dim={c.agile.dim} ctaPage="home" display>
    <AgileSplit body={c.agile.body} line={c.agile.line}>
      <WayFlow {...c.agile.flow} />
    </AgileSplit>
  </Statement>
  <ProcessTimeline id="lifecycle" eyebrow={c.lifecycle.eyebrow} title={c.lifecycle.title} steps={c.lifecycle.steps} track line={c.lifecycle.line} />
  <Engagements title={c.engagements.title} lead={c.engagements.lead} cards={c.engagements.cards} otherTitle={c.engagements.otherTitle} other={c.engagements.other} />
  <Capabilities title={c.capabilities.title} lead={c.capabilities.lead} groups={c.capabilities.groups} />
  <CaseMetric c={c.caseHighlight} />
  <Statement id="why" surface="navy" label={c.why.title} bright={c.why.leadBright} dim={c.why.leadDim}>
    <Pillars items={c.why.pillars} small={c.why.small} />
  </Statement>
  <FaqSplit title={c.faq.title} items={c.faq.items} />
  <Closer title={c.band.title} body={c.band.body} />
</BaseLayout>
