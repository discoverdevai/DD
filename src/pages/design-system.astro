---
// /design-system (private reference, Oct 18): noindex, not in the sitemap, the nav, llms.txt or any link. Renders the real
// tokens (read from tokens.css) and the shared patterns from the real components, so it cannot drift from the site.
// Swatches are classes from src/styles/ds-swatches.css (generated by scripts/build-tokens.mjs; CSP forbids style attributes).
import '../styles/ds-swatches.css';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/sections/Section.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import CtaLink from '../components/ui/CtaLink.astro';
import LayerChip from '../components/ui/LayerChip.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Device from '../components/ui/Device.astro';
import WindowBar from '../components/ui/WindowBar.astro';
import dashboard from '../../assets/projects/yawmy-dashboard.webp';
import parentHome from '../../assets/projects/yawmy-parent-home.webp';
import { designSystem as c } from '../content/copy/en/design-system';
import { readTokens } from '../../scripts/lib/tokens.mjs';

const tk = readTokens();
const semantic = [...tk.ink].filter(([k]) => k.startsWith('color-') && !/(rgb|disabled|progress|neutral-badge|code)/.test(k));
const deviceTokens = tk.device.filter(([k]) => k !== 'device-edge-light');
const p = c.patterns;
---
<BaseLayout title={c.seo.title} description={c.seo.description} pageType="design_system" noindex stickyBar={false}>
  <PageHero page="design_system" eyebrow={c.hero.eyebrow} h1={c.hero.h1} lead={c.hero.lead} cta="none" proof={false} />

  <Section id="colour" surface="ink" title={c.colour.title} lead={c.colour.lead}>
    <h3 class="ds__h">{c.colour.palette}</h3>
    {Object.entries(tk.ramps).map(([ramp, list]) => (
      <ul role="list" class="ds__swatches" aria-label={ramp}>
        {list.map(([name, value]) => (
          <li class="ds__sw"><span class={`ds__chip sw--${name}`} aria-hidden="true"></span><span class="ds__name">{name}</span><span class="ds__val">{value}</span></li>
        ))}
      </ul>
    ))}
    <h3 class="ds__h">{c.colour.semantic}</h3>
    <ul role="list" class="ds__swatches">
      {semantic.map(([name, value]) => (
        <li class="ds__sw"><span class={`ds__chip sw--${name}`} aria-hidden="true"></span><span class="ds__name">{name}</span><span class="ds__val">{value}</span></li>
      ))}
      {deviceTokens.map(([name, value]) => (
        <li class="ds__sw"><span class={`ds__chip sw--${name}`} aria-hidden="true"></span><span class="ds__name">{name}</span><span class="ds__val">{value}</span></li>
      ))}
    </ul>
    <ul role="list" class="ds__notes">{c.colour.notes.map((n) => <li>{n}</li>)}</ul>
  </Section>

  <Section id="type" surface="ink" title={c.type.title} lead={c.type.lead}>
    <h3 class="ds__h">{c.type.scale}</h3>
    <ul role="list" class="ds__rows">
      {tk.text.map(([name, value]) => (
        <li class="ds__row"><span class="ds__name">{name}</span><span class={`ty--${name} ds__sample`}>{c.type.sample}</span><span class="ds__val">{value}</span></li>
      ))}
    </ul>
    <h3 class="ds__h">{c.type.space}</h3>
    <ul role="list" class="ds__rows">
      {tk.space.map(([name, value]) => (
        <li class="ds__row"><span class="ds__name">{name}</span><span class={`ds__bar sp--${name}`} aria-hidden="true"></span><span class="ds__val">{value}</span></li>
      ))}
    </ul>
    <h3 class="ds__h">{c.type.radius}</h3>
    <ul role="list" class="ds__swatches">
      {tk.radius.map(([name, value]) => (
        <li class="ds__sw"><span class={`ds__box rd--${name}`} aria-hidden="true"></span><span class="ds__name">{name}</span><span class="ds__val">{value}</span></li>
      ))}
    </ul>
  </Section>

  <Section id="patterns" surface="ink" title={c.patterns.title} lead={c.patterns.lead}>
    <div class="ds__patterns">
      <article class="ds__pattern" aria-labelledby="pt-head">
        <h3 id="pt-head" class="ds__h">{p.items.head.name}</h3>
        <div class="ds__demo"><div><SectionHead id="demo-head" label={p.demo.label} title={p.demo.title} /></div></div>
        <p>{p.items.head.use}</p><p class="ds__rule">{p.items.head.rule}</p>
      </article>

      <article class="ds__pattern" aria-labelledby="pt-button">
        <h3 id="pt-button" class="ds__h">{p.items.button.name}</h3>
        <div class="ds__demo ds__demo--row">
          <CtaLink href="#patterns" ctaId="design_system_demo_primary" tier="utility" position="inline" target="clarity">{p.demo.primary}</CtaLink>
          <CtaLink href="#patterns" ctaId="design_system_demo_secondary" tier="utility" position="inline" target="clarity" variant="secondary">{p.demo.secondary}</CtaLink>
          <CtaLink href="#patterns" ctaId="design_system_demo_soft" tier="utility" position="inline" target="clarity" variant="soft">{p.demo.soft}</CtaLink>
          <CtaLink href="#patterns" ctaId="design_system_demo_text" tier="utility" position="inline" target="clarity" variant="text">{p.demo.text}</CtaLink>
        </div>
        <p>{p.items.button.use}</p><p class="ds__rule">{p.items.button.rule}</p>
      </article>

      <article class="ds__pattern" aria-labelledby="pt-tag">
        <h3 id="pt-tag" class="ds__h">{p.items.tag.name}</h3>
        <div class="ds__demo ds__demo--row">
          {p.demo.tags.map((tg) => <span class="tag">{tg}</span>)}
          <LayerChip kind="ai">{p.demo.ai}</LayerChip>
          <LayerChip kind="human">{p.demo.human}</LayerChip>
        </div>
        <p>{p.items.tag.use}</p><p class="ds__rule">{p.items.tag.rule}</p>
      </article>

      <article class="ds__pattern" aria-labelledby="pt-card">
        <h3 id="pt-card" class="ds__h">{p.items.card.name}</h3>
        <div class="ds__demo">
          <div class="ds__card card-link">
            <h4><a href="#patterns">{p.demo.cardTitle}</a></h4>
            <p>{p.demo.cardBody}</p>
          </div>
        </div>
        <p>{p.items.card.use}</p><p class="ds__rule">{p.items.card.rule}</p>
      </article>

      <article class="ds__pattern ds__pattern--wide" aria-labelledby="pt-device">
        <h3 id="pt-device" class="ds__h">{p.items.device.name}</h3>
        <div class="ds__demo ds__demo--device">
          <div class="ds__scene">
            <div class="ds__laptop"><Device kind="laptop"><Image src={dashboard} alt={p.demo.laptopAlt} widths={[480, 800]} sizes="(min-width: 48rem) 28rem, 90vw" loading="lazy" /></Device></div>
            <div class="ds__phone"><Device kind="phone"><Image src={parentHome} alt={p.demo.phoneAlt} widths={[200, 400]} sizes="9rem" loading="lazy" /></Device></div>
          </div>
          <div class="ds__window"><WindowBar><span class="ds__wname">{p.demo.windowName}</span></WindowBar></div>
        </div>
        <p>{p.items.device.use}</p><p class="ds__rule">{p.items.device.rule}</p>
      </article>

      <article class="ds__pattern" aria-labelledby="pt-crumbs">
        <h3 id="pt-crumbs" class="ds__h">{p.items.crumbs.name}</h3>
        <div class="ds__demo"><Breadcrumbs items={[{ label: p.demo.crumbHome, href: '/' }, { label: p.demo.crumbParent, href: '#patterns' }, { label: p.demo.crumbHere }]} /></div>
        <p>{p.items.crumbs.use}</p><p class="ds__rule">{p.items.crumbs.rule}</p>
      </article>
    </div>
  </Section>
</BaseLayout>

<style>
  .ds__h { font-size: var(--text-lg); font-weight: var(--weight-semibold); margin-block: var(--space-8) var(--space-4); }
  .ds__swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); gap: var(--space-3); margin-block-end: var(--space-4); }
  .ds__sw { display: grid; gap: var(--space-1); align-content: start; }
  .ds__chip { display: block; block-size: 3.5rem; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); }
  .ds__box { display: block; inline-size: 100%; block-size: 3.5rem; background: var(--color-surface); border: 1px solid var(--color-border-control); }
  .ds__name { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text); overflow-wrap: anywhere; }
  .ds__val { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); overflow-wrap: anywhere; }
  .ds__notes { display: grid; gap: var(--space-2); margin-block-start: var(--space-6); color: var(--color-text-muted); }
  .ds__rows { display: grid; gap: var(--space-2); }
  .ds__row { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: var(--space-1) var(--space-4); align-items: center; padding-block: var(--space-2); border-block-end: 1px solid var(--color-hairline); }
  .ds__row .ds__val { grid-column: 2; }
  @media (width >= 48rem) { .ds__row { grid-template-columns: 6rem minmax(0, 1fr) 16rem; } .ds__row .ds__val { grid-column: auto; } }
  .ds__sample { font-family: var(--ff-heading); font-weight: var(--weight-semibold); line-height: 1.15; overflow-wrap: anywhere; }
  .ds__bar { display: block; block-size: 0.75rem; max-inline-size: 100%; border-radius: var(--radius-xs); background: var(--color-machine-mark); }
  .ds__patterns { display: grid; gap: var(--space-6); }
  @media (width >= 48rem) { .ds__patterns { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ds__pattern--wide { grid-column: 1 / -1; } }
  .ds__pattern { display: grid; gap: var(--space-3); align-content: start; padding: var(--space-5); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: var(--color-surface); }
  .ds__pattern .ds__h { margin-block: 0; }
  .ds__pattern p { color: var(--color-text-muted); }
  .ds__rule { font-size: var(--text-sm); color: var(--color-text-subtle); }
  .ds__demo { padding: var(--space-5); border-radius: var(--radius-md); background: var(--color-bg); border: 1px solid var(--color-hairline); }
  .ds__demo--row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .ds__card { display: grid; gap: var(--space-2); padding: var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--color-hairline); background: var(--color-surface); }
  .ds__card h4 { font-family: var(--ff-heading); font-size: var(--text-lg); }
  .ds__card a { color: var(--color-heading); text-decoration: none; }
  .ds__demo--device { display: grid; gap: var(--space-6); }
  @media (width >= 48rem) { .ds__demo--device { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); align-items: center; } }
  .ds__scene { position: relative; container-type: inline-size; aspect-ratio: 4 / 3; }
  .ds__laptop { position: absolute; inset-inline-start: 0; inset-block-start: 14%; inline-size: 80%; }
  .ds__phone { position: absolute; inset-inline-end: 2%; inset-block-start: 8%; inline-size: 26%; }
  .ds__window { border-radius: var(--radius-md); border: 1px solid var(--color-hairline); background: var(--color-surface); }
  .ds__wname { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
</style>
