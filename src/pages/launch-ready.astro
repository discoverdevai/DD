---
// /launch-ready, the money page (04 §4.2). Anchors: #what-we-check, #pricing, #guarantee, #book.
// #book links to /book until the gated inline embed ships (07 §10.3, CAL_ON_OFFER).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import RunPanel from '../components/sections/RunPanel.astro';
import Section from '../components/ui/Section.astro';
import CardGrid from '../components/ui/CardGrid.astro';
import CheckList from '../components/ui/CheckList.astro';
import Steps from '../components/ui/Steps.astro';
import ReviewSnapshot from '../components/ui/ReviewSnapshot.astro';
import Faq from '../components/ui/Faq.astro';
import CtaLink from '../components/ui/CtaLink.astro';
import CtaTerms from '../components/ui/CtaTerms.astro';
import { launchReady as c } from '../content/copy/en/launch-ready';
import { t } from '../i18n/t';
import { bookHref, href, isLive, ROUTES } from '../data/routes';
import { graph, orgStub, webPage, canonical, ORG_ID } from '../lib/seo';

const url = canonical('/launch-ready');
const service = {
  '@type': 'Service', '@id': `${url}#service`, name: 'Launch-Ready Review', serviceType: 'Production-readiness and code review for AI-built apps',
  description: c.seo.description, url, provider: { '@id': ORG_ID }, areaServed: ['US', 'SA', 'AE', 'KW', 'EG', 'GB'],
  audience: { '@type': 'BusinessAudience', audienceType: 'Founders with an AI-built or freelancer-built MVP' },
  offers: { '@type': 'Offer', url: `${url}#pricing`, description: c.price.offerTerms },
};
const faqLd = { '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: c.faq.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })) };
const jsonLd = graph(orgStub, service, webPage('/launch-ready', c.seo.title, c.seo.description, 'WebPage', { mainEntity: { '@id': `${url}#service` } }), faqLd);
---
<BaseLayout title={c.seo.title} description={c.seo.description} pageType="offer" jsonLd={jsonLd} stickyKind="review">
  <PageHero page="offer" eyebrow={c.hero.eyebrow} h1={c.hero.h1} lead={c.hero.body} cta="review" ctaHref="#book">
    {isLive('launchCheck') && <CtaLink slot="link" href={href('launchCheck')} ctaId="offer_hero_launch_check" tier="low_commitment" position="hero" target="launch_check" variant="text">{c.hero.quizLink}</CtaLink>}
    <RunPanel slot="aside" />
  </PageHero>

  <Section id="is-this-you" surface="paper" title={c.isThisYou.title}>
    <CheckList items={c.isThisYou.items} tone="machine" />
    <p class="emph">{c.isThisYou.line}</p>
  </Section>

  <Section id="what-we-check" surface="alt" title={c.check.title} lead={c.check.answer}>
    <CardGrid items={c.check.areas} cols={3} />
  </Section>

  <Section id="what-you-get" surface="paper">
    <div class="split">
      <div class="stack">
        <h2 id="what-you-get-title" class="h2">{c.gets.title}</h2>
        <CheckList items={c.gets.items} />
      </div>
      <ReviewSnapshot />
    </div>
  </Section>

  <Section id="timeline" surface="ink" eyebrow="day 0 to day 5" title={c.timeline.title}>
    <Steps steps={c.timeline.steps} />
  </Section>

  <Section id="pricing" surface="paper" title={c.price.title} width="narrow">
    <div class="stack">
      <p class="answer">{c.price.answer}</p>
      <p class="small muted">{c.price.small}</p>
    </div>
  </Section>

  <Section id="guarantee" surface="alt" width="narrow">
    <div class="guarantee">
      <h2 id="guarantee-title" class="h2">{c.guarantee.title}</h2>
      <p>{c.guarantee.body}</p>
    </div>
  </Section>

  <Section id="proof" surface="paper" title={c.proof.title}>
    <article class="case-card">
      <p class="case-card__client">{c.proof.caseTitle}</p>
      <p class="case-card__metric">{c.proof.caseBody}</p>
      {isLive('workEdulens') && <CtaLink href={href('workEdulens')} ctaId="offer_mid_case" tier="secondary" position="mid" target="case" variant="text">{c.proof.caseLink}</CtaLink>}
    </article>
  </Section>

  <Section id="not-for" surface="alt" title={c.notFor.title}>
    <ul role="list" class="notfor">
      {c.notFor.items.map((i) => (
        <li><strong>{i.lead}</strong> {i.text}{'link' in i && isLive(i.link.to) && <> <a href={ROUTES[i.link.to].path}>{i.link.label}</a></>}</li>
      ))}
    </ul>
  </Section>

  <Section id="faq" surface="paper" title={c.faq.title}>
    <Faq items={c.faq.items} />
  </Section>

  <section id="book" class="book" data-surface="inverse" aria-labelledby="book-title" data-cta-band>
    <div class="container--narrow book__inner">
      <h2 id="book-title" class="h2">{c.book.title}</h2>
      <p class="lead">{c.book.body}</p>
      <CtaLink href={bookHref('review')} ctaId="offer_end_review" tier="primary" position="end" target="review">{t('cta.review')}</CtaLink>
      <CtaTerms kind="review" />
      {isLive('launchCheck') && <CtaLink href={href('launchCheck')} ctaId="offer_end_launch_check" tier="low_commitment" position="end" target="launch_check" variant="text">{c.book.quizLink}</CtaLink>}
      <p class="small book__fallback">{c.book.fallback} <a href={`mailto:${t('contact.email')}`} dir="ltr">{t('contact.email')}</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .emph { margin-block-start: var(--space-8); font-weight: var(--weight-medium); font-size: var(--text-lg); }
  .split { display: grid; gap: var(--space-12); }
  @media (width >= 64rem) { .split { grid-template-columns: 1fr 1fr; gap: var(--space-16); align-items: start; } }
  .stack { display: grid; gap: var(--space-5); align-content: start; }
  .answer { font-size: var(--text-lg); }
  .guarantee { display: grid; gap: var(--space-4); padding: var(--space-8); border: 1px solid var(--color-border-subtle); border-inline-start: 4px solid var(--color-human-mark); border-radius: var(--radius-md); background: var(--color-surface); }
  .case-card { display: grid; gap: var(--space-3); max-inline-size: 36rem; padding: var(--space-6); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-md); background: var(--color-surface); }
  .case-card__client { font-size: var(--text-sm); color: var(--color-text-muted); }
  .case-card__metric { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-xl); color: var(--color-heading); }
  .notfor { display: grid; gap: var(--space-4); max-inline-size: var(--measure-prose); }
  .notfor strong { font-weight: var(--weight-semibold); }
  .book { padding-block: var(--section-y); }
  .book__inner { display: grid; gap: var(--space-5); justify-items: start; }
  .book__fallback { color: var(--color-text-muted); }
</style>
