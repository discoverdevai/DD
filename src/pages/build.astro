---
// /build, service page (04 §4.3). Surfaces: hero ink, content paper/alt, process ink, band navy (06 §0).
// Rushr is hidden and proof is anonymized, quotes omitted (03 §0.7 [METRIC], [CONSENT]).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/ui/Section.astro';
import FitList from '../components/ui/FitList.astro';
import CardGrid from '../components/ui/CardGrid.astro';
import CheckList from '../components/ui/CheckList.astro';
import FaqSplit from '../components/home/FaqSplit.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import CtaLink from '../components/ui/CtaLink.astro';
import ProofList from '../components/services/ProofList.astro';
import ServiceGlance from '../components/services/ServiceGlance.astro';
import JourneyStepper from '../components/services/JourneyStepper.astro';
import WeekTrack from '../components/services/WeekTrack.astro';
import TermsDoc from '../components/services/TermsDoc.astro';
import Statement from '../components/home/Statement.astro';
import { t } from '../i18n/t';
import { build as c } from '../content/copy/en/build';
import { href, isLive } from '../data/routes';
import { graph, orgStub, webPage, canonical, ORG_ID } from '../lib/seo';

const url = canonical('/build');
const service = {
  '@type': 'Service', '@id': `${url}#service`, name: 'Build', serviceType: 'MVP development',
  description: c.seo.description, url, provider: { '@id': ORG_ID }, areaServed: ['US', 'SA', 'AE', 'KW', 'EG', 'GB'],
  audience: { '@type': 'BusinessAudience', audienceType: 'Founders ready to build' },
  offers: { '@type': 'Offer', url: `${url}#pricing`, description: c.pricing.answer },
};
const faqLd = { '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: c.faq.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })) };
const jsonLd = graph(orgStub, service, webPage('/build', c.seo.title, c.seo.description, 'WebPage', { mainEntity: { '@id': `${url}#service` } }), faqLd);
---
<BaseLayout title={c.seo.title} description={c.seo.description} pageType="service" jsonLd={jsonLd}>
  <PageHero page="build" eyebrow={c.hero.eyebrow} h1={c.hero.h1} lead={c.hero.body} cta="clarity">
    {isLive('review') && <CtaLink slot="link" href={href('review')} ctaId="build_hero_review" tier="primary" position="hero" target="review" variant="text">{c.hero.reviewLink}</CtaLink>}
    <ServiceGlance slot="aside" name={t('nav.build')} label={c.process.title} steps={c.process.steps} meta={c.hero.meta} />
  </PageHero>

  <JourneyStepper current="build" />

  <WeekTrack title={c.track.title} example={c.track.example} weeks={c.track.weeks} weekLabel={c.track.weekLabel} demoLabel={c.track.demoLabel} liveLabel={c.track.liveLabel} phases={c.process.steps} spans={c.track.spans} />

  <Section id="outcomes" surface="alt" title={c.outcomes.title}>
    <CardGrid items={c.outcomes.items} cols={3} variant="brand" />
    <div class="included">
      <h3 class="included__title">{c.included.title}</h3>
      <CheckList items={c.included.items} class="included__list" />
    </div>
  </Section>

  <Section id="fit" surface="paper" title={c.fit.title}>
    <FitList forTitle={c.fit.forTitle} forItems={c.fit.for} notTitle={c.fit.notTitle} notItems={c.fit.not} />
  </Section>

  <Statement id="quality" surface="navy" bright={c.statement.bright} dim={c.statement.dim} />

  <TermsDoc title={c.terms.title} docTitle={c.terms.docTitle} docMeta={c.terms.docMeta} cols={[
    { title: c.pricing.title, body: c.pricing.answer },
    { title: c.team.title, body: c.team.body, link: c.team.link },
    { title: c.ownership.title, body: c.ownership.body },
  ]} />

  <Section id="proof" surface="paper" title={c.proof.title}>
    <ProofList items={c.proof.items} />
  </Section>

  <FaqSplit surface="paper" title={c.faq.title} items={c.faq.items} />

  <CtaBand title={c.band.title} kind="clarity" page="build" link={{ label: c.band.link, to: 'review' }} />
</BaseLayout>

<style>
  /* v4 pilot (03 §6.12): "What's included" sits under the outcome cards instead of its own band. */
  .included { display: grid; gap: var(--space-4); margin-block-start: var(--space-10); padding-block-start: var(--space-8); border-block-start: 1px solid var(--blue-100); }
  @media (width >= 56rem) { .included { grid-template-columns: 1fr 2fr; align-items: start; } }
  .included__title { font-family: var(--ff-heading); font-size: var(--text-xl); font-weight: var(--weight-bold); color: var(--neutral-950); }
  .included :global(.included__list) { display: grid; gap: var(--space-3) var(--space-8); }
  @media (width >= 40rem) { .included :global(.included__list) { grid-template-columns: 1fr 1fr; } }
</style>
