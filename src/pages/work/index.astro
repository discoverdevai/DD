---
// /work (04 §4.5, 03 §9), anonymized per §0.7. One published case → single full-width card (04 §9). No filters.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import InlineLink from '../../components/ui/InlineLink.astro';
import { work as c } from '../../content/copy/en/work';
import { graph, orgStub, webPage, canonical, ORG_ID } from '../../lib/seo';
import { href } from '../../data/routes';

const caseHref = href('workEdulens');
const jsonLd = graph(orgStub, webPage('/work', c.seo.title, c.seo.description, 'CollectionPage', {
  publisher: { '@id': ORG_ID },
  mainEntity: { '@type': 'ItemList', itemListElement: [{ '@type': 'ListItem', position: 1, url: canonical(caseHref), name: c.card.summary }] },
}));
---
<BaseLayout title={c.seo.title} description={c.seo.description} pageType="work_index" jsonLd={jsonLd}>
  <PageHero page="work" h1={c.h1} lead={c.intro} cta="none" proof={false} />

  <Section id="cases" surface="ink" title="Case studies" titleHidden>
    <article class="case-card" data-spotlight>
      <div class="case-card__figure"><p class="case-card__metric">{c.card.metric}</p><p class="muted">{c.card.metricLabel}</p></div>
      <div class="case-card__body">
        <p class="case-card__tags"><span>{c.card.industry}</span><span>{c.card.region}</span></p>
        <h2 class="h3"><a href={caseHref} data-cta-id="work_card_case" data-cta-tier="secondary" data-cta-position="card" data-cta-target="case">{c.card.client}</a></h2>
        <p>{c.card.summary}</p>
        <p class="case-card__more" aria-hidden="true">{c.card.link}</p>
      </div>
    </article>
  </Section>

  <Section id="more" surface="raised" title={c.more.title}>
    <ul role="list" class="more">
      {c.more.items.map((i) => <li><span><InlineLink text={i.text} link={'link' in i ? i.link : undefined} /></span><span class="more__where">{i.where}</span></li>)}
    </ul>
  </Section>


  <CtaBand title={c.band.title} kind="clarity" page="work" link={{ label: c.band.link, to: 'review' }} />
</BaseLayout>

<style>
  .case-card { position: relative; display: grid; gap: var(--space-6); padding: var(--space-10) var(--space-8); border: 1px solid color-mix(in oklab, var(--blue-300) 22%, transparent); border-radius: var(--radius-lg); background: linear-gradient(180deg, color-mix(in oklab, var(--color-surface) 90%, var(--blue-800)), color-mix(in oklab, var(--color-surface) 40%, transparent)); }
  @media (width >= 48rem) { .case-card { grid-template-columns: 4fr 8fr; align-items: center; } }
  .case-card__metric { font-family: var(--ff-heading); font-weight: var(--weight-extrabold); font-size: clamp(3rem, 2rem + 4vw, 5.5rem); line-height: 1; letter-spacing: -0.05em; color: var(--color-heading); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .case-card__body { display: grid; gap: var(--space-3); }
  .case-card__tags { display: flex; gap: var(--space-2); }
  .case-card__tags span { font-family: var(--ff-mono); font-size: var(--text-xs); padding: 2px 10px; border-radius: var(--radius-pill); border: 1px solid color-mix(in oklab, var(--blue-300) 25%, transparent); color: var(--color-machine-text); }
  .case-card h2 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); font-weight: var(--weight-bold); letter-spacing: -0.03em; }
  .case-card h2 a { color: var(--color-heading); text-decoration: none; }
  .case-card h2 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .case-card h2 a:focus-visible { outline: none; }
  .case-card:has(a:focus-visible) { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-offset); }
  .case-card__more { color: var(--color-link); font-weight: var(--weight-medium); }
  .case-card__more::after { content: ' →'; }
  :dir(rtl) .case-card__more::after { content: ' ←'; }
  @media (hover: hover) { .case-card:hover { border-color: var(--color-border-interactive); } }
  .more { display: grid; gap: 0; }
  .more li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-6); padding-block: var(--space-4); border-block-end: 1px solid var(--color-border-subtle); }
  .more__where { color: var(--color-text-muted); font-size: var(--text-sm); }
</style>
