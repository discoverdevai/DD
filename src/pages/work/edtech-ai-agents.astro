---
// Case study (04 §4.6), anonymized EduLens (D-06, 03 §0.7). Quote, timeline, team and "What's next" omitted.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/work/Breadcrumbs.astro';
import Section from '../../components/ui/Section.astro';
import CheckList from '../../components/ui/CheckList.astro';
import CardGrid from '../../components/ui/CardGrid.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { caseStudy as c } from '../../content/copy/en/work';
import { graph, canonical, ORG_ID, SITE_URL } from '../../lib/seo';
import { href, isLive } from '../../data/routes';

const path = href('workEdulens');
const url = canonical(path);
const crumbs = [{ label: 'Home', href: '/' }, ...(isLive('work') ? [{ label: 'Work', href: href('work') }] : []), { label: c.crumb }];
const jsonLd = graph(
  { '@type': 'Organization', '@id': ORG_ID, name: 'DiscoverDev', url: SITE_URL, logo: `${SITE_URL}/logo-512.png` },
  { '@type': 'Article', '@id': `${url}#article`, headline: c.h1, description: c.seo.description, image: [`${SITE_URL}/og/default.png`], datePublished: c.updated.iso, dateModified: c.updated.iso, author: { '@id': ORG_ID }, publisher: { '@id': ORG_ID }, mainEntityOfPage: url, inLanguage: 'en' },
  { '@type': 'BreadcrumbList', itemListElement: crumbs.map((cr, i) => ({ '@type': 'ListItem', position: i + 1, name: cr.label, ...(cr.href ? { item: cr.href === '/' ? SITE_URL : `${SITE_URL}${cr.href}` } : {}) })) },
);
---
<BaseLayout title={c.seo.title} description={c.seo.description} pageType="case_study" jsonLd={jsonLd} ogType="article">
  <section class="case-hero" data-surface="ink" aria-labelledby="page-title" data-case-slug="edtech-ai-agents" data-industry="EdTech" data-region="MENA">
    <div class="case-hero__grid" aria-hidden="true"></div>
    <div class="case-hero__light" aria-hidden="true"></div>
    <div class="container case-hero__inner">
      <Breadcrumbs items={crumbs} />
      <p class="case-hero__badges"><span>EdTech</span><span>Egypt</span></p>
      <h1 id="page-title" class="case-hero__h1">{c.h1}</h1>
      <p class="case-hero__lead">{c.body}</p>
      <p class="case-hero__metric"><strong>{c.metric.value}</strong> <span>{c.metric.label}</span></p>
      <p class="small muted">{c.updated.label} <time datetime={c.updated.iso}>{c.updated.date}</time></p>
    </div>
  </section>

  <Section id="summary" surface="ink">
    <div class="layout">
      <aside class="snap" aria-labelledby="snap-title">
        <h2 id="snap-title" class="h3">{c.snapshot.title}</h2>
        <dl>{c.snapshot.rows.map((r) => <div><dt>{r.k}</dt><dd>{r.v}</dd></div>)}</dl>
      </aside>
      <div class="story">
        <h2 class="h2" id="summary-title">{c.summary.title}</h2>
        <p class="answer">{c.summary.answer}</p>
        <h2 class="h2">{c.challenge.title}</h2>
        <p>{c.challenge.body}</p>
        <h2 class="h2">{c.built.title}</h2>
        <CheckList items={c.built.items} tone="machine" />
      </div>
    </div>
  </Section>

  <Section id="approach" surface="raised" title={c.approach.title}>
    <CardGrid items={c.approach.items} cols={3} />
  </Section>

  <Section id="results" surface="ink" title={c.results.title} width="narrow">
    <CheckList items={c.results.items} />
  </Section>

  <CtaBand title={c.cta.title} body={c.cta.body} kind="clarity" page="case_edtech" />
</BaseLayout>

<style>
  .case-hero { position: relative; overflow: clip; isolation: isolate; padding-block: var(--space-10) var(--section-y); }
  .case-hero__grid { position: absolute; inset: 0; z-index: -2; background-image: linear-gradient(var(--color-hairline) 1px, transparent 1px), linear-gradient(90deg, var(--color-hairline) 1px, transparent 1px); background-size: 4.5rem 4.5rem; mask-image: radial-gradient(70% 70% at 70% 10%, #000 5%, transparent 75%); opacity: 0.7; }
  .case-hero__light { position: absolute; z-index: -1; inset-block-start: -20%; inset-inline-end: -10%; inline-size: min(70vw, 52rem); aspect-ratio: 1; background: radial-gradient(closest-side, color-mix(in oklab, var(--blue-700) 40%, transparent), transparent); filter: blur(10px); }
  .case-hero__h1 { font-size: clamp(2.25rem, 1.3rem + 3.6vw, 4.25rem); font-weight: var(--weight-bold); line-height: 1.04; letter-spacing: -0.045em; color: var(--color-heading); max-inline-size: 20ch; text-wrap: balance; }
  .case-hero__lead { font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.3125rem); line-height: 1.55; color: var(--color-text-muted); max-inline-size: 42rem; }
  .case-hero__inner { display: grid; gap: var(--space-5); justify-items: start; }
  .case-hero__badges { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .case-hero__badges span { font-family: var(--ff-mono); font-size: var(--text-xs); padding: 2px 10px; border-radius: var(--radius-pill); border: 1px solid color-mix(in oklab, var(--blue-300) 25%, transparent); color: var(--color-machine-text); }
  .case-hero__metric strong { font-family: var(--ff-heading); font-weight: var(--weight-extrabold); font-size: clamp(3rem, 2rem + 4vw, 5.5rem); line-height: 1; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; color: var(--color-heading); }
  .case-hero__metric { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); padding-block: var(--space-4); }
  .case-hero__metric span { color: var(--color-text-muted); font-size: var(--text-lg); }
  .layout { display: grid; gap: var(--space-10); }
  @media (width >= 64rem) { .layout { grid-template-columns: 4fr 8fr; gap: var(--space-16); align-items: start; } }
  .snap { padding: var(--space-6); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); background: linear-gradient(180deg, color-mix(in oklab, var(--color-surface) 90%, var(--blue-800)), color-mix(in oklab, var(--color-surface) 40%, transparent)); display: grid; gap: var(--space-4); }
  @media (width >= 64rem) { .snap { position: sticky; inset-block-start: calc(var(--header-h) + var(--space-8)); } }
  .snap dl { display: grid; gap: var(--space-3); }
  .snap dt { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .snap dd { margin: 0; }
  .story { display: grid; gap: var(--space-5); max-inline-size: var(--measure-prose); }
  .story .h2 { margin-block-start: var(--space-6); font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem); font-weight: var(--weight-semibold); letter-spacing: -0.03em; line-height: 1.15; }
  .story .h2:first-child { margin-block-start: 0; }
  .answer { font-size: var(--text-lg); }
</style>

<script>
  import { track } from '../../lib/analytics';
  const el = document.querySelector<HTMLElement>('[data-case-slug]');
  if (el) track('case_study_viewed', { case_study_slug: el.dataset.caseSlug, industry: el.dataset.industry, region: el.dataset.region });
</script>
