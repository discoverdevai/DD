---
// Hero aside for Build and Scale (03 §16b.38–39, Phase 3, Oct 29): a real client screen instead of a drawing, in the one
// flat product frame (Phase 2), an optional phone at the inline end, and a caption naming the client. Build: NJWAR's
// Arabic store and AR view (Athkado, Saudi Arabia). Scale: Upscend's learner view (UK). Files from assets/projects.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import WindowBar from '../ui/WindowBar.astro';
interface Props { c: { bar: string; web: string; phone?: string; caption: string; alt: string } }
const { c } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('/assets/projects/*.webp');
const load = async (f: string) => (await files[`/assets/projects/${f}`]!()).default;
const web = await load(c.web);
const phone = c.phone ? await load(c.phone) : undefined;
---
<figure class="bs">
  <div class:list={['bs__stage', { 'bs__stage--phone': phone }]}>
    <div class="bs__frame">
      <WindowBar><span class="bs__name" dir="ltr">{c.bar}</span></WindowBar>
      <Image src={web} alt={c.alt} widths={[480, 800, 1100]} sizes="(min-width: 64rem) 40vw, 92vw" class="bs__img" loading="eager" />
    </div>
    {phone && <div class="bs__phone" aria-hidden="true"><Image src={phone} alt="" widths={[180, 320]} sizes="(min-width: 64rem) 11vw, 26vw" class="bs__img" loading="eager" /></div>}
  </div>
  <figcaption class="bs__cap">{c.caption}</figcaption>
</figure>

<style>
  .bs { margin: 0; display: grid; gap: var(--space-4); }
  .bs__stage { position: relative; }
  .bs__stage--phone { padding-block-end: var(--space-8); padding-inline-end: var(--space-6); }
  .bs__frame { overflow: hidden; border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: var(--color-surface); box-shadow: 0 40px 80px -40px color-mix(in oklab, var(--blue-600) 60%, transparent); }
  .bs__name { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .bs :global(.bs__img) { display: block; inline-size: 100%; block-size: auto; }
  .bs__phone { position: absolute; inset-inline-end: 0; inset-block-end: 0; inline-size: 27%; overflow: hidden; border: 6px solid var(--device-body); border-radius: 24px; aspect-ratio: 375 / 812; box-shadow: 0 30px 60px -20px rgb(var(--black-rgb) / 0.85); }
  .bs__phone :global(.bs__img) { block-size: 100%; object-fit: cover; object-position: top; }
  .bs__cap { font-size: var(--text-sm); color: var(--color-text-muted); }
</style>
