---
// ReviewSnapshot (06 §9.6, §0.5): what a Review produces, on paper. Example only, generic findings, no client data.
import { copy } from '../../content/copy';
const c = copy().snapshot;
const SEV = { critical: 'sev--crit', high: 'sev--high', medium: 'sev--med' } as const;
const STATUS = { planned: 'st--plan', fixed: 'st--fix' } as const;
---
<figure class="snap">
  <div class="snap__top"><span class="snap__title">{c.title}</span><span class="snap__meta">{c.meta}</span></div>
  <ol role="list" class="snap__list">
    {c.findings.map((f) => (
      <li class="snap__row">
        <span class:list={['badge', SEV[f.severity]]}>{c.severity[f.severity]}</span>
        <span class="snap__finding">{f.title}</span>
        <span class="snap__area">{f.area}<span class:list={['badge', STATUS[f.status]]}>{c.status[f.status]}</span></span>
      </li>
    ))}
  </ol>
  <div class="snap__foot"><span class="snap__verdict">{c.verdict}</span><span class="snap__quote">{c.quote}</span></div>
  <figcaption class="sr-only">{c.caption}</figcaption>
</figure>

<style>
  .snap { background: var(--color-surface); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; min-inline-size: 0; }
  .snap__top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); padding: var(--space-3) var(--space-5); background: var(--color-surface-sunken); font-size: var(--text-sm); }
  .snap__title { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-heading); }
  .snap__meta { color: var(--color-text-muted); }
  .snap__row { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-1) var(--space-3); padding: var(--space-3) var(--space-5); border-block-start: 1px solid var(--color-border-subtle); }
  .snap__finding { font-weight: var(--weight-medium); line-height: var(--leading-snug); }
  .snap__area { grid-column: 2; display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-text-muted); }
  .snap__foot { display: grid; gap: 2px; padding: var(--space-4) var(--space-5); border-block-start: 1px solid var(--color-border-subtle); }
  .snap__verdict { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-heading); }
  .snap__quote { font-size: var(--text-sm); color: var(--color-text-muted); }
  .badge { display: inline-flex; align-items: center; min-block-size: 1.375rem; padding: 1px 10px; border-radius: var(--radius-pill); font-size: var(--text-xs); font-weight: var(--weight-semibold); line-height: 1.3; white-space: nowrap; align-self: start; }
  .sev--crit { background: var(--color-error-bg); color: var(--color-error-text); }
  .sev--high { background: var(--color-warning-bg); color: var(--color-warning-text); }
  .sev--med { background: var(--color-neutral-badge-bg); color: var(--color-neutral-badge-text); }
  .st--plan { background: var(--color-info-bg); color: var(--color-info-text); }
  .st--fix { background: var(--color-success-bg); color: var(--color-success-text); }
</style>
