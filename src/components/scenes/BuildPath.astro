---
// Build hero aside (03 §16b.6, Oct 26 home-style redesign): the whole path in one product window, in the home scene
// style. Validate (short bar), Build (long bar with a green sign-off mark for every weekly release), Live. Two lanes say
// who does what. Strings come from the page copy; the bars are decorative and the rows carry the same words as text.
import WindowBar from '../ui/WindowBar.astro';
interface Row { title: string; meta: string }
interface Props { c: { name: string; title: string; validate: Row; build: Row; live: Row; ai: string; senior: string; facts: readonly string[] } }
const { c } = Astro.props;
const releases = Array.from({ length: 8 });
---
<div class="bp" data-bp>
  <WindowBar><span class="bp__name">{c.name}</span></WindowBar>
  <p class="bp__title">{c.title}</p>
  <ol role="list" class="bp__rows">
    <li class="bp__row">
      <span class="bp__label">{c.validate.title}<small>{c.validate.meta}</small></span>
      <span class="bp__track" aria-hidden="true"><span class="bp__bar bp__bar--v"></span></span>
    </li>
    <li class="bp__row">
      <span class="bp__label">{c.build.title}<small>{c.build.meta}</small></span>
      <span class="bp__track" aria-hidden="true">
        <span class="bp__bar bp__bar--b"></span>
        <span class="bp__signs">{releases.map(() => <i></i>)}</span>
      </span>
    </li>
    <li class="bp__row">
      <span class="bp__label">{c.live.title}<small>{c.live.meta}</small></span>
      <span class="bp__track" aria-hidden="true"><span class="bp__bar bp__bar--l"></span></span>
    </li>
  </ol>
  <ul role="list" class="bp__lanes">
    <li><i class="bp__key bp__key--ai" aria-hidden="true"></i>{c.ai}</li>
    <li><i class="bp__key bp__key--sr" aria-hidden="true"></i>{c.senior}</li>
  </ul>
  <ul role="list" class="bp__facts">{c.facts.map((f) => <li>{f}</li>)}</ul>
</div>

<style>
  .bp { position: relative; container-type: inline-size; border-radius: var(--radius-lg); background: linear-gradient(180deg, color-mix(in oklab, var(--color-surface) 70%, var(--blue-800)), var(--color-surface) 45%); border: 1px solid var(--color-hairline); overflow: hidden; }
  .bp__name { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .bp__title { padding: var(--space-5) var(--space-5) 0; font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-lg); color: var(--color-heading); letter-spacing: -0.015em; }
  .bp__rows { display: grid; gap: var(--space-4); padding: var(--space-5); }
  .bp__row { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); align-items: center; gap: var(--space-4); }
  @container (inline-size < 26rem) { .bp__row { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); } }
  .bp__label { display: grid; font-weight: var(--weight-semibold); color: var(--color-text); }
  .bp__label small { font-family: var(--ff-mono); font-size: var(--text-xs); font-weight: 400; color: var(--color-text-muted); }
  .bp__track { position: relative; block-size: 1.75rem; border-radius: var(--radius-sm); background: color-mix(in oklab, var(--blue-300) 8%, transparent); }
  .bp__bar { position: absolute; inset-block: 0; border-radius: var(--radius-sm); transform-origin: 0 50%; }
  :dir(rtl) .bp__bar { transform-origin: 100% 50%; }
  .bp__bar--v { inset-inline: 0 84%; background: color-mix(in oklab, var(--blue-300) 40%, transparent); }
  .bp__bar--b { inset-inline: 16% 12%; background: var(--blue-600); }
  .bp__bar--l { inset-inline: 88% 0; background: color-mix(in oklab, var(--color-human-mark) 22%, transparent); border: 1px dashed var(--color-human-mark); }
  .bp__signs { position: absolute; inset-block: 0; inset-inline: 16% 12%; display: grid; grid-template-columns: repeat(8, 1fr); place-items: center; }
  .bp__signs i { inline-size: 9px; block-size: 9px; border-radius: 50%; background: var(--color-human-mark); box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-human-mark) 25%, transparent); }
  .bp__lanes { display: grid; gap: var(--space-2); padding: 0 var(--space-5) var(--space-5); font-size: var(--text-sm); color: var(--color-text-muted); }
  .bp__lanes li { display: flex; align-items: center; gap: var(--space-3); }
  .bp__key { inline-size: 10px; block-size: 10px; border-radius: 3px; flex: none; }
  .bp__key--ai { background: var(--blue-600); }
  .bp__key--sr { background: var(--color-human-mark); border-radius: 50%; }
  .bp__facts { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); padding: var(--space-4) var(--space-5); border-block-start: 1px solid var(--color-hairline); background: color-mix(in oklab, var(--blue-975) 45%, transparent); font-weight: var(--weight-medium); color: var(--color-text); }
  @media (prefers-reduced-motion: no-preference) {
    .bp[data-playing] .bp__bar { transform: scaleX(0); }
    .bp .bp__bar { transition: transform 700ms var(--ease-standard); }
    .bp .bp__bar--b { transition-delay: 250ms; }
    .bp .bp__bar--l { transition-delay: 600ms; }
    .bp[data-playing] .bp__signs i { opacity: 0; }
    .bp .bp__signs i { transition: opacity 300ms ease 900ms; }
  }
</style>

<script>
  import { playOnce } from '../../lib/play-once';
  // Bars grow and sign-off marks appear once, when the window is 40% visible (06 §9.6 cap 2.4s).
  playOnce('[data-bp]', 0.4, 'data-playing', (el) => requestAnimationFrame(() => el.removeAttribute('data-playing')));
</script>
