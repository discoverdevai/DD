---
// Journey visual for The DiscoverDev Way (03 §2A.4, Oct 16): one product screen goes Discover (chalk sketch) → AI drafts
// (dashed blue, mono tag) → A senior signs (the same screen made solid, a dark review panel with checks, signature and a
// green stamp) → Live (the finished screen in colour, Live chip, a rising usage line). Redesigned Oct 16: one screen, four
// states, all on the dark theme (the white sheet and the empty phone read as off-brand).
// Oct 29 (03 §16b.44, Mohamed): step 3 is now a page of the review log (the senior's note, the fix as a diff, Signed off)
// instead of the solid screen with a checklist. Illustration, not a client product. Plays once at 35% visible: cards rise in order, then the signature, stamp and
// live dot land. Transform and opacity only. No JS or reduced motion: the finished state.
interface Step { title: string; line: string }
interface Review { badge: string; who: string; note: string; code: readonly string[] }
interface Props { caption: string; steps: readonly Step[]; tag: string; review: Review; stamp: string; live: string }
const { caption, steps, tag, review, stamp, live } = Astro.props;

// The shared screen layout (viewBox 0 0 160 120): bar, picture, three text lines, button, three cards.
const pic = { x: 12, y: 22, w: 62, h: 48 };
const lines = [{ x: 84, y: 26, w: 62 }, { x: 84, y: 36, w: 50 }, { x: 84, y: 46, w: 38 }];
const btn = { x: 84, y: 56, w: 40, h: 14 };
const cards = [12, 60, 108].map((x) => ({ x, y: 82, w: 40, h: 26 }));

// Chalk: every edge is a slightly bowed stroke that overshoots its corners, from a fixed seed so builds are stable.
let seed = 7;
const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
const j = (n = 1.6) => +((rnd() - 0.5) * n).toFixed(2);
const edge = (x1: number, y1: number, x2: number, y2: number) => {
  const dx = x2 - x1, dy = y2 - y1, len = Math.hypot(dx, dy) || 1, ox = (dx / len) * 1.8, oy = (dy / len) * 1.8;
  return `M${(x1 - ox + j()).toFixed(1)},${(y1 - oy + j()).toFixed(1)} Q${((x1 + x2) / 2 + j(2.4)).toFixed(1)},${((y1 + y2) / 2 + j(2.4)).toFixed(1)} ${(x2 + ox + j()).toFixed(1)},${(y2 + oy + j()).toFixed(1)}`;
};
const box = (b: { x: number; y: number; w: number; h: number }) =>
  [edge(b.x, b.y, b.x + b.w, b.y), edge(b.x + b.w, b.y, b.x + b.w, b.y + b.h), edge(b.x + b.w, b.y + b.h, b.x, b.y + b.h), edge(b.x, b.y + b.h, b.x, b.y)].join(' ');
const sketch = [
  box({ x: 4, y: 4, w: 152, h: 112 }), edge(4, 14, 156, 14), box(pic),
  edge(pic.x + 4, pic.y + pic.h - 4, pic.x + 22, pic.y + 20), edge(pic.x + 22, pic.y + 20, pic.x + 36, pic.y + 34), edge(pic.x + 36, pic.y + 34, pic.x + 46, pic.y + 26), edge(pic.x + 46, pic.y + 26, pic.x + pic.w - 4, pic.y + pic.h - 4),
  ...lines.map((l) => edge(l.x, l.y, l.x + l.w, l.y)), box(btn), ...cards.map(box),
].join(' ');
const check = 'M20 6 9 17l-5-5';
---
<figure class="wf" data-wf>
  <ol role="list" class="wf__steps">
    {steps.map((s, i) => (
      <li class:list={['wf__step', `wf__step--${i + 1}`]}>
        <div class:list={['wf__vis', `wf__vis--${i + 1}`]}>
          {i === 0 && (
            <svg viewBox="0 0 160 120" aria-hidden="true" focusable="false" class="wf__svg wf__chalk">
              <path d={sketch} />
              <path d={sketch} class="wf__chalk-2" />
            </svg>
          )}
          {i === 1 && (
            <>
              <span class="wf__tag"><bdi dir="ltr">{tag}</bdi></span>
              <svg viewBox="0 0 160 120" aria-hidden="true" focusable="false" class="wf__svg wf__draft">
                <rect x="4" y="4" width="152" height="112" rx="4" />
                <path d="M4 14H156" />
                <rect x={pic.x} y={pic.y} width={pic.w} height={pic.h} rx="2" />
                <path d={`M${pic.x + 4} ${pic.y + pic.h - 4}L${pic.x + 22} ${pic.y + 20}L${pic.x + 36} ${pic.y + 34}L${pic.x + 46} ${pic.y + 26}L${pic.x + pic.w - 4} ${pic.y + pic.h - 4}`} />
                {lines.map((l) => <path d={`M${l.x} ${l.y}H${l.x + l.w}`} />)}
                <rect x={btn.x} y={btn.y} width={btn.w} height={btn.h} rx="3" />
                {cards.map((c) => <rect x={c.x} y={c.y} width={c.w} height={c.h} rx="2" />)}
              </svg>
            </>
          )}
          {i === 2 && (
            <div class="wf__log" aria-hidden="true">
              <p class="wf__who"><span class="wf__av">{review.badge}</span>{review.who}</p>
              <p class="wf__note">{review.note}</p>
              <p class="wf__code" dir="ltr">{review.code.map((l) => <span class:list={[l.startsWith('+') ? 'wf__add' : 'wf__del']}>{l}</span>)}</p>
              <p class="wf__ok"><span class="wf__stamp">{stamp}</span><svg viewBox="0 0 24 24" width="12" height="12"><path d={check} fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" /></svg></p>
            </div>
          )}
          {i === 3 && (
            <>
              <span class="wf__live"><span class="wf__dot" aria-hidden="true"></span>{live}</span>
              <svg viewBox="0 0 160 120" aria-hidden="true" focusable="false" class="wf__svg wf__final">
                <defs><linearGradient id="wf-pic" x1="0" y1="0" x2="1" y2="1"><stop offset="0" class="wf__g1" /><stop offset="1" class="wf__g2" /></linearGradient></defs>
                <g class="wf__ph-screen">
                  <rect class="wf__f-frame" x="4" y="4" width="152" height="112" rx="4" />
                  <rect class="wf__f-bar" x="4" y="4" width="152" height="10" rx="4" />
                  <rect x={pic.x} y={pic.y} width={pic.w} height={pic.h} rx="3" fill="url(#wf-pic)" />
                  {lines.map((l, k) => <rect class="wf__f-line" x={l.x} y={l.y - 2} width={l.w} height={k === 0 ? 5 : 3.5} rx="1.75" />)}
                  <rect class="wf__f-btn" x={btn.x} y={btn.y} width={btn.w} height={btn.h} rx="3" />
                  {cards.map((c) => <rect class="wf__f-card" x={c.x} y={c.y} width={c.w} height={c.h} rx="3" />)}
                  <path class="wf__f-trend" d="M14 104 L30 100 L46 101 L62 95 L78 96 L94 89 L110 90 L126 83 L146 76" />
                </g>
              </svg>
            </>
          )}
        </div>
        <h3 class="wf__h"><span class="wf__n" aria-hidden="true">{i + 1}</span>{s.title}</h3>
        <p class="wf__line">{s.line}</p>
      </li>
    ))}
  </ol>
  <figcaption class="sr-only">{caption}</figcaption>
</figure>

<script>
  import { playOnce } from '../../lib/play-once';
  // Once, at 35% visible. Without IntersectionObserver or with reduced motion nothing is armed: the finished state shows.
  playOnce('[data-wf]', 0.35, 'data-armed', (wf) => wf.setAttribute('data-play', ''));
</script>

<style>
  .wf { margin-block: var(--space-4) var(--space-2); }
  .wf__steps { display: grid; gap: var(--space-4); }
  @media (width >= 36rem) { .wf__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (width >= 64rem) { .wf__steps { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); } }
  .wf__step { position: relative; display: grid; grid-template-rows: auto auto 1fr; gap: var(--space-2); align-content: start; padding: var(--space-3); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); background: var(--color-surface); min-inline-size: 0; }
  /* Phones: picture beside the words, so four steps stay short. */
  @media (width < 36rem) { .wf__step { grid-template-columns: 9rem minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: var(--space-4); } .wf__vis { grid-row: 1 / 3; } .wf__h { align-self: end; } }
  /* The order is real, so the steps are joined by an arrow on wide screens. */
  @media (width >= 64rem) {
    .wf__step:not(:last-child)::after { content: ''; position: absolute; z-index: 1; inset-block-start: calc(var(--space-3) + 4.5rem); inset-inline-end: calc(-1 * var(--space-6) + 4px); inline-size: calc(var(--space-6) - 8px); block-size: 2px; background: var(--color-machine-mark); }
    .wf__step:not(:last-child)::before { content: ''; position: absolute; z-index: 1; inset-block-start: calc(var(--space-3) + 4.5rem - 3px); inset-inline-end: calc(-1 * var(--space-6) + 4px); inline-size: 8px; block-size: 8px; border-block-start: 2px solid var(--color-machine-mark); border-inline-end: 2px solid var(--color-machine-mark); rotate: 45deg; }
    :dir(rtl) .wf__step:not(:last-child)::before { rotate: -45deg; }
  }
  .wf__vis { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius-md); overflow: hidden; background: var(--color-bg); }
  .wf__svg { inline-size: 100%; block-size: 100%; }
  .wf__chalk path { fill: none; stroke: var(--neutral-0); stroke-width: 1.4; stroke-linecap: round; opacity: 0.82; }
  .wf__chalk .wf__chalk-2 { stroke-width: 0.7; opacity: 0.35; translate: 0.6px 0.5px; }
  .wf__draft :is(rect, path) { fill: none; stroke: var(--color-machine-mark); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .wf__tag { position: absolute; inset-block-start: var(--space-2); inset-inline-end: var(--space-2); padding: 1px 6px; border-radius: var(--radius-xs); font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); background: color-mix(in oklab, var(--color-machine-mark) 16%, var(--color-bg)); }
  /* 3 · reviewed: a page of the review log, the senior's badge, note, the fix as a diff, then Signed off. */
  .wf__log { position: absolute; inset: 0; display: grid; align-content: center; gap: 6px; padding: var(--space-3); font-size: var(--text-xs); line-height: 1.35; }
  .wf__who { display: flex; align-items: center; gap: var(--space-2); color: var(--color-text-muted); }
  .wf__av { flex: none; display: grid; place-items: center; min-inline-size: 1.5rem; block-size: 1.5rem; padding-inline: 4px; border-radius: 999px; background: var(--color-human-mark); color: var(--blue-975); font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: 0.6875rem; }
  .wf__note { padding: 5px var(--space-2); border-radius: var(--radius-sm) var(--radius-sm) var(--radius-sm) 2px; border: 1px solid color-mix(in oklab, var(--color-human-mark) 40%, transparent); background: color-mix(in oklab, var(--color-human-mark) 12%, transparent); color: var(--color-heading); }
  :dir(rtl) .wf__note { border-radius: var(--radius-sm) var(--radius-sm) 2px var(--radius-sm); }
  .wf__code { display: grid; padding: 6px var(--space-2); border-radius: var(--radius-sm); background: var(--color-surface); font-family: var(--font-mono, "JetBrains Mono", ui-monospace, monospace); font-size: 0.6875rem; line-height: 1.5; white-space: pre; overflow: hidden; }
  .wf__del { color: var(--red-300); }
  .wf__add { color: var(--color-human-mark); }
  .wf__ok { display: flex; justify-content: space-between; align-items: center; padding: 5px var(--space-2); border-radius: var(--radius-sm); background: color-mix(in oklab, var(--color-human-mark) 14%, transparent); color: var(--color-human-mark); }
  .wf__stamp { font-family: var(--ff-heading); font-weight: var(--weight-bold); white-space: nowrap; }
  /* Phones: the small picture keeps the badge, the note and Signed off. */
  @media (width < 36rem) { .wf__log { gap: 4px; padding: var(--space-2); } .wf__code { display: none; } }
  /* 4 · live: the same screen finished, in brand colour, with a rising usage line. */
  .wf__live { position: absolute; z-index: 1; inset-block-start: var(--space-2); inset-inline-end: var(--space-2); display: inline-flex; align-items: center; gap: 6px; padding: 2px 8px; border-radius: 999px; font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-xs); color: var(--color-human-text); background: color-mix(in oklab, var(--color-bg) 80%, transparent); }
  .wf__dot { inline-size: 8px; block-size: 8px; border-radius: 50%; background: var(--color-human-mark); box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-human-mark) 25%, transparent); }
  .wf__f-frame { fill: var(--blue-925); stroke: color-mix(in oklab, var(--blue-300) 35%, transparent); stroke-width: 1; }
  .wf__f-bar { fill: var(--blue-800); }
  .wf__g1 { stop-color: var(--blue-700); } .wf__g2 { stop-color: var(--blue-400); }
  .wf__f-line { fill: color-mix(in oklab, var(--blue-200) 55%, transparent); }
  .wf__f-btn { fill: var(--blue-500); }
  .wf__f-card { fill: color-mix(in oklab, var(--blue-300) 12%, transparent); stroke: color-mix(in oklab, var(--blue-300) 30%, transparent); stroke-width: 0.6; }
  .wf__f-trend { fill: none; stroke: var(--color-human-mark); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .wf__h { display: flex; align-items: center; gap: var(--space-2); margin-block-start: var(--space-2); font-size: var(--text-base); font-weight: var(--weight-semibold); letter-spacing: -0.01em; color: var(--color-heading); }
  .wf__n { display: inline-grid; place-items: center; flex: none; inline-size: 1.375rem; block-size: 1.375rem; border-radius: 50%; font-size: var(--text-xs); font-weight: var(--weight-bold); color: var(--color-machine-text); border: 1px solid color-mix(in oklab, var(--color-machine-mark) 60%, transparent); }
  .wf__line { font-size: var(--text-sm); line-height: 1.5; color: var(--color-text-muted); }

  /* Once on view: steps rise in order (300ms apart), then the signature, the stamp and the live dot land. ≈2.3s. */
  @media (prefers-reduced-motion: no-preference) {
    .wf[data-armed]:not([data-play]) :is(.wf__step, .wf__ok, .wf__dot, .wf__ph-screen) { opacity: 0; }
    .wf[data-play] .wf__step { animation: wf-rise 600ms var(--ease-enter) both; }
    .wf[data-play] .wf__step--2 { animation-delay: 300ms; }
    .wf[data-play] .wf__step--3 { animation-delay: 600ms; }
    .wf[data-play] .wf__step--4 { animation-delay: 900ms; }
    .wf[data-play] .wf__ok { animation: wf-stamp 420ms var(--ease-enter) 1650ms both; }
    .wf[data-play] .wf__ph-screen { animation: wf-fade 500ms var(--ease-enter) 1500ms both; }
    .wf[data-play] .wf__dot { animation: wf-stamp 380ms var(--ease-enter) 1950ms both; }
    @keyframes wf-rise { from { opacity: 0; translate: 0 1rem; } to { opacity: 1; translate: 0 0; } }
    @keyframes wf-stamp { from { opacity: 0; scale: 0.6; } to { opacity: 1; scale: 1; } }
    @keyframes wf-fade { from { opacity: 0; } to { opacity: 1; } }
  }
  @media (forced-colors: active) {
    .wf__chalk path, .wf__draft :is(rect, path), .wf__f-trend { stroke: CanvasText; }
  }
</style>
