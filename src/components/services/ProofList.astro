---
// Anonymized proof items for service pages (04 §4.3 #8, 03 §0.7 [CONSENT]): what we did, where, optional detail.
// No names, logos or quotes. CardGrid needs a body on every item; some §9.3 items have none, hence this list.
interface Item { title: string; where?: string; body?: string }
interface Props { items: readonly Item[] }
const { items } = Astro.props;
---
<ul role="list" class="proof">
  {items.map((it) => (
    <li class="proof__item">
      <h3 class="h3 proof__title">{it.title}</h3>
      {it.where && <p class="proof__where">{it.where}</p>}
      {it.body && <p class="proof__body">{it.body}</p>}
    </li>
  ))}
</ul>

<style>
  .proof { display: grid; gap: var(--grid-gap); }
  @media (width >= 48rem) { .proof { grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); } }
  .proof__item { display: grid; gap: var(--space-3); align-content: start; min-inline-size: 0; background: var(--color-surface); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: var(--space-6); }
  .proof__title { font-size: var(--text-lg); }
  .proof__where { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .proof__body { color: var(--color-text-muted); }
</style>
