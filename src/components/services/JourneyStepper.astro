---
// Journey stepper (03 §6.12): Validate → Build → Scale on a navy band (brand guidelines: navy for openers). Shows where
// this service sits and links to the stages either side. One connected track; the current stage is filled blue with a
// "You are here" tag. Stacks on phones, three columns from 48rem.
import { journey as c } from '../../content/copy/en/journey';
import { ROUTES, isLive, href, type RouteKey } from '../../data/routes';
interface Props { current: RouteKey }
const { current } = Astro.props;
const idx = c.stages.findIndex((s) => s.key === current);
---
<nav class="js" data-surface="inverse" aria-label={c.srLabel}>
  <div class="container js__inner">
    <div class="js__top"><p class="js__label">{c.label}</p>{isLive('howWeWork') && <a class="js__how" href={href('howWeWork')}>{c.howLink}</a>}</div>
    <ol role="list" class="js__list">
      {c.stages.map((s, i) => {
        const here = s.key === current;
        const state = i < idx ? 'before' : here ? 'here' : 'after';
        return (
          <li class:list={['js__stage', `js__stage--${state}`]}>
            <span class="js__node" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="js__text">
              {here || !isLive(s.key as RouteKey)
                ? <span class="js__name" aria-current={here ? 'step' : undefined}>{s.title}</span>
                : <a class="js__name" href={ROUTES[s.key as RouteKey].path}>{s.title}</a>}
              <span class="js__who">{s.who} <span class="js__dur">{s.duration}</span></span>
            </span>
            {here && <span class="js__here">{c.current}</span>}
          </li>
        );
      })}
    </ol>
  </div>
</nav>

<style>
  .js { background: var(--blue-800); padding-block: var(--space-6); border-block: 1px solid rgb(254 254 254 / 0.12); }
  .js__inner { display: grid; gap: var(--space-4); }
  .js__label { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--blue-200); }
  .js__label span { color: var(--blue-300); }
  .js__list { display: grid; gap: var(--space-2); counter-reset: none; }
  @media (width >= 64rem) { .js__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; } } /* three across only when names and the tag fit (768 split words) */
  .js__stage { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); }
  @media (width >= 64rem) {
    .js__stage { padding: var(--space-3) var(--space-5) var(--space-3) var(--space-4); border-radius: 0; }
    .js__stage:first-child { border-start-start-radius: var(--radius-md); border-end-start-radius: var(--radius-md); }
    .js__stage:last-child { border-start-end-radius: var(--radius-md); border-end-end-radius: var(--radius-md); }
    /* Chevron joins between stages, mirrored in RTL. */
    .js__stage:not(:last-child)::after { content: ''; position: absolute; inset-block: 22% ; inset-inline-end: -1px; inline-size: 1px; background: rgb(254 254 254 / 0.18); }
  }
  .js__stage--here { background: var(--blue-700); box-shadow: inset 0 0 0 1px rgb(254 254 254 / 0.22); }
  .js__node { display: grid; place-items: center; inline-size: 2.25rem; block-size: 2.25rem; border-radius: 50%; font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--blue-200); border: 1px solid rgb(254 254 254 / 0.3); }
  .js__stage--before .js__node { background: rgb(254 254 254 / 0.12); }
  .js__stage--here .js__node { background: var(--neutral-0); color: var(--blue-700); border-color: var(--neutral-0); font-weight: var(--weight-semibold); }
  .js__text { display: grid; gap: 2px; min-inline-size: 0; overflow-wrap: normal; }
  .js__name { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-lg); color: var(--neutral-0); text-decoration: none; letter-spacing: -0.015em; }
  a.js__name { text-decoration: underline; text-decoration-color: rgb(254 254 254 / 0.35); text-underline-offset: 0.25em; }
  @media (hover: hover) { a.js__name:hover { text-decoration-color: var(--neutral-0); } }
  .js__who { font-size: var(--text-sm); color: var(--blue-100); }
  .js__dur { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--blue-200); margin-inline-start: var(--space-1); white-space: nowrap; }
  .js__here { font-family: var(--ff-heading); font-size: var(--text-xs); font-weight: var(--weight-semibold); letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue-800); background: var(--neutral-0); padding: 2px 8px; border-radius: var(--radius-pill); white-space: nowrap; }
  .js__top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-4); }
  .js__how { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--neutral-0); text-underline-offset: 0.2em; }
</style>
