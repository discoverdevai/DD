---
// Service hero aside (04 §4.3, 06 §0.4 v3): the engagement at a glance, in the home scene style. Uses only strings the
// page already shows (process title, step titles/meta/chips, hero meta), so it adds no new claims. The step track
// fills once on load (≈1s); reduced motion = final state.
import LayerChip, { type Chip } from '../ui/LayerChip.astro';
interface Step { title: string; meta?: string; chip?: Chip }
interface Props { name: string; label: string; steps: readonly Step[]; meta?: readonly { label: string; value: string }[] }
const { name, label, steps, meta } = Astro.props;
---
<div class="sg" data-sg>
  <div class="sg__bar">
    <span class="sg__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="sg__name">{name}</span>
  </div>
  <p class="sg__label">{label}</p>
  <ol role="list" class="sg__steps">
    {steps.map((s, i) => (
      <li class:list={['sg__step', { 'is-last': i === steps.length - 1 }]} data-sg-step>
        <span class="sg__node" aria-hidden="true"></span>
        <span class="sg__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="sg__title">{s.title}</span>
        {s.meta && <span class="sg__meta">{s.meta}</span>}
        {s.chip && <span class="sg__chip"><LayerChip kind={s.chip.kind}>{s.chip.label}</LayerChip></span>}
      </li>
    ))}
  </ol>
  {meta && meta.length > 0 && (
    <dl class="sg__facts">{meta.map((m) => <div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}</dl>
  )}
</div>

<style>
  .sg { position: relative; container-type: inline-size; border-radius: var(--radius-lg); background: linear-gradient(180deg, color-mix(in oklab, var(--color-surface) 70%, var(--blue-800)), var(--color-surface) 45%); border: 1px solid color-mix(in oklab, var(--blue-300) 22%, transparent); box-shadow: inset 0 1px 0 color-mix(in oklab, var(--neutral-0) 10%, transparent), 0 40px 120px -30px color-mix(in oklab, var(--blue-700) 70%, transparent); overflow: hidden; font-size: var(--text-sm); }
  .sg__bar { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); border-block-end: 1px solid var(--color-hairline); }
  .sg__dots { display: inline-flex; gap: 6px; } .sg__dots i { inline-size: 10px; block-size: 10px; border-radius: 50%; background: color-mix(in oklab, var(--blue-300) 28%, transparent); }
  .sg__name { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .sg__label { padding: var(--space-5) var(--space-5) 0; font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-lg); color: var(--color-heading); letter-spacing: -0.015em; }
  .sg__steps { display: grid; padding: var(--space-4) var(--space-5) var(--space-5); }
  .sg__step { position: relative; display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto; align-items: center; gap: 2px var(--space-3); padding-block: var(--space-3); padding-inline-start: var(--space-6); }
  .sg__step::before { content: ''; position: absolute; inset-inline-start: 5px; inset-block: 50% -50%; inline-size: 1px; background: color-mix(in oklab, var(--blue-300) 30%, transparent); }
  .sg__step.is-last::before { display: none; }
  .sg__node { position: absolute; inset-inline-start: 0; inset-block-start: 50%; translate: 0 -50%; inline-size: 11px; block-size: 11px; border-radius: 50%; border: 2px solid var(--blue-400); background: var(--blue-400); transition: background-color var(--dur-base), border-color var(--dur-base), box-shadow var(--dur-base); }
  .sg__step.is-last .sg__node { border-color: var(--color-human-mark); background: var(--color-human-mark); box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-human-mark) 20%, transparent); }
  .sg__n { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .sg__title { font-weight: var(--weight-semibold); color: var(--color-text); }
  .sg__meta { grid-column: 2; font-family: var(--ff-mono); font-size: 0.6875rem; color: var(--color-text-muted); }
  .sg__chip { grid-column: 3; grid-row: 1; justify-self: end; }
  @container (inline-size < 26rem) { .sg__chip { grid-column: 2; grid-row: auto; justify-self: start; } }
  .sg__facts { display: grid; gap: var(--space-3); padding: var(--space-4) var(--space-5); border-block-start: 1px solid var(--color-hairline); background: color-mix(in oklab, var(--blue-975) 45%, transparent); }
  @container (inline-size >= 30rem) { .sg__facts { grid-template-columns: auto auto 1fr; gap: var(--space-6); } }
  .sg__facts div { display: grid; gap: 2px; }
  .sg__facts dt { font-family: var(--ff-mono); font-size: 0.6875rem; color: var(--color-machine-text); }
  .sg__facts dd { margin: 0; color: var(--color-text); font-weight: var(--weight-medium); }
  .sg[data-playing] .sg__node { background: var(--color-bg); }
  .sg[data-playing] .sg__step.is-last .sg__node { background: var(--color-bg); box-shadow: none; }
  .sg [data-done] .sg__node { background: var(--blue-400) !important; }
  .sg [data-done].is-last .sg__node { background: var(--color-human-mark) !important; box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-human-mark) 20%, transparent) !important; }
</style>

<script>
  import { playOnce } from '../../lib/play-once';
  // Nodes fill in order, 220ms apart, once the panel is 40% visible (06 §9.6 cap 2.4s).
  playOnce('[data-sg]', 0.4, 'data-playing', (sg) => {
    sg.querySelectorAll<HTMLElement>('[data-sg-step]').forEach((el, i) => setTimeout(() => el.setAttribute('data-done', ''), 500 + i * 220));
  });
</script>
