---
// Three ways to work with a software house as cards (Scale, 03 §16b.23, Oct 27): the comparison table's columns become
// cards, each with a one-line summary (optional "best when" label) and its facts as a description list. Scale shows the
// short version (3 facts, Oct 27). On wide screens the rows line up across
// cards (CSS subgrid); on phones the cards stack, so nothing scrolls sideways. /partners keeps the table.
// Phase 3 (03 §16b.39, Oct 29): on wide screens the cards join into one table you read across, with the row labels once
// on the start side (a decorative column; each card keeps its own labels for screen readers).
interface Row { label: string; cells: readonly string[] }
interface Props { columns: readonly string[]; bestFor: readonly string[]; bestLabel?: string; rows: readonly Row[]; caption: string }
const { columns, bestFor, bestLabel, rows, caption } = Astro.props;
---
<div class="oc__scroll" role="region" aria-label={caption} tabindex="0">
<ul role="list" class="oc reveal" data-rows={rows.length}>
  <li class="oc__card oc__labels" aria-hidden="true"><span></span><span></span>{rows.map((r) => <span class="oc__label">{r.label}</span>)}</li>
  {columns.map((col, i) => (
    <li class:list={['oc__card', `oc__card--${i}`]}>
      <h3 class="oc__name">{col}</h3>
      <p class="oc__best">{bestLabel && <span class="oc__bestlabel">{bestLabel}</span>} {bestFor[i]}</p>
      <dl class="oc__rows">
        {rows.map((r) => (
          <div class="oc__row"><dt>{r.label}</dt><dd>{r.cells[i]}</dd></div>
        ))}
      </dl>
    </li>
  ))}
</ul>
</div>

<style>
  .oc { display: grid; gap: var(--space-4); }
  /* Phones and tablets: one swipe row (a card in view, the next peeking) instead of three cards stacked. */
  @media (width < 64rem) {
    .oc__scroll { overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); scrollbar-width: none; }
    .oc { grid-auto-flow: column; grid-auto-columns: 86%; }
    .oc__card { scroll-snap-align: start; }
  }
  @media (40rem <= width < 64rem) { .oc { grid-auto-columns: 58%; } }
  .oc__scroll:focus-visible { outline: 2px solid var(--color-focus, var(--blue-300)); outline-offset: 4px; border-radius: var(--radius-lg); }
  @media (width >= 64rem) { .oc { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .oc__card { display: grid; gap: var(--space-3); align-content: start; padding: var(--space-6); border-radius: var(--radius-lg); background: var(--color-surface); border: 1px solid var(--color-hairline); border-block-start: 4px solid color-mix(in oklab, var(--blue-300) 35%, transparent); }
  .oc__card--2 { border-block-start-color: var(--blue-500); }
  /* Rows: label beside its value (half the height of stacked rows). Declared before the subgrid override below. */
  .oc__rows { display: grid; gap: var(--space-3); margin: 0; }
  .oc__row { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: var(--space-3); align-items: baseline; padding-block-start: var(--space-3); border-block-start: 1px solid var(--color-hairline); }
  .oc__row:first-child { padding-block-start: 0; border-block-start: 0; }
  /* Wide screens: every card spans the same rows, so "Minimum term" sits level across all three. */
  @supports (grid-template-rows: subgrid) {
    @media (width >= 64rem) {
      /* 2 header rows + one per comparison row (CSP: no inline style, so the count is a class: 3 on Scale, 6 in full). */
      .oc[data-rows='6'] .oc__card { grid-row: span 8; }
      .oc[data-rows='3'] .oc__card { grid-row: span 5; }
      .oc__card { grid-template-rows: subgrid; gap: 0; row-gap: var(--space-3); }
      .oc__rows { display: contents; }
    }
  }
  .oc__name { font-family: var(--ff-heading); font-size: var(--title-card); font-weight: var(--weight-bold); color: var(--color-heading); }
  .oc__best { font-size: var(--text-base); color: var(--color-text); padding-block-end: var(--space-4); border-block-end: 1px solid var(--color-hairline); }
  .oc__bestlabel { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-human-mark); }
  .oc dt { font-family: var(--ff-body); font-size: var(--text-xs); color: var(--color-machine-text); }
  .oc dd { margin: 0; font-size: var(--text-sm); color: var(--color-text); }

  /* One table (wide screens): the cards share one frame and hairlines; labels show once, in the first column. */
  .oc__labels { display: none; }
  @media (width >= 64rem) {
    .oc { grid-template-columns: minmax(0, 0.7fr) repeat(3, minmax(0, 1fr)); gap: 0; overflow: hidden; border-radius: var(--radius-md); border: 1px solid var(--color-hairline); background: var(--color-surface); }
    .oc__labels { display: grid; }
    .oc__card { border: 0; border-radius: 0; background: transparent; border-inline-start: 1px solid var(--color-hairline); }
    .oc__labels { border-inline-start: 0; }
    .oc__card--2 { background: color-mix(in oklab, var(--blue-600) 12%, transparent); }
    .oc__card:not(.oc__labels) dt { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .oc__row { grid-template-columns: minmax(0, 1fr); }
    .oc__label { font-size: var(--text-sm); color: var(--color-text-muted); padding-block-start: var(--space-3); border-block-start: 1px solid var(--color-hairline); }
    .oc__label:nth-child(3) { padding-block-start: 0; border-block-start: 0; }
    .oc__labels { row-gap: var(--space-3); }
  }
</style>
