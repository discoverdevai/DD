---
// Proof strip (06 §9.12 `strip`, 04 §4.1 #3): text facts only; no logos until consent (D-05).
// Items separated by an inline-start rule, never by dots.
import Icon from '../ui/Icon.astro';
type IconName = Parameters<typeof Icon>[0]['name'];
interface Props { title: string; items: readonly { icon: IconName; text: string }[] }
const { title, items } = Astro.props;
---
<section class="strip section--sm" data-surface="ink" aria-labelledby="proof-strip-title">
  <h2 id="proof-strip-title" class="sr-only">{title}</h2>
  <ul role="list" class="container strip__list">
    {items.map((it) => <li><Icon name={it.icon} size={16} />{it.text}</li>)}
  </ul>
</section>

<style>
  .strip { border-block: 1px solid var(--color-hairline); }
  .strip__list { display: flex; flex-wrap: wrap; gap: var(--space-3) 0; }
  .strip__list li { display: inline-flex; align-items: center; gap: var(--space-2); padding-inline: var(--space-5); border-inline-start: 1px solid var(--color-hairline); font-size: var(--text-base); }
  .strip__list li:first-child { padding-inline-start: 0; border-inline-start: 0; }
  @media (width < 40rem) { .strip__list { display: grid; gap: var(--space-3); } .strip__list li { padding-inline: 0; border-inline-start: 0; } }
  .strip__list :global(.icon) { color: var(--color-machine-mark); flex: none; }
</style>
