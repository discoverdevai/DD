---
// Proof band under the hero (03 §2A.3): client cards OR project cards, never mixed.
// - 4+ clients with recorded consent (D-05, src/data/clients.ts) → client cards (logo in its own colours + name + one
//   line) in ONE row that drifts slowly and loops (Mohamed, Oct 21: single row, moving at a sensible speed). Pauses on hover, on keyboard
//   focus and on a tap (touch); a Pause button appears for keyboard users only; reduced motion = still, wrapped row. The loop copy is made
//   by the script (so the inlined logos are in the HTML once), aria-hidden and inert.
// - Otherwise → four anonymized project cards (facts in 09).
// Then the §2.3 facts as a quiet row. Logos are read from assets/clients at build time and inlined as small WebP data
// URIs, only for consented entries, so an unconsented file never reaches dist. LOGO_MOCK=1 = local preview with all.
import path from 'node:path';
import sharp from 'sharp';
import Icon from '../ui/Icon.astro';
import { clientLogos } from '../../data/clients';
import { LOGO_PREVIEW } from '../../lib/preview';
import { t } from '../../i18n/t';
import { WORLD, LAND_DOTS, CLIENT_DOTS } from '../../data/world-dots';
interface Project { stage: string; href: string; what: string; where: string; proof: string }
interface Props {
  title: string; logosTitle: string; clientRoles: Record<string, string>; projects: readonly Project[];
  map: { label: string; legendWorked: string; legendHome: string; pins: ReadonlyArray<readonly [string, number, number]> };
  items: readonly { icon: 'globe' | 'check'; text: string }[];
}
const { title, logosTitle, clientRoles, projects, items, map } = Astro.props;
// Facts map (real land, Natural Earth, src/data/world-dots.ts): countries we have worked in lit blue, our two teams
// marked in green with an arc between them. Same projection as the generated dots.
const P = (lat: number, lon: number) => ({ x: +((lon - WORLD.lon0) * WORLD.k).toFixed(1), y: +((WORLD.lat0 - lat) * WORLD.k).toFixed(1) });
const homes = [P(31, -99), P(31.2, 29.9)];
const pins = map.pins.map(([name, lat, lon]) => ({ name, ...P(lat, lon) }));

const MOCK = LOGO_PREVIEW;
const MIN_LOGOS = 4;
const eligible = clientLogos.filter((l) => l.consent || MOCK);
const showLogos = eligible.length >= MIN_LOGOS;
const dir = path.join(process.cwd(), 'assets/clients');
const logos = showLogos
  ? await Promise.all(eligible.map(async (l) => {
      const buf = await sharp(path.join(dir, l.file))
        .resize(88, 88, { fit: l.fit === 'contain' ? 'contain' : 'cover', background: '#ffffff' })
        .webp({ quality: 55, effort: 6 })
        .toBuffer();
      return { ...l, src: `data:image/webp;base64,${buf.toString('base64')}` };
    }))
  : [];
---
<section class="pband" data-surface="ink" data-raised aria-labelledby="pband-title">
  <div class="container pband__head">
    <h2 id="pband-title" class="pband__label">{showLogos ? logosTitle : title}</h2>
  </div>

  {showLogos ? (
    <div class="pband__strip" data-marquee data-speed="26" data-pause-label={t('marquee.pause')} data-play-label={t('marquee.play')}>
      <div class="pband__track" data-marquee-track>
        <ul role="list" class="pband__clients">
          {logos.map((l) => (
            <li class="pband__client">
              <img src={l.src} alt="" width="44" height="44" loading="lazy" decoding="async" class:list={{ 'is-contain': l.fit === 'contain' }} />
              <p><strong>{l.name}</strong><span>{clientRoles[l.id]}</span></p>
            </li>
          ))}
        </ul>
      </div>
      <button type="button" class="pband__pause" aria-pressed="false" data-marquee-pause>{t('marquee.pause')}</button>
    </div>
  ) : (
    <div class="container">
      <ul role="list" class="pband__projects">
        {projects.map((p) => (
          <li class="pband__card card-link">
            <p class="pband__stage">{p.stage}</p>
            <h3 class="pband__what"><a href={p.href}>{p.what}</a></h3>
            <p class="pband__proof">{p.proof}</p>
            <p class="pband__where"><Icon name="map-pin" size={16} />{p.where}</p>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="container pband__world">
    <ul role="list" class="pband__facts">
      {items.map((i) => <li><Icon name={i.icon} size={20} /><span>{i.text}</span></li>)}
    </ul>
    <figure class="pband__mapwrap">
      <svg class="pband__map" viewBox={`0 0 ${WORLD.w} ${WORLD.h}`} role="img" aria-label={map.label}>
        <defs><linearGradient id="pband-arc" x1="0" x2="1"><stop offset="0" class="pband__stop-a" /><stop offset="1" class="pband__stop-b" /></linearGradient></defs>
        <path d={LAND_DOTS} class="pband__land" />
        <path d={CLIENT_DOTS} class="pband__worked" />
        <path d={`M${homes[0].x} ${homes[0].y} Q ${(homes[0].x + homes[1].x) / 2} ${Math.min(homes[0].y, homes[1].y) - 150} ${homes[1].x} ${homes[1].y}`} class="pband__arc" pathLength="1" />
        {pins.map((p) => (<g class="pband__pin"><title>{p.name}</title><circle cx={p.x} cy={p.y} r="9" class="pband__pin-halo" /><circle cx={p.x} cy={p.y} r="4.5" class="pband__pin-dot" /></g>))}
        {homes.map((h) => (<g class="pband__home"><circle cx={h.x} cy={h.y} r="6" class="pband__home-ring" /><circle cx={h.x} cy={h.y} r="5" class="pband__home-dot" /></g>))}
      </svg>
      <figcaption class="pband__legend" aria-hidden="true"><span class="pband__key pband__key--worked">{map.legendWorked}</span><span class="pband__key pband__key--home">{map.legendHome}</span></figcaption>
    </figure>
  </div>
</section>

<style>
  .pband { border-block-start: 1px solid var(--color-hairline); /* bottom edge = next section's hairline */ padding-block: var(--space-12) var(--space-10); display: grid; gap: var(--space-6); }
  .pband__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .pband__label { font-family: var(--ff-heading); font-size: var(--text-sm); font-weight: var(--weight-bold); letter-spacing: 0.02em; color: var(--color-machine-text); }
  /* Client cards: ONE row. Without script it is a swipeable row; with script (and no reduced-motion setting) it loops slowly at
     about 40px a second and pauses on hover, keyboard focus and a tap. Cards are fixed width so the speed reads the same everywhere. */
  .pband__strip { position: relative; overflow-x: auto; scrollbar-width: none; }
  .pband__strip::-webkit-scrollbar { display: none; }
  .pband__track { display: flex; inline-size: max-content; margin-inline-start: var(--gutter); }
  .pband__clients { display: flex; flex: none; gap: var(--space-3); padding-inline-end: var(--space-3); margin: 0; list-style: none; }
  .pband__client { flex: none; inline-size: 16.5rem; }
  @media (width >= 48rem) { .pband__client { inline-size: 19.5rem; } }
  .pband__strip[data-loop] { overflow: hidden; mask-image: linear-gradient(to right, transparent, var(--black) 4%, var(--black) 96%, transparent); }
  .pband__strip[data-loop] .pband__track { animation: pband-run var(--dur, 60s) linear infinite; }
  :dir(rtl) .pband__strip[data-loop] .pband__track { animation-name: pband-run-rtl; }
  .pband__strip[data-loop]:hover .pband__track, .pband__strip[data-loop]:focus-within .pband__track, .pband__strip[data-paused] .pband__track { animation-play-state: paused; }
  @keyframes pband-run { to { transform: translateX(-50%); } }
  @keyframes pband-run-rtl { to { transform: translateX(50%); } }
  /* Keyboard users get a Pause button the moment it takes focus; nobody else sees it (Mohamed, Oct 18: no visible Pause button). */
  .pband__pause { position: absolute; inset-block-start: var(--space-1); inset-inline-end: var(--gutter); z-index: 1; min-block-size: 2.75rem; padding-inline: var(--space-4); border-radius: 999px; border: 1px solid var(--color-hairline); background: var(--color-surface); color: var(--color-heading); font-size: var(--text-sm); cursor: pointer; clip-path: inset(50%); inline-size: 1px; overflow: hidden; padding: 0; border-width: 0; }
  .pband__pause:focus-visible { clip-path: none; inline-size: auto; padding-inline: var(--space-4); border-width: 1px; outline: var(--focus-width) solid var(--blue-300); outline-offset: var(--focus-offset); }
  .pband__strip:not([data-loop]) .pband__pause { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .pband__strip { overflow: visible; mask-image: none; }
    .pband__track { inline-size: auto; margin-inline: var(--gutter); }
    .pband__clients { flex-wrap: wrap; padding-inline-end: 0; }
    .pband__pause { display: none; }
  }
  .pband__client { display: flex; min-inline-size: 0; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--color-hairline); background: color-mix(in oklab, var(--blue-300) 4%, transparent); }
  .pband__client img { flex: none; inline-size: 2.75rem; block-size: 2.75rem; border-radius: 50%; object-fit: cover; background: var(--neutral-0); }
  .pband__client img.is-contain { object-fit: contain; padding: 3px; }
  .pband__client p { display: grid; min-inline-size: 0; }
  .pband__client strong { font-family: var(--ff-heading); font-size: var(--text-sm); color: var(--color-heading); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pband__client span { font-size: var(--text-sm); color: var(--color-text-muted); }
  /* Projects (fallback): four equal cards; the title link covers the card (one link, one tab stop). */
  .pband__projects { display: grid; gap: var(--space-4); }
  @media (width >= 40rem) { .pband__projects { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (width >= 64rem) { .pband__projects { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .pband__card { position: relative; display: grid; grid-template-rows: auto auto 1fr auto; gap: var(--space-2); padding: var(--space-5); border-radius: var(--radius-md); border: 1px solid var(--color-hairline); background: color-mix(in oklab, var(--blue-300) 4%, transparent); transition: border-color var(--dur-base), background-color var(--dur-base); }
  .pband__stage { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .pband__what { font-family: var(--ff-heading); font-size: var(--text-base); font-weight: var(--weight-bold); line-height: 1.35; color: var(--color-heading); text-wrap: balance; }
  .pband__what a { color: inherit; text-decoration: none; }
  @media (hover: hover) { .pband__card:hover { border-color: color-mix(in oklab, var(--blue-300) 40%, transparent); background: color-mix(in oklab, var(--blue-300) 8%, transparent); } }
  .pband__proof { font-size: var(--text-sm); line-height: 1.5; color: var(--color-text-muted); }
  .pband__where { display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-xs); color: var(--color-text-muted); }
  .pband__where :global(.icon) { color: var(--color-machine-text); }

  /* Facts + map: facts list beside an abstract dot-grid map in brand colours (03 §2A.3). */
  .pband__world { display: grid; gap: var(--space-6); align-items: center; padding-block-start: var(--space-6); border-block-start: 1px solid var(--color-hairline); }
  @media (width >= 64rem) { .pband__world { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-10); } }
  .pband__facts { display: grid; gap: var(--space-4); }
  @media (width >= 48rem) and (width < 64rem) { .pband__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .pband__mapwrap { display: grid; gap: var(--space-3); }
  .pband__map { inline-size: 100%; block-size: auto; overflow: visible; }
  .pband__land { fill: none; stroke: color-mix(in oklab, var(--blue-300) 30%, transparent); stroke-width: 3.6; stroke-linecap: round; }
  .pband__worked { fill: none; stroke: var(--blue-400); stroke-width: 4.4; stroke-linecap: round; }
  .pband__legend { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .pband__key { display: inline-flex; align-items: center; gap: var(--space-2); }
  .pband__key::before { content: ''; inline-size: 8px; block-size: 8px; border-radius: 50%; }
  .pband__key--worked::before { background: var(--blue-400); }
  .pband__key--home::before { background: var(--color-human-mark); }
  .pband__stop-a { stop-color: var(--blue-400); } .pband__stop-b { stop-color: var(--color-human-mark); }
  .pband__arc { fill: none; stroke: url(#pband-arc); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 0.01 0.012; }
  /* Client-country markers: a bright dot with a soft halo, one per country (09). */
  .pband__pin-halo { fill: color-mix(in oklab, var(--blue-300) 22%, transparent); }
  .pband__pin-dot { fill: var(--blue-200); stroke: var(--color-bg); stroke-width: 2; }
  .pband__home-dot { fill: var(--color-human-mark); stroke: var(--color-bg); stroke-width: 2; }
  .pband__home-ring { fill: none; stroke: var(--color-human-mark); stroke-width: 1.5; opacity: 0; transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .pband__home-ring { animation: pband-ping 2.8s var(--ease-standard) 3; }
    .pband__home:nth-of-type(2) .pband__home-ring { animation-delay: 1.4s; }
    @keyframes pband-ping { from { transform: scale(1); opacity: 0.8; } to { transform: scale(3.2); opacity: 0; } }
  }
  @media (forced-colors: active) { .pband__land { stroke: GrayText; } .pband__worked, .pband__home-dot { stroke: CanvasText; fill: CanvasText; } .pband__arc { stroke: CanvasText; } }
  .pband__facts li { display: flex; align-items: center; gap: var(--space-3); padding-inline-start: var(--space-5); border-inline-start: 1px solid var(--color-hairline); color: var(--color-text-muted); font-size: var(--text-sm); font-weight: var(--weight-medium); }
  .pband__facts :global(.icon) { color: var(--color-machine-text); flex: none; }
</style>

<script>
  // Marquee (Oct 21, Mohamed): clone the row once, set the speed in pixels per second, and wire the pause rules.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const startMarquee = (strip: HTMLElement) => {
    const track = strip.querySelector<HTMLElement>('[data-marquee-track]');
    const first = track?.querySelector<HTMLElement>('ul');
    if (!track || !first || reduced.matches) return;
    const copy = first.cloneNode(true) as HTMLElement;
    copy.setAttribute('aria-hidden', 'true');
    copy.setAttribute('inert', '');
    track.append(copy);
    const speed = Number(strip.dataset.speed) || 40;
    const setDuration = () => strip.style.setProperty('--dur', `${Math.round(first.getBoundingClientRect().width / speed)}s`);
    setDuration();
    new ResizeObserver(setDuration).observe(first);
    strip.setAttribute('data-loop', '');
    const btn = strip.querySelector<HTMLButtonElement>('[data-marquee-pause]');
    const toggle = () => {
      const paused = strip.toggleAttribute('data-paused');
      if (btn) { btn.setAttribute('aria-pressed', String(paused)); btn.textContent = paused ? strip.dataset.playLabel ?? 'Play' : strip.dataset.pauseLabel ?? 'Pause'; }
    };
    btn?.addEventListener('click', toggle);
    // Touch and pen: a tap holds the row, another tap lets it go. A mouse pauses on hover (CSS), so it is ignored here.
    strip.addEventListener('pointerup', (e) => { if (e.pointerType !== 'mouse' && !(e.target as HTMLElement).closest('button')) toggle(); });
    // Off screen or in a background tab: no point animating.
    new IntersectionObserver(([en]) => { strip.style.animationPlayState = ''; track.style.animationPlayState = en.isIntersecting ? '' : 'paused'; }).observe(strip);
  };
  // Set the loop up the first time the row is near the screen, not at load: the extra copy costs layout time that a phone does not need for the first screen.
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((strip) => {
    const once = new IntersectionObserver(([en]) => { if (en.isIntersecting) { once.disconnect(); startMarquee(strip); } }, { rootMargin: '200px' });
    once.observe(strip);
  });
</script>
