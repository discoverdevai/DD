---
// "Built it with AI? We check it first." on /build (03 §16b.9, Oct 26 redesign). Three rows in the home style:
// 1) the question, what we check, and one finding being fixed; 2) the five days as three steps, day 5 showing the
// findings you receive (the sample report, now in the dark theme instead of a white sheet); 3) the offer as one bar:
// price, days, guarantee and the call. Every string comes from the page copy (§3 Launch-Ready Review lines).
import SectionHead from '../ui/SectionHead.astro';
import LayerChip, { type Chip } from '../ui/LayerChip.astro';
import CtaLink from '../ui/CtaLink.astro';
import CtaTerms from '../ui/CtaTerms.astro';
import CodeFinding from '../scenes/CodeFinding.astro';
import { copy } from '../../content/copy';
import { t } from '../../i18n/t';
import { bookHref } from '../../data/routes';

const c = copy().build.review;
const snap = copy().snapshot;
const SEV = { critical: 'rv__sev--crit', high: 'rv__sev--high', medium: 'rv__sev--med' } as const;
---
<section id="review" class="rv" data-surface="ink" aria-labelledby="review-title">
  <div class="container rv__inner">
    <div class="rv__top">
      <div class="rv__copy">
        <SectionHead id="review-title" title={c.title} measure={24} />
        <p class="rv__body">{c.body}</p>
        <h3 class="rv__h3">{c.checkTitle}</h3>
        <ul role="list" class="rv__areas">{c.areas.map((a) => <li>{a}</li>)}</ul>
      </div>
      <CodeFinding c={c.finding} />
    </div>

    <ol role="list" class="rv__steps reveal-stagger">
      {c.steps.map((s, i) => (
        <li class:list={['rv__step', { 'rv__step--last': i === c.steps.length - 1 }]}>
          <span class="rv__when">{s.meta}</span>
          <h3 class="rv__steptitle">{s.title}</h3>
          <p class="rv__stepbody">{s.body}</p>
          <LayerChip kind={(s.chip as Chip).kind}>{s.chip.label}</LayerChip>
          {i === c.steps.length - 1 && (
            <ul role="list" class="rv__report" aria-label={snap.caption}>
              {snap.findings.map((f) => (
                <li class="rv__finding"><span class:list={['rv__sev', SEV[f.severity]]}>{snap.severity[f.severity]}</span><span>{f.title}</span></li>
              ))}
              <li class="rv__verdict">{snap.verdict}</li>
            </ul>
          )}
        </li>
      ))}
    </ol>

    <div class="rv__offer reveal">
      <dl class="rv__facts">{c.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
      <div class="rv__promise">
        <p class="rv__guarantee">{c.guarantee}</p>
        <p class="rv__credit">{c.credit}</p>
      </div>
      <div class="rv__cta">
        <CtaLink href={bookHref('clarity')} ctaId="build_mid_clarity" tier="secondary" position="mid" target="clarity">{t('cta.clarity')}</CtaLink>
        <CtaTerms kind="clarity" />
      </div>
    </div>
  </div>
</section>

<style>
  .rv { padding-block: var(--section-y); }
  .rv__inner { display: grid; gap: var(--space-8); }

  /* Row 1: the question and what we check, beside one finding being fixed. */
  .rv__top { display: grid; gap: var(--space-8); align-items: start; }
  /* Wide: the finding sits level with the copy's middle, and the intro stands a step further from the days than the days from the offer. */
  @media (width >= 64rem) { .rv__top { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: var(--space-12); align-items: center; } .rv__steps { margin-block-start: var(--space-4); } }
  .rv__copy { display: grid; gap: var(--space-4); }
  .rv__body { font-size: var(--text-lg); line-height: 1.55; color: var(--color-text-muted); max-inline-size: var(--measure-lead); }
  .rv__h3 { margin-block-start: var(--space-2); font-family: var(--ff-body); font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-text-muted); }
  .rv__areas { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .rv__areas li { padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); border: 1px solid var(--color-hairline); background: color-mix(in oklab, var(--blue-300) 6%, transparent); font-size: var(--text-sm); color: var(--color-text); }

  /* Row 2: the five days as three steps; day 5 carries the findings you receive. */
  .rv__steps { display: grid; gap: var(--space-4); }
  /* Wide screens: days 0 and 1–4 stacked on the left, day 5 and its report on the right, so no card is left half empty. */
  @media (width >= 56rem) {
    .rv__steps { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); }
    .rv__step--last { grid-column: 2; grid-row: 1 / span 2; }
  }
  .rv__step { display: grid; gap: var(--space-2); align-content: start; justify-items: start; padding: var(--space-5); border-radius: var(--radius-lg); background: var(--color-surface); border: 1px solid var(--color-hairline); border-block-start: 3px solid color-mix(in oklab, var(--blue-300) 35%, transparent); }
  .rv__step--last { border-block-start-color: var(--color-human-mark); }
  .rv__when { font-family: var(--ff-body); font-size: var(--text-xs); color: var(--color-machine-text); }
  .rv__steptitle { font-family: var(--ff-heading); font-size: var(--title-card); font-weight: var(--weight-bold); color: var(--color-heading); }
  .rv__stepbody { font-size: var(--text-sm); line-height: 1.55; color: var(--color-text-muted); }
  .rv__report { justify-self: stretch; display: grid; margin-block-start: var(--space-2); border-radius: var(--radius-md); background: var(--color-bg); border: 1px solid var(--color-hairline); }
  .rv__finding { display: flex; align-items: baseline; gap: var(--space-3); padding: var(--space-2) var(--space-3); font-size: var(--text-sm); color: var(--color-text); border-block-end: 1px solid var(--color-hairline); }
  .rv__sev { flex: none; font-size: var(--text-xs); font-weight: var(--weight-semibold); padding: 1px 8px; border-radius: var(--radius-pill); }
  .rv__sev--crit { background: color-mix(in oklab, var(--red-300) 16%, transparent); color: var(--red-300); }
  .rv__sev--high { background: color-mix(in oklab, var(--amber-300) 16%, transparent); color: var(--amber-300); }
  .rv__sev--med { background: color-mix(in oklab, var(--blue-300) 16%, transparent); color: var(--blue-200); }
  .rv__verdict { padding: var(--space-2) var(--space-3); font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-human-mark); }

  /* Row 3: the offer as one bar. */
  .rv__offer { display: grid; gap: var(--space-5) var(--space-8); align-items: center; padding: var(--space-6); border-radius: var(--radius-lg); background: color-mix(in oklab, var(--color-human-mark) 7%, var(--color-surface)); border: 1px solid color-mix(in oklab, var(--color-human-mark) 30%, transparent); }
  /* One row only where the guarantee has room; between, the call drops to its own row. */
  @media (width >= 48rem) { .rv__offer { grid-template-columns: auto minmax(0, 1fr); } .rv__cta { grid-column: 1 / -1; } }
  @media (width >= 80rem) { .rv__offer { grid-template-columns: auto minmax(0, 1fr) auto; } .rv__cta { grid-column: auto; } }
  .rv__facts { display: flex; flex-wrap: wrap; gap: var(--space-8); margin: 0; }
  .rv__facts div { display: grid; gap: var(--space-1); }
  .rv__facts dt { order: 2; font-size: var(--text-sm); color: var(--color-text-muted); }
  .rv__facts dd { order: 1; margin: 0; font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-2xl); line-height: 1; letter-spacing: -0.02em; color: var(--color-heading); }
  .rv__promise { display: grid; gap: var(--space-1); }
  .rv__guarantee { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-human-mark); }
  .rv__credit { font-size: var(--text-sm); color: var(--color-text-muted); }
  .rv__cta { display: grid; gap: var(--space-2); justify-items: start; }
</style>
