---
// Home hero (04 §4.1 #2, 06 §9.11 `home`, 06 §0.4 ink + blade + hairline grid).
// H1 is the LCP element: text only, no hero image. RunPanel sits below the fold on mobile.
import CtaLink from '../ui/CtaLink.astro';
import CtaTerms from '../ui/CtaTerms.astro';
import ProofChip from '../ui/ProofChip.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import RunPanel from './RunPanel.astro';
import { home } from '../../content/copy/en/home';
import { t } from '../../i18n/t';
import { bookHref, isLive, href } from '../../data/routes';
const c = home.hero;
---
<section class="hero" data-surface="ink" aria-labelledby="hero-title">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <div class="hero__blade" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <Eyebrow>{c.eyebrow}</Eyebrow>
      <h1 id="hero-title" class="display">{c.h1}</h1>
      <p class="lead hero__lead">{c.body}</p>
      <div class="hero__cta">
        <CtaLink href={bookHref('review')} ctaId="home_hero_review" tier="primary" position="hero" target="review" wide data-hero-cta>{t('cta.review')}</CtaLink>
        <CtaTerms kind="review" />
        {isLive('launchCheck') && (
          <CtaLink href={href('launchCheck')} ctaId="home_hero_launch_check" tier="low_commitment" position="hero" target="launch_check" variant="text">{c.quizLink}</CtaLink>
        )}
      </div>
      <ProofChip />
    </div>
    <RunPanel />
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(2.5rem, 1.6rem + 3.8vw, 6rem) var(--section-y); }
  .hero__grid-bg { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(var(--color-hairline) 1px, transparent 1px), linear-gradient(90deg, var(--color-hairline) 1px, transparent 1px); background-size: 5rem 5rem; mask-image: radial-gradient(75% 70% at 62% 28%, #000 15%, transparent 85%); }
  /* Blade (06 §0.5): the logo's lower blade, flat tonal fill, cropped off the inline-end edge. */
  .hero__blade { position: absolute; inset-block-start: -8%; inset-inline-end: -10%; inline-size: min(62vw, 56rem); aspect-ratio: 1; pointer-events: none; opacity: 0.5; background: linear-gradient(200deg, var(--blue-700), var(--blue-800) 70%); clip-path: polygon(30% 4%, 100% 40%, 46% 46%); }
  :dir(rtl) .hero__blade { scale: -1 1; }
  .hero__inner { position: relative; display: grid; gap: var(--space-12); }
  @media (width >= 64rem) { .hero__inner { grid-template-columns: 6.2fr 5.8fr; align-items: center; gap: var(--space-16); } }
  .hero__copy { display: grid; gap: var(--space-6); align-content: start; min-inline-size: 0; }
  .hero__lead { color: var(--color-text-muted); }
  .hero__cta { display: grid; gap: var(--space-3); justify-items: start; }
</style>
