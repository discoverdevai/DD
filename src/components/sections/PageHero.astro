---
// Hero for offer, service, partners, about and index pages (06 §9.11 `offer`/`service`, §0.4 ink).
// One H1, lead, optional <dl> meta row (Timeline / Model / Team), primary CTA + terms, optional text link, proof chip.
// Put a figure (RunPanel, ReviewSnapshot) in the `aside` slot to get the two-column offer layout.
import CtaLink from '../ui/CtaLink.astro';
import CtaTerms from '../ui/CtaTerms.astro';
import ProofChip from '../ui/ProofChip.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { t } from '../../i18n/t';
import { bookHref } from '../../data/routes';
interface Props {
  page: string; eyebrow?: string; h1: string; lead: string; meta?: readonly { label: string; value: string }[];
  cta?: 'review' | 'clarity' | 'partner' | 'none'; ctaHref?: string; proof?: boolean;
}
const { page, eyebrow, h1, lead, meta, cta = 'clarity', ctaHref, proof = true } = Astro.props;
const label = cta === 'review' ? t('cta.review') : cta === 'partner' ? t('cta.partner') : t('cta.clarity');
const hasAside = Astro.slots.has('aside');
---
<section class:list={['phero', { 'phero--split': hasAside }]} data-surface="ink" aria-labelledby="page-title">
  <div class="phero__grid-bg" aria-hidden="true"></div>
  <div class="container phero__inner">
    <div class="phero__copy">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h1 id="page-title" class="h1">{h1}</h1>
      <p class="lead">{lead}</p>
      {meta && meta.length > 0 && (
        <dl class="phero__meta">{meta.map((m) => <div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}</dl>
      )}
      {cta !== 'none' && (
        <div class="phero__cta">
          <CtaLink href={ctaHref ?? bookHref(cta)} ctaId={`${page}_hero_${cta}`} tier={cta === 'review' ? 'primary' : cta === 'partner' ? 'partner' : 'secondary'} position="hero" target={cta} wide data-hero-cta>{label}</CtaLink>
          <CtaTerms kind={cta} />
          <slot name="link" />
        </div>
      )}
      {proof && <ProofChip />}
    </div>
    {hasAside && <div class="phero__aside"><slot name="aside" /></div>}
  </div>
</section>

<style>
  .phero { position: relative; overflow: hidden; padding-block: clamp(2.5rem, 1.6rem + 3.8vw, 5.5rem) var(--section-y); }
  .phero__grid-bg { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(var(--color-hairline) 1px, transparent 1px), linear-gradient(90deg, var(--color-hairline) 1px, transparent 1px); background-size: 5rem 5rem; mask-image: radial-gradient(70% 70% at 70% 20%, #000 10%, transparent 80%); }
  .phero__inner { position: relative; display: grid; gap: var(--space-12); }
  .phero__copy { display: grid; gap: var(--space-6); align-content: start; max-inline-size: var(--container-narrow); min-inline-size: 0; }
  @media (width >= 64rem) { .phero--split .phero__inner { grid-template-columns: 6.2fr 5.8fr; align-items: center; gap: var(--space-16); } }
  .phero__meta { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-10); }
  .phero__meta div { display: grid; gap: 2px; }
  .phero__meta dt { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .phero__meta dd { margin: 0; font-weight: var(--weight-medium); }
  .phero__cta { display: grid; gap: var(--space-3); justify-items: start; }
  .phero__aside { min-inline-size: 0; }
</style>
