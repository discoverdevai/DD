---
// Client reviews (03 §2A.8c, option C "margin notes", Oct 18): the 8 verified quotes from 09, approved by Mohamed with names and roles (D-05).
// Quotes are verbatim. No star graphics, no AggregateRating (CLAUDE.md, 05). One featured card (the first quote) beside a margin of the
// other quotes as plain notes that drift slowly (CSS only, no script). WCAG 2.2.2: a real checkbox styled as the pause button (first tab stop,
// works without script); hover and keyboard focus stop the motion; reduced motion = a still, scrollable list. The loop copy is aria-hidden and inert.
import ProofChip from '../ui/ProofChip.astro';
import CtaLink from '../ui/CtaLink.astro';
import SectionHead from '../ui/SectionHead.astro';
import { t } from '../../i18n/t';
import { bookHref } from '../../data/routes';
interface Review { quote: string; name: string; role: string; service: string; result?: string }
interface Props { label?: string; title: string; items: readonly Review[]; cta?: boolean }
const { label, title, items, cta = false } = Astro.props;
const [featured, ...notes] = items;
---
<section id="reviews" class="rv" data-surface="ink" data-raised aria-labelledby="rv-title">
  <div class="container">
    <SectionHead id="rv-title" label={label} title={title} measure={22} />
    <div class="rv__grid">
      <figure class="rv__featured">
        <p class="rv__label">{t('reviews.featured')} · {featured.service}</p>
        <blockquote class="rv__big"><p>{featured.quote}</p></blockquote>
        <figcaption class="rv__by"><strong>{featured.name}</strong><span>{featured.role}</span></figcaption>
        {featured.result && <p class="rv__result">{featured.result}</p>}
      </figure>

      <div class="rv__side">
        <input type="checkbox" id="rv-pause" class="rv__box" />
        <label for="rv-pause" class="rv__toggle">
          <svg class="rv__i-pause" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" fill="none" /></svg>
          <svg class="rv__i-play" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor" /></svg>
          <span class="rv__t-pause">{t('reviews.pause')}</span><span class="rv__t-play">{t('reviews.play')}</span>
        </label>
        <div class="rv__margin" id="rv-margin">
          <div class="rv__track">
            <ul role="list" class="rv__notes">
              {notes.map((r) => (
                <li class="rv__note">
                  <figure>
                    <blockquote><p>{r.quote}</p></blockquote>
                    <figcaption><strong>{r.name}</strong><span>{r.role}</span><span class="rv__svc">{r.service}</span></figcaption>
                  </figure>
                </li>
              ))}
            </ul>
            <ul role="list" class="rv__notes rv__notes--loop" aria-hidden="true" inert>
              {notes.map((r) => (
                <li class="rv__note">
                  <figure>
                    <blockquote><p>{r.quote}</p></blockquote>
                    <figcaption><strong>{r.name}</strong><span>{r.role}</span><span class="rv__svc">{r.service}</span></figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <ProofChip class="rv__proof" />
      </div>
    </div>
    {cta && (
      <div class="rv__cta">
        <CtaLink href={bookHref('clarity')} ctaId="home_reviews_clarity" tier="primary" position="mid" target="clarity">{t('cta.clarity')}</CtaLink>
      </div>
    )}
  </div>
</section>

<style>
  .rv { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .rv__grid { display: grid; gap: var(--space-6); margin-block-start: var(--stack-lg); }
  @media (width >= 64rem) { .rv__grid { grid-template-columns: 5fr 7fr; gap: var(--space-12, 3.5rem); align-items: stretch; } }

  /* Featured card: the first quote, large; same height as the margin on desktop. */
  .rv__featured { display: flex; flex-direction: column; gap: var(--space-5); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid color-mix(in oklab, var(--blue-400) 45%, transparent); background: linear-gradient(160deg, color-mix(in oklab, var(--blue-700) 30%, var(--color-surface)), var(--color-surface) 70%); }
  @media (width >= 64rem) { .rv__featured { block-size: 33.75rem; padding: var(--space-8); } }
  .rv__label { font-family: var(--ff-mono); font-size: var(--text-xs); letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-text-muted); }
  .rv__big { position: relative; padding-block-start: var(--space-6); font-family: var(--ff-heading); font-size: clamp(1.375rem, 1.1rem + 1.1vw, 1.875rem); line-height: 1.3; font-weight: var(--weight-medium); color: var(--color-heading); text-wrap: pretty; }
  .rv__big::before { content: '“'; position: absolute; inset-block-start: -0.35em; inset-inline-start: 0; font-size: 4rem; line-height: 1; color: var(--blue-400); }
  .rv__by { display: grid; margin-block-start: auto; padding-block-start: var(--space-4); border-block-start: 1px solid var(--color-hairline); }
  .rv__by strong { font-family: var(--ff-heading); color: var(--color-heading); }
  .rv__by span { font-size: var(--text-sm); color: var(--color-text-muted); }
  .rv__result { font-family: var(--ff-heading); font-weight: var(--weight-semibold); color: var(--color-human-text); }

  /* Margin column. */
  .rv__side { display: grid; gap: var(--space-3); align-content: start; min-inline-size: 0; }
  @media (width >= 64rem) { .rv__side { grid-template-rows: auto 1fr auto; block-size: 33.75rem; } }
  /* The pause switch: a real checkbox, visually hidden but focusable; its label is the 44px button. */
  .rv__box { position: absolute; opacity: 0; inline-size: 1px; block-size: 1px; pointer-events: none; }
  .rv__toggle { display: inline-flex; align-items: center; gap: var(--space-2); justify-self: start; min-block-size: 2.75rem; padding-inline: var(--space-4); border: 1px solid var(--color-hairline); border-radius: 999px; font-size: var(--text-sm); color: var(--color-text-muted); cursor: pointer; }
  .rv__toggle:hover { color: var(--color-heading); border-color: var(--blue-400); }
  .rv__box:focus-visible + .rv__toggle { outline: var(--focus-width) solid var(--blue-300); outline-offset: var(--focus-offset); }
  .rv__i-play, .rv__t-play { display: none; }
  .rv__box:checked + .rv__toggle .rv__i-play, .rv__box:checked + .rv__toggle .rv__t-play { display: inline; }
  .rv__box:checked + .rv__toggle .rv__i-pause, .rv__box:checked + .rv__toggle .rv__t-pause { display: none; }

  .rv__margin { overflow: hidden; min-block-size: 0; mask-image: linear-gradient(to bottom, transparent, var(--black) 8%, var(--black) 92%, transparent); }
  .rv__track { display: flex; flex-direction: column; animation: rv-up 90s linear infinite; }
  .rv__notes { display: flex; flex-direction: column; margin: 0; padding: 0; list-style: none; }
  .rv__note { padding-block: var(--space-5); border-block-start: 1px solid var(--color-hairline); }
  .rv__note blockquote { font-size: var(--text-base); line-height: 1.6; color: var(--color-text); }
  .rv__note figcaption { display: grid; margin-block-start: var(--space-3); font-size: var(--text-sm); color: var(--color-text-muted); }
  .rv__note figcaption strong { font-family: var(--ff-heading); color: var(--color-heading); }
  .rv__svc { font-size: var(--text-xs); }
  .rv :global(.rv__proof) { color: var(--color-text-muted); }

  /* Hover or keyboard focus inside the margin stops it; the switch keeps it stopped. */
  .rv__margin:hover .rv__track, .rv__margin:focus-within .rv__track, .rv__box:checked ~ .rv__margin .rv__track { animation-play-state: paused; }
  @keyframes rv-up { to { transform: translateY(-50%); } }
  @keyframes rv-side { to { transform: translateX(-50%); } }
  @keyframes rv-side-rtl { to { transform: translateX(50%); } }

  /* Under 64rem: the notes become one slow sideways row. */
  @media (width < 64rem) {
    .rv__margin { mask-image: linear-gradient(to right, transparent, var(--black) 6%, var(--black) 94%, transparent); }
    .rv__track { flex-direction: row; inline-size: max-content; animation: rv-side 120s linear infinite; }
    .rv__notes { flex-direction: row; }
    .rv__note { inline-size: 16.5rem; padding-block: 0; padding-inline: var(--space-4); border-block-start: 0; border-inline-start: 1px solid var(--color-hairline); }
    .rv:dir(rtl) .rv__track { animation-name: rv-side-rtl; }
  }
  @media (width >= 40rem) and (width < 64rem) { .rv__note { inline-size: 18.75rem; } }

  /* Reduced motion: nothing moves; the notes are a still list you scroll. */
  @media (prefers-reduced-motion: reduce) {
    .rv__track { animation: none; }
    .rv__notes--loop, .rv__toggle { display: none; }
    .rv__margin { overflow: auto; mask-image: none; }
  }
  .rv__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-6); margin-block-start: var(--space-8); }
</style>

<script>
  // Reduced motion only: the margin really scrolls then, so it must be a keyboard stop (axe scrollable-region-focusable).
  const margin = document.getElementById('rv-margin');
  const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (margin) {
    const sync = () => {
      const overflows = margin.scrollHeight > margin.clientHeight + 1 || margin.scrollWidth > margin.clientWidth + 1;
      if (mq.matches && overflows) {
        margin.setAttribute('tabindex', '0');
        margin.setAttribute('role', 'region');
        margin.setAttribute('aria-label', document.getElementById('rv-title')?.textContent ?? '');
      } else {
        margin.removeAttribute('tabindex');
        margin.removeAttribute('role');
        margin.removeAttribute('aria-label');
      }
    };
    new ResizeObserver(sync).observe(margin);
    mq.addEventListener('change', sync);
    sync();
  }
</script>
