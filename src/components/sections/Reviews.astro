---
// Client reviews (03 §2A.8c, Oct 16): the 8 verified quotes from 09, approved by Mohamed with names and roles (D-05).
// Quotes are shown verbatim. No star graphics and no AggregateRating (CLAUDE.md, 05). Desktop: an even three-card grid (Oct 18: three quotes);
// phones: a swipeable row (scroll-snap, no auto motion).
import ProofChip from '../ui/ProofChip.astro';
import CtaLink from '../ui/CtaLink.astro';
import { t } from '../../i18n/t';
import { bookHref } from '../../data/routes';
interface Review { quote: string; name: string; role: string; service: string; result?: string }
interface Props { label?: string; title: string; items: readonly Review[]; cta?: boolean }
const { label, title, items, cta = false } = Astro.props;
const initials = (n: string) => n.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
import SectionHead from '../ui/SectionHead.astro';
---
<section id="reviews" class="rv" data-surface="ink" data-raised aria-labelledby="rv-title">
  <div class="container">
    <SectionHead id="rv-title" label={label} title={title} measure={22} />
    <ProofChip class="rv__proof" />
    <ul role="list" class="rv__list" tabindex="0" aria-labelledby="rv-title">
      {items.map((r, i) => (
        <li class:list={['rv__card', { 'rv__card--featured': i === 0 }]}>
          <figure>
            <blockquote class="rv__quote"><p>{r.quote}</p></blockquote>
            <figcaption class="rv__by">
              <span class="rv__avatar" aria-hidden="true">{initials(r.name)}</span>
              <span class="rv__who"><strong>{r.name}</strong><span>{r.role}</span></span>
            </figcaption>
            <p class="rv__service tag tag--stage">{r.service}</p>
            {r.result && <p class="rv__result">{r.result}</p>}
          </figure>
        </li>
      ))}
    </ul>
    {cta && (
      <div class="rv__cta">
        <CtaLink href={bookHref('clarity')} ctaId="home_reviews_clarity" tier="primary" position="mid" target="clarity">{t('cta.clarity')}</CtaLink>
      </div>
    )}
  </div>
</section>

<style>
  .rv { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .rv :global(.rv__proof) { margin-block: var(--space-4) var(--stack-lg); color: var(--color-text-muted); }

  /* Phones and tablets: one swipeable row of cards (the next card peeks). From 64rem: three columns, with the non-featured quotes as an open quote wall (no box) so the page is not a stack of identical cards. */
  .rv__list { display: grid; grid-auto-flow: column; grid-auto-columns: 85%; gap: var(--space-4); overflow-x: auto; scroll-snap-type: x mandatory; padding-block-end: var(--space-3); overscroll-behavior-x: contain; }
  .rv__card { scroll-snap-align: start; }
  /* Keyboard: the row is focusable so arrow keys scroll it on phones (axe scrollable-region-focusable). */
  .rv__list:focus-visible { outline: var(--focus-width) solid var(--blue-300); outline-offset: var(--focus-offset); border-radius: var(--radius-lg); }
  @media (width >= 40rem) and (width < 64rem) { .rv__list { grid-auto-columns: 46%; } }
  @media (width >= 64rem) {
    .rv__list { display: block; columns: 3; column-gap: var(--space-8); overflow: visible; padding: 0; }
    .rv__card { break-inside: avoid; margin-block-end: var(--space-8); }
    .rv__card:not(.rv__card--featured) figure { padding: var(--space-5) 0 0; border: 0; border-block-start: 1px solid var(--color-hairline); border-radius: 0; background: none; }
  }
  @media (width >= 90rem) { .rv__list { columns: 4; } }

  .rv__card figure { display: grid; gap: var(--space-4); block-size: 100%; padding: var(--space-5); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: var(--color-surface); }
  .rv__quote { position: relative; padding-block-start: var(--space-6); font-size: var(--text-base); line-height: 1.6; color: var(--color-text); }
  .rv__quote::before { content: '“'; position: absolute; inset-block-start: -0.35em; inset-inline-start: 0; font-family: var(--ff-heading); font-size: 3.5rem; line-height: 1; color: var(--blue-400); }
  .rv__by { display: flex; align-items: center; gap: var(--space-3); }
  .rv__avatar { display: grid; place-items: center; flex: none; inline-size: 2.5rem; block-size: 2.5rem; border-radius: 50%; font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-sm); color: var(--blue-975); background: var(--blue-300); }
  .rv__who { display: grid; }
  .rv__who strong { font-family: var(--ff-heading); color: var(--color-heading); }
  .rv__who span { font-size: var(--text-sm); color: var(--color-text-muted); }
  .rv__result { align-self: start; font-family: var(--ff-heading); font-weight: var(--weight-semibold); color: var(--color-human-text); }
  .rv__service { align-self: start; }
  /* Featured first quote (the build review behind the case study): larger text, accent edge. */
  .rv__card--featured figure { border-color: color-mix(in oklab, var(--blue-400) 45%, transparent); background: linear-gradient(160deg, color-mix(in oklab, var(--blue-700) 30%, var(--color-surface)), var(--color-surface) 70%); }
  .rv__card--featured .rv__quote { font-size: var(--text-lg); line-height: 1.5; font-weight: var(--weight-medium); color: var(--color-heading); }
  .rv__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-6); margin-block-start: var(--space-8); }
</style>

<script>
  // The row is a keyboard stop only while it really scrolls (axe scrollable-region-focusable); in the column layout it is not.
  const list = document.querySelector<HTMLElement>('.rv__list');
  if (list) {
    const sync = () => { if (list.scrollWidth > list.clientWidth + 1) list.setAttribute('tabindex', '0'); else list.removeAttribute('tabindex'); };
    new ResizeObserver(sync).observe(list);
    sync();
  }
</script>
