---
// Two-tone statement (docs/home-teardown.md): first sentence bright, the rest dim. Dim text is ≥ 24px, so 3:1 applies (06 §3).
// `ctaPage` adds a mid-page clarity-call button (CRO review: no CTA between hero and closer; Goal-Gradient).
import CtaLink from '../ui/CtaLink.astro';
import { t } from '../../i18n/t';
import { bookHref } from '../../data/routes';
// `display` keeps a short line (the method tagline) at headline size; long statements use statement size.
// `split` (desktop): label + heading left, the slot's body and the CTA right, the slot's visual full width below
// (Oct 16: the stacked layout spent ~400px before the visual).
interface Props { id: string; bright: string; dim: string; label?: string; surface?: 'ink' | 'navy'; ctaPage?: string; display?: boolean; split?: boolean }
const { id, bright, dim, label, surface = 'ink', ctaPage, display = false, split = false } = Astro.props;
---
<section id={id} class:list={['stmt', { 'stmt--navy bg-mark': surface === 'navy' }]} data-surface={surface === 'navy' ? 'inverse' : 'ink'} aria-labelledby={`${id}-title`}>
  <div class:list={['container', { 'stmt__split': split }]}>
    {label && <p class="stmt__label">{label}</p>}
    <h2 id={`${id}-title`} class:list={['stmt__text', 'reveal', { 'stmt__text--display': display }]}><span class="stmt__bright">{bright}</span> <span class="stmt__dim">{dim}</span></h2>
    <slot />
    {ctaPage && <p class="stmt__cta"><CtaLink href={bookHref('clarity')} ctaId={`${ctaPage}_mid_clarity`} tier="primary" position="mid" target="clarity">{t('cta.clarity')}</CtaLink></p>}
  </div>
</section>

<style>
  .stmt { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); scroll-margin-block-start: var(--header-h); }
  /* Same section-label style as the timeline eyebrow: mono, muted text, signal-blue slashes (H4 consistency). */
  .stmt__label { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-sm); color: var(--color-machine-text); margin-block-end: var(--space-4); }
  .stmt__label span { color: var(--color-machine-text); }
  .stmt__text { font-size: clamp(1.5rem, 1.05rem + 1.6vw, 2.25rem); font-weight: var(--weight-semibold); line-height: 1.12; letter-spacing: -0.035em; max-inline-size: 30ch; text-wrap: balance; } /* statement size (<= 36px): reads as a statement, not a headline (design review) */
  .stmt__text--display { font-size: clamp(1.75rem, 1.1rem + 2.7vw, 3.5rem); max-inline-size: 24ch; }
  .stmt__bright { color: var(--color-heading); }
  .stmt__dim { color: color-mix(in oklab, var(--neutral-0) 50%, var(--color-bg)); }
  /* Navy band (brand guidelines: navy for openers and statements) for pages that alternate white and navy. */
  .stmt__cta { margin-block-start: var(--space-8); }
  .stmt--navy { background: var(--blue-800); border-block-start: 0; }
  .stmt--navy .stmt__dim { color: var(--blue-200); }
  @media (width >= 64rem) {
    .stmt__split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-16); align-items: end; }
    .stmt__split > .stmt__label { grid-column: 1; grid-row: 1; }
    .stmt__split > .stmt__text { grid-column: 1; grid-row: 2; }
    .stmt__split > :global(.ag) { display: contents; }
    .stmt__split :global(.ag__body) { grid-column: 2; grid-row: 1 / span 2; align-self: end; }
    .stmt__split > .stmt__cta { grid-column: 2; grid-row: 3; margin-block-start: var(--space-6); }
    .stmt__split :global(.wf) { grid-column: 1 / -1; grid-row: 4; margin-block-start: var(--space-10); }
  }
</style>
