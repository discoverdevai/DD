---
// "Why DiscoverDev" band (03 §2V1 section 3, Oct 21 pick "Why 2b"): one headline in a single color, three numbered steps under it,
// and an example scope card on the right that shows the first release, what comes after launch and what is not needed yet.
// Phones: headline, steps, then the card.
// Phase 3 (03 §16b.40, Oct 29): no longer words-left, card-right like the two sections after it. The headline runs across
// the page, the three steps sit side by side as cards, and the example scope sits inside step 3, the step it shows.
// Oct 29 (03 §16b.45, option A): a proof card under steps 1 and 2 (Athkado's feasibility sprints, Validate's terms); on
// wide screens steps 1 and 2 share one height and the left column ends level with step 3, so every box lines up.
interface Step { title: string; body: string }
interface Group { label: string; mark: 'in' | 'next' | 'later'; items: readonly { name: string; note: string }[] }
interface Proof { who: string; text: string; facts: readonly { value: string; label: string }[] }
interface Props { id: string; label: string; headline: string; stepsLabel: string; steps: readonly Step[]; card: { name: string; tag: string; groups: readonly Group[] }; proof: Proof }
const { id, label, headline, stepsLabel, steps, card, proof } = Astro.props;
const glyph = { in: '✓', next: '→', later: '·' } as const;
---
<section id={id} class="why" data-surface="ink" aria-labelledby={`${id}-title`}>
  <div class="container">
    <p class="section-label why__label">{label}</p>
    <h2 id={`${id}-title`} class="why__text reveal">{headline}</h2>
    <p class="why__steps-label">{stepsLabel}</p>
    <div class="why__body">
    <ol role="list" class="why__list reveal-stagger">
      {steps.map((s, i) => (
        <li class:list={['why__step', { 'why__step--card': i === steps.length - 1 }]}>
          <span class="why__n" aria-hidden="true">{i + 1}</span>
          <p class="why__t"><b>{s.title}</b><span>{s.body}</span></p>
          {i === steps.length - 1 && (
            <div class="why__card" role="group" aria-label={`${card.tag}: ${card.name}`}>
              <p class="why__cap"><span>{card.name}</span><span class="why__tag">{card.tag}</span></p>
              {card.groups.map((g) => (
                <div class={`why__grp why__grp--${g.mark}`}>
                  <p class="why__grp-l">{g.label}</p>
                  <ul role="list">
                    {g.items.map((it) => (
                      <li class="why__row"><span class="why__ck" aria-hidden="true">{glyph[g.mark]}</span><span class="why__name">{it.name}</span><em>{it.note}</em></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </li>
      ))}
    </ol>
    <figure class="why__proof reveal">
      <p class="why__proof-who">{proof.who}</p>
      <blockquote class="why__proof-text"><p>{proof.text}</p></blockquote>
      <dl class="why__facts">{proof.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
    </figure>
    </div>
  </div>
</section>

<style>
  .why { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .why__label { margin-block-end: var(--space-4); }
  .why__text { font-size: var(--title-section); font-weight: var(--weight-bold); line-height: 1.1; letter-spacing: -0.035em; max-inline-size: 26ch; text-wrap: balance; color: var(--color-heading); }
  .why__steps-label { font-family: var(--ff-body); font-size: var(--text-sm); color: var(--color-machine-text); margin-block: var(--space-8) var(--space-2); }
  .why__list { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .why__body { display: grid; gap: var(--space-4); }
  /* Wide screens: one grid for steps and proof. Steps 1 and 2 share row 1, the proof spans them in row 2, step 3 spans
     both rows; rows stretch, so all boxes line up top and bottom. */
  @media (width >= 64rem) {
    .why__body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.4fr); grid-template-rows: auto 1fr; }
    .why__list { display: contents; }
    .why__step { grid-row: 1; }
    .why__step--card { grid-column: 3; grid-row: 1 / span 2; }
    .why__proof { grid-column: 1 / span 2; grid-row: 2; }
  }
  .why__step { display: grid; gap: var(--space-3); align-content: start; padding: var(--space-6); border-radius: var(--radius-md); background: var(--color-surface); border: 1px solid var(--color-hairline); }
  .why__n { flex: none; display: grid; place-items: center; inline-size: 2.25rem; block-size: 2.25rem; border-radius: 50%; border: 1px solid color-mix(in oklab, var(--blue-300) 55%, transparent); font-family: var(--ff-body); font-size: var(--text-sm); color: var(--blue-200); }
  .why__t { display: grid; gap: var(--space-1); }
  .why__t b { font-family: var(--ff-heading); font-size: var(--text-lg); font-weight: var(--weight-semibold); letter-spacing: -0.015em; color: var(--color-heading); }
  .why__t span { color: var(--color-text-muted); font-size: var(--text-sm); }
  .why__card { margin-block-start: var(--space-2); padding: var(--space-4); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); background: var(--color-bg); display: grid; gap: var(--space-4); }
  .why__cap { display: flex; justify-content: space-between; gap: var(--space-4); font-family: var(--ff-body); font-size: var(--text-xs); color: var(--color-machine-text); }
  .why__tag { color: var(--color-text-muted); }
  .why__grp-l { font-family: var(--ff-body); font-size: var(--text-xs); color: var(--color-text-muted); margin-block-end: var(--space-2); }
  .why__grp ul { display: grid; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .why__row { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); color: var(--color-heading); font-size: var(--text-sm); }
  .why__row em { margin-inline-start: auto; font-style: normal; font-family: var(--ff-body); font-size: var(--text-xs); color: var(--color-text-muted); }
  .why__ck { flex: none; inline-size: 1.25rem; text-align: center; font-weight: var(--weight-bold); }
  .why__grp--in .why__row { border-color: color-mix(in oklab, var(--blue-300) 40%, transparent); background: color-mix(in oklab, var(--blue-300) 8%, transparent); }
  .why__grp--in .why__ck { color: var(--color-human-mark); }
  .why__grp--next .why__ck { color: var(--blue-200); }
  .why__grp--later .why__row { color: var(--color-text-muted); border-style: dashed; }
  .why__proof { margin: 0; display: grid; gap: var(--space-4); align-content: center; padding: var(--space-6); border-radius: var(--radius-md); border: 1px solid color-mix(in oklab, var(--color-human-mark) 35%, transparent); background: linear-gradient(160deg, color-mix(in oklab, var(--color-human-mark) 8%, var(--color-surface)), var(--color-surface) 60%); }
  .why__proof-who { font-size: var(--text-sm); color: var(--color-human-mark); }
  .why__proof-text { margin: 0; font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-xl); line-height: 1.35; color: var(--color-heading); }
  .why__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding-block-start: var(--space-4); border-block-start: 1px solid var(--color-hairline); }
  .why__facts div { display: grid; gap: 2px; align-content: start; padding-inline: var(--space-4); border-inline-start: 1px solid var(--color-hairline); }
  .why__facts div:first-child { padding-inline-start: 0; border-inline-start: 0; }
  .why__facts dt { order: 2; font-size: var(--text-sm); color: var(--color-text-muted); }
  .why__facts dd { order: 1; margin: 0; font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-lg); color: var(--color-heading); }
</style>
