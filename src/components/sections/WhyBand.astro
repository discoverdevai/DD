---
// "Why DiscoverDev" band (03 §2V1 section 3; redesigned Oct 21, Mohamed): the two-tone statement on the left, and the one sentence that
// makes it concrete ("We test the idea, sketch the product and tell you what to cut, before any code.") laid out as three numbered
// steps on the right. Phones: statement, then the steps. Same words as the copy, only broken into a list.
interface Props { id: string; label: string; bright: string; dim: string; stepsLabel: string; steps: readonly string[] }
const { id, label, bright, dim, stepsLabel, steps } = Astro.props;
---
<section id={id} class="why" data-surface="ink" aria-labelledby={`${id}-title`}>
  <div class="container why__grid">
    <div class="why__main">
      <p class="section-label why__label">{label}</p>
      <h2 id={`${id}-title`} class="why__text reveal"><span class="why__bright">{bright}</span> <span class="why__dim">{dim}</span></h2>
    </div>
    <div class="why__steps">
      <p class="why__steps-label">{stepsLabel}</p>
      <ol role="list" class="why__list">
        {steps.map((s, i) => (
          <li class="why__step"><span class="why__n" aria-hidden="true">{i + 1}</span><span class="why__t">{s}</span></li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .why { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .why__grid { display: grid; gap: var(--space-10); align-items: center; }
  @media (width >= 64rem) { .why__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-16); } }
  .why__label { margin-block-end: var(--space-4); }
  .why__text { font-size: clamp(1.875rem, 1.2rem + 2.4vw, 3rem); font-weight: var(--weight-semibold); line-height: 1.1; letter-spacing: -0.035em; max-inline-size: 22ch; text-wrap: balance; }
  .why__bright { color: var(--color-heading); }
  .why__dim { color: color-mix(in oklab, var(--neutral-0) 50%, var(--color-bg)); } /* 3:1 or better: the text is 30px or larger (06 §3) */
  .why__steps { padding: var(--space-6); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); background: linear-gradient(160deg, color-mix(in oklab, var(--blue-700) 22%, var(--color-surface)), var(--color-surface) 70%); }
  @media (width >= 64rem) { .why__steps { padding: var(--space-8); } }
  .why__steps-label { font-family: var(--ff-mono); font-size: var(--text-sm); color: var(--color-machine-text); margin-block-end: var(--space-4); }
  .why__list { margin: 0; padding: 0; list-style: none; }
  .why__step { display: flex; align-items: center; gap: var(--space-4); padding-block: var(--space-4); border-block-start: 1px solid var(--color-hairline); }
  .why__n { flex: none; display: grid; place-items: center; inline-size: 2.25rem; block-size: 2.25rem; border-radius: 50%; border: 1px solid color-mix(in oklab, var(--blue-300) 55%, transparent); font-family: var(--ff-mono); font-size: var(--text-sm); color: var(--blue-200); }
  .why__t { font-family: var(--ff-heading); font-size: var(--text-lg); font-weight: var(--weight-semibold); letter-spacing: -0.015em; color: var(--color-heading); }
</style>
