---
// Selected work (03 §2A.8b, Oct 18): the one case with a number on home, next to its drawing. Every other project lives
// on /work (ProjectRows). The tile is one stretched link (the case page).
import ProjectVisual from '../work/ProjectVisual.astro';
import { projects, showcase as c } from '../../content/copy/en/projects';
import { href, isLive } from '../../data/routes';
const tile = c.ids.map((id) => projects.find((p) => p.id === id)).find((p): p is NonNullable<typeof p> => Boolean(p));
const target = tile?.link && isLive(tile.link) ? href(tile.link) : isLive('work') ? href('work') : undefined;
const stageName = (s: keyof typeof c.stages) => c.stages[s];
---
{tile && (
  <section id="selected-work" class="sc" data-surface="ink" aria-labelledby="sc-title">
    <div class="container">
      <div class="sc__tile card-link">
        <div class="sc__vis"><ProjectVisual project={tile} sizes="(min-width: 64rem) 45vw, 100vw" /></div>
        <div class="sc__body">
          <p class="sc__meta"><span class="tag tag--stage">{stageName(tile.stage)}</span>{tile.industry}{tile.where && ` · ${tile.where}`}</p>
          <h3 id="sc-title" class="sc__h">{target ? <a href={target}>{tile.title}</a> : tile.title}</h3>
          {tile.metric && <p class="sc__metric"><b>{tile.metric.value}</b><span>{tile.metric.label}</span></p>}
          {tile.result && <p class="sc__txt">{tile.result}</p>}
          {tile.link && target && <p class="sc__more" aria-hidden="true">{c.caseLink}<span class="icon--dir"> →</span></p>}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .sc { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .sc__tile { display: grid; gap: var(--space-5); align-content: start; padding: var(--space-4); border-radius: var(--radius-lg); border: 1px solid color-mix(in oklab, var(--blue-400) 40%, transparent); background: linear-gradient(160deg, color-mix(in oklab, var(--blue-700) 28%, var(--color-surface)), var(--color-surface) 60%); transition: border-color var(--dur-base); }
  @media (width >= 48rem) { .sc__tile { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: var(--space-8); padding: var(--space-6); } }
  .sc__vis { border-radius: var(--radius-md); background: var(--blue-925); }
  .sc__body { display: grid; gap: var(--space-3); }
  .sc__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .sc__h { font-family: var(--ff-heading); font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem); font-weight: var(--weight-bold); line-height: 1.3; color: var(--color-heading); text-wrap: balance; }
  .sc__h a { color: inherit; text-decoration: none; }
  @media (hover: hover) { .sc__tile:hover { border-color: color-mix(in oklab, var(--blue-300) 45%, transparent); } }
  .sc__metric { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3); margin-block: var(--space-2); }
  .sc__metric b { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: clamp(2.75rem, 2rem + 2.4vw, 4rem); line-height: 1; letter-spacing: -0.045em; color: var(--color-heading); }
  .sc__metric span { color: var(--color-machine-text); }
  .sc__txt { font-size: 1rem; line-height: 1.55; color: var(--color-text-muted); }
  .sc__more { margin-block-start: var(--space-2); font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-link); }
</style>
