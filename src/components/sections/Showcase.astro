---
// Selected work rail (03 §2A.8b, Oct 21, Mohamed): more projects on every screen in ONE row that drifts very slowly (about 18px a second) and
// loops. It never pauses (Mohamed, Oct 21: keep the slider moving); it is still a normal scroll row, so a swipe, trackpad, the arrow buttons or the
// keyboard move it by hand and the drift only steps aside while that is happening. Reduced motion = no drift, manual scroll with scroll-snap.
// The loop copy is made by the script when the row nears the screen (aria-hidden, inert). Titles link to /work only when it is live (V1.1).
import ProjectVisual from '../work/ProjectVisual.astro';
import { projects, showcase as c } from '../../content/copy/en/projects';
import { href, isLive } from '../../data/routes';
import { t } from '../../i18n/t';
import SliderArrows from '../ui/SliderArrows.astro';
const tiles = c.ids.map((id) => projects.find((p) => p.id === id)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const target = (p: (typeof tiles)[number]) => (p.link && isLive(p.link) ? href(p.link) : isLive('work') ? href('work') : undefined);
const stageName = (s: keyof typeof c.stages) => c.stages[s];
---
<section id="selected-work" class="sc" data-surface="ink" aria-labelledby="sc-title">
  <div class="container">
    <div class="sc__head">
      <div class="sc__titles">
        <h3 id="sc-title" class="sc__title">{c.othersTitle}</h3>
        <p class="sc__hint">{c.hint}</p>
      </div>
      <SliderArrows ns="sc" controls="sc-rail" prevLabel={t('rail.prev')} nextLabel={t('rail.next')} />
    </div>
    <div class="sc__rail" id="sc-rail" role="region" aria-label={t('rail.region')} tabindex="0" data-sc-rail>
      <ul role="list" class="sc__track">
        {tiles.map((p, i) => (
          <li class:list={['sc__card', 'card-link', { 'sc__card--feat': i === 0 }]}>
            <div class="sc__vis"><ProjectVisual project={p} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 46vw, 85vw" /></div>
            <p class="sc__meta"><span class="sc__stage">{stageName(p.stage)}</span>{p.industry}{p.where && ` · ${p.where}`}</p>
            <h4 class="sc__h">{target(p) ? <a href={target(p)}>{p.title}</a> : p.title}</h4>
            {p.metric && <p class="sc__metric"><b>{p.metric.value}</b><span>{p.metric.label}</span></p>}
            <p class="sc__txt">{p.result ?? p.did}</p>
            {p.link && target(p) && <p class="sc__more" aria-hidden="true">{c.caseLink}<span class="icon--dir"> →</span></p>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .sc { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .sc__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-4); margin-block-end: var(--space-6); }
  .sc__title { font-family: var(--ff-heading); font-size: var(--text-2xl, 1.5rem); font-weight: var(--weight-bold); color: var(--color-heading); }
  .sc__hint { margin-block-start: var(--space-1); font-size: var(--text-sm); color: var(--color-text-muted); }
  .sc__rail:focus-visible { outline: var(--focus-width) solid var(--blue-300); outline-offset: var(--focus-offset); }

  /* The rail: one row, scroll-snap, the next card peeks in. Phones 1 card + peek, tablets 2, desktop 3. */
  .sc__rail { overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: thin; padding-block-end: var(--space-3); border-radius: var(--radius-lg); }
  .sc__track { display: flex; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .sc__card { position: relative; flex: 0 0 85%; scroll-snap-align: start; display: grid; grid-template-rows: auto auto auto auto 1fr; align-content: start; gap: var(--space-2); padding: var(--space-4); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: var(--color-surface); }
  @media (width >= 40rem) { .sc__card { flex-basis: calc((100% - var(--space-4)) / 2 - var(--space-8)); } }
  @media (width >= 64rem) { .sc__card { flex-basis: calc((100% - 2 * var(--space-4)) / 3 - var(--space-6)); } }
  .sc__card--feat { background: linear-gradient(160deg, color-mix(in oklab, var(--blue-700) 28%, var(--color-surface)), var(--color-surface) 60%); border-color: color-mix(in oklab, var(--blue-400) 40%, transparent); }
  @media (hover: hover) { .sc__card:hover { border-color: color-mix(in oklab, var(--blue-300) 45%, transparent); } }
  .sc__vis { margin-block-end: var(--space-2); border-radius: var(--radius-md); background: var(--blue-925); }
  .sc__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .sc__stage { padding: 1px 7px; border-radius: var(--radius-xs, 4px); color: var(--blue-975); background: var(--blue-300); }
  .sc__h { font-family: var(--ff-heading); font-size: var(--text-lg); font-weight: var(--weight-bold); line-height: 1.3; color: var(--color-heading); text-wrap: balance; }
  .sc__h a { color: inherit; text-decoration: none; }
  .sc__metric { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3); margin-block: var(--space-1); }
  .sc__metric b { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem); line-height: 1; letter-spacing: -0.045em; color: var(--color-heading); }
  .sc__metric span { color: var(--color-machine-text); }
  .sc__txt { font-size: var(--text-base); line-height: 1.55; color: var(--color-text-muted); }
  .sc__more { margin-block-start: var(--space-2); font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-link); }
  /* Drift mode (set by the script): no snapping while it moves; the arrows still step one card. */
  .sc__rail[data-auto] { scroll-snap-type: none; scroll-behavior: auto; scrollbar-width: none; }
  .sc__rail[data-auto]::-webkit-scrollbar { display: none; }
  @media (prefers-reduced-motion: no-preference) { .sc__rail:not([data-auto]) { scroll-behavior: smooth; } }
</style>

<script>
  // Drift + arrows. Positions are kept as a float because scrollLeft is rounded to whole pixels when read back.
  const rail = document.querySelector<HTMLElement>('[data-sc-rail]');
  const ctrl = document.querySelector<HTMLElement>('[data-sc-ctrl]');
  const prev = document.querySelector<HTMLButtonElement>('[data-sc-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-sc-next]');
  const track = rail?.querySelector<HTMLElement>('.sc__track');
  if (rail && ctrl && prev && next && track) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SPEED = 18; // pixels per second (Mohamed, Oct 21: less motion on the page; was 34)
    const HOLD = 900; // ms the drift steps aside while a swipe, scroll or arrow is moving the row (it never pauses otherwise)
    const step = () => (rail.querySelector<HTMLElement>('.sc__card')?.getBoundingClientRect().width ?? rail.clientWidth) + 16;
    const rtl = () => getComputedStyle(rail).direction === 'rtl';
    let auto = false;
    let half = 0;
    let pos = 0;
    let holdUntil = 0;
    let touching = false; // a finger or mouse button is on the row
    let inView = true;
    let last = 0;
    let lastSet = 0;

    const measure = () => { half = auto ? track.scrollWidth / 2 : 0; };
    const sync = () => {
      measure();
      const overflows = rail.scrollWidth - rail.clientWidth > 2;
      ctrl.hidden = !overflows;
      if (overflows) rail.setAttribute('tabindex', '0'); else rail.removeAttribute('tabindex');
      if (auto) { prev.disabled = false; next.disabled = false; return; }
      const max = rail.scrollWidth - rail.clientWidth;
      const p = Math.abs(rail.scrollLeft);
      prev.disabled = p <= 2;
      next.disabled = p >= max - 2;
    };
    const hold = () => { holdUntil = performance.now() + HOLD; };
    const go = (dir: 1 | -1) => {
      hold();
      if (auto && dir === -1 && rail.scrollLeft < step()) { rail.scrollLeft += half; pos = rail.scrollLeft; }
      rail.scrollBy({ left: dir * (rtl() ? -1 : 1) * step(), behavior: reduced ? 'auto' : 'smooth' });
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    rail.addEventListener('scroll', () => {
      if (auto && Math.abs(rail.scrollLeft - lastSet) > 2) { pos = rail.scrollLeft; hold(); } // a person moved it
      if (auto && half && rail.scrollLeft >= half) { rail.scrollLeft -= half; pos = rail.scrollLeft; lastSet = pos; }
      sync();
    }, { passive: true });
    new ResizeObserver(sync).observe(rail);
    sync();

    // The loop copy and the drift are set up the first time the row is near the screen, not at load: 12 extra cards of drawings
    // cost layout time on a phone (home TBT audit, Oct 21).
    const begin = () => {
      const first = track.querySelector<HTMLElement>('.sc__card');
      if (!first) return;
      [...track.children].forEach((c) => {
        const copy = c.cloneNode(true) as HTMLElement;
        copy.setAttribute('aria-hidden', 'true');
        copy.setAttribute('inert', '');
        track.append(copy);
      });
      auto = true;
      rail.setAttribute('data-auto', '');
      sync();
    {
      // The drift never pauses (Mohamed, Oct 21: it keeps sliding). It only steps aside while a finger, wheel or arrow is moving the row.
      rail.addEventListener('wheel', hold, { passive: true });
      rail.addEventListener('pointerdown', () => { touching = true; });
      for (const ev of ['pointerup', 'pointercancel'] as const) addEventListener(ev, () => { if (touching) { touching = false; hold(); } });
      new IntersectionObserver(([en]) => { inView = en.isIntersecting; }).observe(rail);
      const tick = (now: number) => {
        const dt = Math.min(now - (last || now), 250); // capped so a tab coming back from the background does not jump
        last = now;
        if (inView && !touching && now > holdUntil && !document.hidden && half) {
          pos += (SPEED * dt) / 1000;
          if (pos >= half) pos -= half;
          lastSet = pos;
          rail.scrollLeft = pos;
        } else {
          pos = rail.scrollLeft;
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
    };
    if (!reduced) {
      const once = new IntersectionObserver(([en]) => { if (en.isIntersecting) { once.disconnect(); begin(); } }, { rootMargin: '400px' });
      once.observe(rail);
    }
  }
</script>
