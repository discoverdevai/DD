---
// "Teams that stayed" for /scale (03 §16b.26, Oct 27; Mohamed chose "the four who came back", built from the site's
// product cards). The four clients who expanded scope (09 Differentiators: Athkado, Upscend, Arheb, Pyramakerz) as the
// same cards as Build's named products (real screen or product drawing), then the other Scale clients on one line.
import BuildWork from '../blocks/BuildWork.astro';
interface Item { id: string; name: string; meta: string; line: string; screens?: readonly string[]; device?: string; alt?: string; art: string }
interface Props { id?: string; c: { title: string; lead: string; label: string; items: readonly Item[]; alsoLabel: string; also: readonly { name: string; line: string }[] } }
const { id = 'proof', c } = Astro.props;
---
<section id={id} class="spf" data-surface="ink" aria-labelledby={`${id}-title`}>
  <div class="container spf__inner">
    <header class="spf__head">
      <h2 id={`${id}-title`} class="section-title reveal">{c.title}</h2>
      <p class="spf__lead">{c.lead}</p>
    </header>
    <BuildWork c={{ label: c.label, items: c.items }} />
    <p class="spf__also"><span class="spf__alsolabel">{c.alsoLabel}</span> {c.also.map((a, i) => <span class="spf__item"><b>{a.name}</b> {a.line}{i < c.also.length - 1 && <span class="spf__sep" aria-hidden="true">·</span>}</span>)}</p>
  </div>
</section>

<style>
  .spf { padding-block: var(--section-y); }
  .spf__inner { display: grid; gap: var(--space-6); }
  .spf__head { display: grid; gap: var(--space-3); }
  .spf__lead { font-size: var(--text-lg); color: var(--color-text-muted); max-inline-size: var(--measure-lead); }
  .spf__also { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-5); padding-block-start: var(--space-4); border-block-start: 1px solid var(--color-hairline); color: var(--color-text-muted); }
  .spf__alsolabel { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .spf__item b { font-family: var(--ff-heading); color: var(--color-heading); }
  .spf__sep { margin-inline-start: var(--space-5); color: var(--color-text-muted); }
</style>
