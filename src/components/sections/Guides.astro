---
import SectionHead from '../ui/SectionHead.astro';
// Guides and tools (03 §2A.9b, Oct 16): the pillar guide plus two cluster guides (title and description from each
// guide's front matter) and the launch check. Internal links for SEO and a next step for visitors not ready to book.
import { publishedInsights, insightPath } from '../../lib/insights';
import { href, isLive } from '../../data/routes';
interface Props { label?: string; title: string; readLabel: string; allLabel?: string; check: { title: string; body: string; cta: string } }
const { label, title, readLabel, allLabel, check } = Astro.props;
const all = await publishedInsights('en');
const pick = ['ai-app-to-production', 'ai-built-app-security-holes']
  .map((slug) => all.find((e) => e.id.endsWith(slug)))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
---
{(pick.length > 0 || isLive('launchCheck')) && (
  <section id="guides" class="gd" data-surface="ink" aria-labelledby="gd-title">
    <div class="container">
      <SectionHead id="gd-title" label={label} title={title} />
      <ul role="list" class="gd__grid">
        {isLive('launchCheck') && (
          <li class="gd__card gd__card--check card-link">
            <h3 class="gd__h"><a href={href('launchCheck')}>{check.title}</a></h3>
            <p class="gd__body">{check.body}</p>
            <p class="gd__more" aria-hidden="true">{check.cta}<span class="icon--dir"> →</span></p>
          </li>
        )}
        {pick.map((e) => (
          <li class="gd__card card-link">
            <h3 class="gd__h"><a href={insightPath(e)}>{e.data.h1}</a></h3>
            <p class="gd__body">{e.data.description}</p>
            <p class="gd__more" aria-hidden="true">{readLabel}<span class="icon--dir"> →</span></p>
          </li>
        ))}
      </ul>
      {allLabel && isLive('insights') && <p class="gd__all"><a href={href('insights')}>{allLabel}<span class="icon--dir" aria-hidden="true"> →</span></a></p>}
    </div>
  </section>
)}

<style>
  .gd { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .gd :global(.section-heading) { margin-block-end: var(--stack-lg); }
  .gd__grid { display: grid; gap: var(--space-4); }
  @media (width >= 40rem) { .gd__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (width >= 64rem) { .gd__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .gd__all { margin-block-start: var(--space-6); }
  .gd__all a { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-link); }
  .gd__card { position: relative; display: grid; grid-template-rows: auto 1fr auto; gap: var(--space-3); padding: var(--space-5); border-radius: var(--radius-md); border: 1px solid var(--color-hairline); background: var(--color-surface); }
  .gd__card--check { border-color: color-mix(in oklab, var(--color-human-mark) 35%, transparent); background: color-mix(in oklab, var(--color-human-mark) 7%, var(--color-surface)); }
  .gd__h { font-family: var(--ff-heading); font-size: var(--text-lg); font-weight: var(--weight-bold); line-height: 1.3; color: var(--color-heading); text-wrap: balance; }
  .gd__h a { color: inherit; text-decoration: none; }
  .gd__body { font-size: 1rem; line-height: 1.55; color: var(--color-text-muted); }
  .gd__more { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-link); }
  .gd__card--check .gd__more { color: var(--color-human-text); }
  @media (hover: hover) { .gd__card:hover { border-color: color-mix(in oklab, var(--blue-300) 40%, transparent); } }
</style>
