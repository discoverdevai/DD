---
// Signature section for /scale (03 §16b.14, Oct 27; replaces SquadLoop, whose Join/Ship/Review repeated the hero card).
// "From one specialist to a full squad" drawn as an example: one row per role starting in the month it joins, a monthly
// review row (the team-size check with you), then the sprint loop as one strip. Same chart language as Build's plan.
// Rows are a real list; each bar carries its month as text for screen readers. Placement by class (CSP: no inline styles).
import Icon from '../ui/Icon.astro';
import LayerChip, { type Chip } from '../ui/LayerChip.astro';
type IconName = Parameters<typeof Icon>[0]['name'];
interface Props {
  id?: string;
  c: {
    title: string; body: string; example: string; monthLabel: string; fromLabel: string; reviewLabel: string; months: number;
    roles: readonly { icon: string; title: string; from: number }[];
    loop: { meta: string; steps: readonly string[]; note: string };
  };
  chip?: Chip;
}
const { id = 'process', c, chip } = Astro.props;
const M = Array.from({ length: c.months }, (_, i) => i + 1);
---
<section id={id} class="sq" data-surface="ink" aria-labelledby={`${id}-title`}>
  <div class="container sq__inner">
    <header class="sq__head">
      <h2 id={`${id}-title`} class="section-title reveal">{c.title}</h2>
      <p class="sq__body">{c.body}</p>
    </header>

    <div class="sq__chart reveal">
      <p class="sq__example">{c.example}</p>
      <div class="sq__row sq__row--head" aria-hidden="true">
        <span class="sq__corner">{c.monthLabel}</span>
        <span class="sq__track">{M.map((m) => <span class="sq__month">{m}</span>)}</span>
      </div>
      <ol role="list" class="sq__rows">
        {c.roles.map((r) => (
          <li class="sq__row">
            <span class="sq__role"><span class="sq__icon" aria-hidden="true"><Icon name={r.icon as IconName} size={16} /></span>{r.title}</span>
            <span class="sq__track"><span class:list={['sq__bar', `from${r.from}`]}><span class="sr-only">{c.fromLabel} {r.from}</span></span></span>
          </li>
        ))}
      </ol>
      <div class="sq__row sq__row--review" aria-hidden="true">
        <span class="sq__role sq__role--review">{c.reviewLabel}</span>
        <span class="sq__track">{M.map(() => <span class="sq__dot"><i></i></span>)}</span>
      </div>
    </div>

    <div class="sq__loop reveal">
      <span class="sq__meta">{c.loop.meta}</span>
      <ol role="list" class="sq__steps">{c.loop.steps.map((s) => <li>{s}</li>)}</ol>
      <span class="sq__note">{c.loop.note}</span>
      {chip && <LayerChip kind={chip.kind}>{chip.label}</LayerChip>}
    </div>
  </div>
</section>

<style>
  .sq { padding-block: var(--section-y); }
  .sq__inner { display: grid; gap: var(--space-6); }
  .sq__head { display: grid; gap: var(--space-3); }
  .sq__head :global(.section-title) { max-inline-size: 20ch; }
  .sq__body { font-size: var(--text-lg); line-height: 1.55; color: var(--color-text-muted); max-inline-size: var(--measure-lead); }

  /* Chart: label column + one column per month; every row uses the same template so bars line up with the months. */
  .sq__chart { display: grid; gap: var(--space-2); padding: var(--space-5); border-radius: var(--radius-lg); background: color-mix(in oklab, var(--blue-300) 4%, transparent); border: 1px solid var(--color-hairline); }
  @media (width >= 64rem) { .sq__chart { padding: var(--space-6); } }
  .sq__example { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); margin-block-end: var(--space-2); }
  .sq__rows { display: grid; gap: var(--space-2); }
  .sq__row { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); align-items: center; gap: var(--space-3); min-block-size: 2.25rem; }
  @media (width >= 48rem) { .sq__row { grid-template-columns: 11rem minmax(0, 1fr); } }
  .sq__row--head { min-block-size: 0; padding-block-end: var(--space-1); border-block-end: 1px solid var(--color-hairline); }
  .sq__corner { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .sq__track { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 4px; align-items: center; }
  .sq__month { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); text-align: center; }
  .sq__role { display: inline-flex; align-items: center; gap: var(--space-2); min-inline-size: 0; font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-sm); color: var(--color-heading); }
  .sq__icon { display: grid; place-items: center; inline-size: 1.75rem; block-size: 1.75rem; flex: none; border-radius: var(--radius-sm); background: color-mix(in oklab, var(--blue-300) 12%, transparent); color: var(--blue-200); }
  @media (width < 30rem) { .sq__icon { display: none; } }
  .sq__role--review { font-family: var(--ff-body); font-weight: var(--weight-medium); color: var(--color-text-muted); }
  /* A role's bar runs from the month it joins to the end of the window (still on the team). */
  .sq__bar { position: relative; block-size: 1.75rem; border-radius: var(--radius-sm); background: var(--blue-600); grid-column-end: -1; transform-origin: 0 50%; }
  :dir(rtl) .sq__bar { transform-origin: 100% 50%; }
  .sq__rows li:first-child .sq__bar { background: linear-gradient(90deg, var(--blue-500), var(--blue-600)); }
  .from1 { grid-column-start: 1; } .from2 { grid-column-start: 2; } .from3 { grid-column-start: 3; } .from4 { grid-column-start: 4; } .from5 { grid-column-start: 5; } .from6 { grid-column-start: 6; }
  .sq__dot { display: grid; place-items: center; block-size: 1.75rem; }
  .sq__dot i { inline-size: 10px; block-size: 10px; border-radius: 50%; background: var(--color-human-mark); box-shadow: 0 0 0 3px color-mix(in oklab, var(--green-300) 22%, transparent); }

  /* The sprint loop as one strip: the steps in order, joined by arrows that point the reading way. */
  .sq__loop { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); padding: var(--space-4) var(--space-5); border-radius: var(--radius-md); background: var(--color-surface); border: 1px solid var(--color-hairline); border-inline-start: 4px solid var(--blue-500); }
  .sq__meta { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .sq__steps { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-heading); }
  .sq__steps li { display: inline-flex; align-items: center; gap: var(--space-2); }
  .sq__steps li:not(:last-child)::after { content: '→'; font-weight: var(--weight-regular); color: var(--color-text-muted); }
  :dir(rtl) .sq__steps li:not(:last-child)::after { content: '←'; }
  .sq__note { color: var(--color-text-muted); }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .sq__bar { animation: sq-grow linear both; animation-timeline: view(); animation-range: entry 15% cover 40%; }
      @keyframes sq-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    }
  }
</style>
