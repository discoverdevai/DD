---
// RunPanel (06 §0.5): the Signal signature. AI rows (machine voice) then human sign-off rows.
// DOM always holds the final state; the one-time sequence is a visual overlay (≤ 2.4s, once, reduced motion = final state).
import { runPanel as c } from '../../content/copy/en/run-panel';
const FULL_ONLY = new Set([1, 3, 5]); // compact variant (< 30rem container) shows 3 AI rows
---
<figure class="run" data-run>
  <div class="run__top"><span class="run__title">{c.title}</span><span class="run__meta">{c.meta}</span></div>
  <ol class="run__rows" role="list">
    {c.ai.rows.map((row, i) => (
      <li class:list={['run__row run__row--ai', { 'run__row--full': FULL_ONLY.has(i) }]}>
        <span class="run__mark run__dot" aria-hidden="true"></span>
        <span class="run__who">{c.ai.label}</span>
        <span class="run__what"><bdi dir="ltr">{row}</bdi></span>
        <span class="run__state"><span class="run__pre" aria-hidden="true">{c.ai.pending}</span><span class="run__fin">{c.ai.done}</span></span>
        <span class="run__bar" aria-hidden="true"><i></i></span>
      </li>
    ))}
    {c.human.rows.map((row) => (
      <li class="run__row run__row--human">
        <span class="run__mark run__check" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg></span>
        <span class="run__who">{row.who}</span>
        <span class="run__what">{row.what}</span>
        <span class="run__state"><span class="run__pre" aria-hidden="true">{c.human.pending}</span><span class="run__fin">{c.human.done}</span></span>
      </li>
    ))}
  </ol>
  <p class="run__foot">{c.footer}</p>
  <figcaption class="sr-only">{c.caption}</figcaption>
</figure>

<style>
  .run { container-type: inline-size; background: var(--color-surface); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); overflow: hidden; min-inline-size: 0; }
  .run__top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); padding: var(--space-3) var(--space-4); border-block-end: 1px solid var(--color-hairline); font-family: var(--ff-mono); font-size: var(--text-xs); }
  .run__title { color: var(--color-machine-text); font-weight: var(--weight-medium); }
  .run__meta { color: var(--color-text-muted); }
  .run__row { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr) auto; gap: 2px var(--space-3); align-items: center; padding: var(--space-3) var(--space-4); border-block-end: 1px solid var(--color-hairline); }
  .run__row--full { display: none; }
  @container (inline-size >= 30rem) { .run__row--full { display: grid; } }
  .run__mark { grid-row: 1 / span 2; align-self: start; margin-block-start: 0.3rem; justify-self: center; }
  .run__dot { inline-size: 0.5rem; block-size: 0.5rem; border-radius: 50%; background: var(--color-machine-mark); }
  .run__check { inline-size: 1.125rem; block-size: 1.125rem; margin-block-start: 0.1rem; border-radius: 50%; display: grid; place-items: center; background: var(--color-human-mark); color: var(--color-bg); }
  .run__who { font-family: var(--ff-mono); font-size: var(--text-xs); font-weight: var(--weight-medium); color: var(--color-machine-text); }
  .run__row--human .run__who { color: var(--color-human-text); }
  .run__what { font-family: var(--ff-mono); font-size: var(--text-sm); line-height: 1.35; }
  .run__row--human { background: color-mix(in oklab, var(--color-human-mark) 6%, transparent); }
  .run__row--human .run__what { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-base); letter-spacing: -0.005em; }
  .run__state { grid-column: 3; grid-row: 1 / span 2; display: inline-grid; font-family: var(--ff-mono); font-size: var(--text-xs); text-align: end; }
  .run__state > * { grid-area: 1 / 1; transition: opacity var(--dur-base); }
  .run__fin { color: var(--color-machine-text); }
  .run__row--human .run__fin { color: var(--color-human-text); }
  .run__pre { color: var(--color-text-muted); opacity: 0; }
  .run__bar { grid-column: 2 / span 2; block-size: 2px; border-radius: 2px; overflow: hidden; margin-block-start: var(--space-1); background: color-mix(in oklab, var(--color-machine-mark) 18%, transparent); }
  .run__bar i { display: block; block-size: 100%; background: var(--color-machine-mark); transform-origin: 0 50%; transition: transform var(--dur-slow) var(--ease-standard); }
  :dir(rtl) .run__bar i { transform-origin: 100% 50%; }
  .run[data-playing] .run__pre { opacity: 1; }
  .run[data-playing] .run__fin { opacity: 0; }
  .run[data-playing] .run__bar i { transform: scaleX(0); }
  .run .run__row[data-done] .run__pre { opacity: 0; }
  .run .run__row[data-done] .run__fin { opacity: 1; }
  .run .run__row[data-done] .run__bar i { transform: scaleX(1); }
  .run__foot { padding: var(--space-4); font-size: var(--text-sm); color: var(--color-text-muted); }
</style>

<script>
  // Plays once when half visible: AI rows at 220ms steps, human rows at --dur-deliberate (480ms). Total ≤ 2.4s.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-run]').forEach((run) => {
    if (reduce || !('IntersectionObserver' in window)) return;
    run.setAttribute('data-playing', '');
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const rows = [...run.querySelectorAll<HTMLElement>('.run__row')].filter((r) => getComputedStyle(r).display !== 'none');
      let at = 100; // 6 AI rows x 220ms + 2 human rows x 480ms + 100ms = 2.38s (06 §9.6 cap: 2.4s)
      rows.forEach((row) => { at += row.classList.contains('run__row--human') ? 480 : 220; setTimeout(() => row.setAttribute('data-done', ''), at); });
    }, { threshold: 0.5 });
    io.observe(run);
  });
</script>
