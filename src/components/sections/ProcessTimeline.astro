---
import SectionHead from '../ui/SectionHead.astro';
// Lifecycle on home (03 §2A.5, Oct 16): four step cards, one framework drawing each (components/how/Artifact),
// a time pill, one line per step, then the closing line and a link to /how-we-work.
import Artifact from '../how/Artifact.astro';
import { t } from '../../i18n/t';
// `art`: name of the framework drawing shown on top of a step card.
interface Step { title: string; body: string; when?: string; art?: string }
interface Props { eyebrow: string; title: string; lead?: string; more?: { label: string; href: string }; steps: readonly Step[]; line?: string; id?: string }
const { eyebrow, title, lead, more, steps, line, id = 'how-it-works' } = Astro.props;
---
<section id={id} class="tl" data-surface="ink" aria-labelledby="tl-title">
  <div class="container">
    <p class="tl__eyebrow">{eyebrow}</p>
    <SectionHead id="tl-title" title={title} reveal />
    {lead && <p class="tl__lead">{lead}</p>}
    <ol role="list" class="tl__steps reveal-stagger">
      {steps.map((s, i) => (
        <li class:list={['tl__step', { 'tl__step--card': s.art }]}>
          {s.art && <div class="tl__art"><Artifact name={s.art} /></div>}
          <span class="tl__n">0{i + 1}</span>
          <h3 class="tl__h3"><span class="sr-only">{t('steps.label', 'en', { n: i + 1 })} </span>{s.title}</h3>
          {s.when && <p class="tag">{s.when}</p>}
          <p class="tl__body">{s.body}</p>
        </li>
      ))}
    </ol>
    {line && <p class="tl__line">{line}</p>}
    {more && <p class="tl__more"><a href={more.href}>{more.label}<span class="icon--dir" aria-hidden="true"> →</span></a></p>}
  </div>
</section>

<style>
  .tl { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .tl__eyebrow { font-family: var(--ff-mono); font-size: var(--text-sm); color: var(--color-text-muted); margin-block-end: var(--space-4); }
  .tl :global(.section-heading) { margin-block-end: var(--stack-lg); }
  .tl__steps { display: grid; gap: var(--space-8); }
  @media (width >= 48rem) { .tl__steps { grid-template-columns: repeat(2, 1fr); } }
  @media (width >= 64rem) { .tl__steps { grid-template-columns: repeat(4, 1fr); gap: var(--space-6); } }
  .tl__step { display: grid; gap: var(--space-3); align-content: start; }
  .tl__n { font-family: var(--ff-mono); font-size: var(--text-sm); color: var(--color-machine-text); }
  .tl__h3 { font-size: var(--text-lg); font-weight: var(--weight-semibold); letter-spacing: -0.015em; }
  .tl__body { color: var(--color-text-muted); }
  /* Time pill per step (Oct 16). */
  .tl__line { margin-block-start: var(--space-12); padding-block-start: var(--space-6); border-block-start: 1px solid var(--color-hairline); font-family: var(--ff-heading); font-weight: var(--weight-semibold); font-size: var(--text-xl); letter-spacing: -0.02em; color: var(--color-heading); }
  .tl :global(.section-heading:has(+ .tl__lead)) { margin-block-end: var(--space-4); }
  .tl__lead { max-inline-size: 46rem; margin-block-end: var(--stack-lg); font-size: var(--text-lg); line-height: 1.55; color: var(--color-text-muted); text-wrap: pretty; }
  .tl__more { margin-block-start: var(--space-6); }
  .tl__more a { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-link); }
  /* Card steps with one framework drawing each (home, Oct 16: the E2 look, kept simple). */
  .tl__step--card { padding: var(--space-4); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: var(--color-surface); }
  .tl__art { padding: var(--space-2); margin-block-end: var(--space-2); border-radius: var(--radius-md); background: var(--color-bg); }
  /* Card sizing (Oct 16 measurement, 360–1920): keep cards 260–560px wide and body lines at 25+ characters.
     1 column on small phones, 2 from 36rem (576px), 4 only from 72rem (1152px; at 1024 four columns gave ~17ch).
     Small phones: the drawing sits on top, capped at 6rem tall, so the text keeps the full card width. */
  .tl__steps:has(> .tl__step--card) { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  @media (width >= 36rem) { .tl__steps:has(> .tl__step--card) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (width >= 72rem) { .tl__steps:has(> .tl__step--card) { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); } }
  .tl__step--card .tl__art :global(svg) { max-block-size: 6rem; margin-inline: auto; }
  .tl__steps .tl__step--card .tl__body { font-size: 1rem; line-height: 1.55; } /* 16px in cards: ~25ch per line at 4 columns */
  @media (width >= 36rem) { .tl__step--card .tl__art :global(svg) { max-block-size: 9.5rem; } }
</style>
