---
// "Price, team and ownership" (03 §6.12): the three short sections a service page used to spread over three bands, as
// one white document on the light blue surface (brand guidelines: document header with one blue rule, Manrope headings,
// Rubik body, nothing else decorative). Column titles stay H3 so the page outline keeps every topic.
import InlineLink from '../ui/InlineLink.astro';
import type { RouteKey } from '../../data/routes';
// `id` on a column keeps old anchors working (JSON-LD Offer urls point at #pricing).
interface Col { id?: string; title: string; body: string; link?: { label: string; to: RouteKey } }
// `rows` (Oct 26, 03 §16b.6): the same document as a statement of work, one row per term (label left, text right).
interface Props { id?: string; title: string; docTitle: string; docMeta: string; cols: readonly Col[]; layout?: 'cols' | 'rows' }
const { id = 'terms', title, docTitle, docMeta, cols, layout = 'cols' } = Astro.props;
---
<section id={id} class="td" data-surface="ink" aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`} class="section-title td__title reveal">{title}</h2>
    <article class="td__doc reveal">
      <header class="td__head">
        <p class="td__brand">DiscoverDev <span>· {docTitle}</span></p>
        <p class="td__meta">{docMeta}</p>
      </header>
      <div class:list={['td__cols', { 'td__cols--rows': layout === 'rows' }]}>
        {cols.map((c) => (
          <div class="td__col" id={c.id}>
            <h3 class="td__h3">{c.title}</h3>
            <p class="td__body">{c.body}</p>
            {c.link && <p class="td__more"><InlineLink text="" link={c.link} /></p>}
          </div>
        ))}
      </div>
    </article>
  </div>
</section>

<style>
  .td { padding-block: var(--section-y); }
  .td__title { color: var(--color-heading); margin-block-end: var(--space-8); }
  .td__doc { background: var(--color-surface); border-radius: var(--radius-md); border: 1px solid var(--color-hairline); padding: clamp(var(--space-6), 1rem + 3vw, var(--space-12)); }
  .td__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-2) var(--space-6); padding-block-end: var(--space-4); margin-block-end: var(--space-8); border-block-end: 2px solid var(--blue-500); }
  .td__brand { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-heading); }
  .td__brand span { color: var(--color-machine-text); }
  .td__meta { font-size: var(--text-sm); color: var(--color-text-muted); }
  .td__cols { display: grid; gap: var(--space-8); }
  @media (width >= 56rem) { .td__cols { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-10); } .td__col + .td__col { padding-inline-start: var(--space-10); border-inline-start: 1px solid var(--color-hairline); } }
  .td__col { display: grid; gap: var(--space-3); align-content: start; }
  .td__cols--rows { grid-template-columns: minmax(0, 1fr) !important; gap: 0; }
  .td__cols--rows .td__col { padding-block: var(--space-5); padding-inline-start: 0 !important; border-inline-start: 0 !important; border-block-start: 1px solid var(--color-hairline); }
  .td__cols--rows .td__col:first-child { border-block-start: 0; padding-block-start: 0; }
  @media (width >= 56rem) { .td__cols--rows .td__col { grid-template-columns: 14rem minmax(0, 1fr); column-gap: var(--space-10); } .td__cols--rows .td__more { grid-column: 2; } }
  .td__cols--rows .td__h3 { font-size: var(--text-lg); }
  .td__h3 { font-family: var(--ff-heading); font-size: var(--text-xl); font-weight: var(--weight-bold); letter-spacing: -0.015em; color: var(--color-heading); }
  .td__body { color: var(--color-text-muted); line-height: 1.6; }
  .td__more { font-weight: var(--weight-medium); }
</style>
