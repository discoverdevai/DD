---
// End CTA card (04 §4.8 item 8, 03 §15.8): rendered when relatedService is `review`.
// The only filled button in the article body. Clarity-call variant waits for its 03 copy (see report).
import CtaLink from '../ui/CtaLink.astro';
import CtaTerms from '../ui/CtaTerms.astro';
import { insights as c } from '../../content/copy/en/insights';
import { t } from '../../i18n/t';
import { bookHref } from '../../data/routes';
interface Props { ctaPrefix: string }
const { ctaPrefix } = Astro.props;
---
<aside class="endcta" aria-labelledby="endcta-title" data-cta-band>
  <h2 id="endcta-title" class="endcta__title">{c.article.endCtaTitle}</h2>
  <CtaLink href={bookHref('review')} ctaId={`${ctaPrefix}_end_review`} tier="primary" position="end" target="review" wide>{t('cta.review')}</CtaLink>
  <CtaTerms kind="review" />
</aside>

<style>
  .endcta { display: grid; gap: var(--space-5); justify-items: start; padding: var(--space-8); background: var(--color-surface-alt); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); }
  .endcta__title { font-size: var(--text-2xl); font-weight: var(--weight-extrabold); max-inline-size: var(--measure-heading); }
</style>
