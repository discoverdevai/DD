---
// Table of contents (04 §4.8 item 4): H2s from render() headings. The layout renders it only above 1,200 words.
import { insights as c } from '../../content/copy/en/insights';
interface Heading { depth: number; slug: string; text: string }
interface Props { headings: readonly Heading[] }
const items = Astro.props.headings.filter((h) => h.depth === 2);
---
{items.length > 1 && (
  <nav class="toc" aria-labelledby="toc-title">
    <h2 id="toc-title" class="toc__title">{c.article.tocTitle}</h2>
    <ol role="list">
      {items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ol>
  </nav>
)}

<style>
  .toc { display: grid; gap: var(--space-3); padding-block: var(--space-5); border-block: 1px solid var(--color-border-subtle); }
  .toc__title { font-size: var(--text-base); line-height: var(--leading-snug); }
  .toc ol { display: grid; gap: var(--space-1); counter-reset: toc; }
  .toc li { counter-increment: toc; display: grid; grid-template-columns: 2ch minmax(0, 1fr); gap: var(--space-3); align-items: baseline; }
  .toc li::before { content: counter(toc); font-family: var(--ff-mono); font-size: var(--text-sm); color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .toc a { display: inline-flex; align-items: center; min-block-size: 2.75rem; padding-block: var(--space-1); }
</style>
