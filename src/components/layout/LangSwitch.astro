---
// Language switcher (06 §9.4, 03 §1.2 "العربية" / "English"): links to the same page in the other language, never to a
// home page that is not the pair. The label is the target language's own name, in its own lang and direction.
// Shown only where a pair exists (today: / and /ar). English pages show it only once Arabic is live
// (LOCALES.ar.status 'live' after native review); the Arabic page always shows the way back to English.
import Icon from '../ui/Icon.astro';
import { LOCALES } from '../../i18n/locales';
import { getLocale } from '../../i18n/t';

interface Props { class?: string }
const PAIRS: Record<string, string> = { '/': '/ar' };
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '') || '/';
const onArabic = getLocale() === 'ar';
const enPath = onArabic ? Object.keys(PAIRS).find((k) => PAIRS[k] === path) : path;
const arPath = enPath ? PAIRS[enPath] : undefined;
const target = onArabic ? LOCALES.en : LOCALES.ar;
const href = onArabic ? enPath : arPath;
// AR_PREVIEW=1 (local review build only) shows the English-side link before Arabic is live, so the switch can be tried both ways.
const show = Boolean(href) && (onArabic || (LOCALES.ar.status as string) === 'live' || process.env.AR_PREVIEW === '1');
---
{show && (
  <a class:list={['lang-switch', Astro.props.class]} href={href} hreflang={target.code} lang={target.code} dir={target.dir} data-link-context="lang">
    <Icon name="globe" size={16} />{target.endonym}
  </a>
)}

<style>
  .lang-switch { display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 2.75rem; padding-inline: var(--space-2); color: var(--color-text-muted); font-weight: var(--weight-medium); text-decoration: none; white-space: nowrap; border-radius: var(--radius-sm); transition: color var(--dur-color); }
  .lang-switch:lang(ar) { font-family: var(--font-arabic, "IBM Plex Sans Arabic"), system-ui, sans-serif; }
  @media (hover: hover) { .lang-switch:hover { color: var(--color-heading); } }
</style>
