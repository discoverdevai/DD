---
// Language switcher (06 §9.4, 03 §1.2): one plain text link in the nav's own style, showing the OTHER language in its own
// script ("العربية" on English pages, "English" on Arabic pages), same page in the other language. No pill, no flag, no
// icon (Mohamed, Oct 23: simpler, in the theme). The label carries its own lang and dir. Shown only where a pair exists
// (today: / and /ar). English pages show it only once Arabic is live (LOCALES.ar.status 'live' after native review);
// the Arabic page always shows the way back to English.
import { LOCALES } from '../../i18n/locales';
import { getLocale, AR_PAGES } from '../../i18n/t';

interface Props { class?: string }
// Every page in AR_PAGES exists in both languages: /x <-> /ar/x, / <-> /ar.
const toAr = (p: string) => (p === '/' ? '/ar' : `/ar${p}`);
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '') || '/';
const onArabic = getLocale() === 'ar';
const enPath = onArabic ? (path === '/ar' ? '/' : path.replace(/^\/ar/, '')) : path;
const hasPair = (AR_PAGES as readonly string[]).includes(enPath);
const href = hasPair ? (onArabic ? enPath : toAr(enPath)) : undefined;
const target = onArabic ? LOCALES.en : LOCALES.ar;
// AR_PREVIEW=1 (local review build only) shows the English-side link before Arabic is live, so it can be tried both ways.
const show = Boolean(href) && (onArabic || (LOCALES.ar.status as string) === 'live' || process.env.AR_PREVIEW === '1');
---
{show && (
  <a class:list={['lang-switch', Astro.props.class]} href={href} hreflang={target.code} lang={target.code} dir={target.dir} data-link-context="lang">{target.endonym}</a>
)}

<style>
  /* Same look as a nav link: muted, medium weight, white on hover. */
  .lang-switch { display: inline-flex; align-items: center; min-block-size: 2.75rem; padding-inline: var(--space-2); color: var(--color-text-muted); text-decoration: none; font-size: var(--text-sm); font-weight: var(--weight-medium); white-space: nowrap; transition: color var(--dur-color); }
  .lang-switch:lang(ar) { font-family: var(--font-arabic, "IBM Plex Sans Arabic"), system-ui, sans-serif; font-size: var(--text-base); }
  @media (hover: hover) { .lang-switch:hover { color: var(--color-text); } }
</style>
