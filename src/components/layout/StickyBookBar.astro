---
// Mobile sticky CTA (06 §9.3, 04 §3.3). Shown below 64rem after the hero CTA leaves the viewport;
// hidden while a text field has focus and while the closing band is in view.
import CtaLink from '../ui/CtaLink.astro';
import { t } from '../../i18n/t';
import { bookHref } from '../../data/routes';
// Strategy v2 (04 §3.3): clarity call everywhere; /launch-ready keeps the Review.
interface Props { kind?: 'clarity' | 'review' }
const { kind = 'clarity' } = Astro.props;
---
<div class="bottom-bar" data-surface="ink" data-bottom-bar hidden>
  {kind === 'review'
    ? <CtaLink href={bookHref('review')} ctaId="sticky_book_review" tier="primary" position="sticky" target="review" wide>{t('cta.review.short')}</CtaLink>
    : <CtaLink href={bookHref('clarity')} ctaId="sticky_book_clarity" tier="primary" position="sticky" target="clarity" wide>{t('cta.clarity.short')}</CtaLink>}
  <p class="bottom-bar__line">{t(kind === 'review' ? 'sticky.line' : 'sticky.line.clarity')}</p>
</div>

<style>
  .bottom-bar { position: fixed; inset-inline: 0; inset-block-end: 0; z-index: var(--z-sticky); padding: var(--space-3) var(--gutter) calc(var(--space-3) + env(safe-area-inset-bottom, 0px)); box-shadow: var(--shadow-up); border-block-start: 1px solid var(--color-border-subtle); display: grid; gap: var(--space-1); text-align: center; }
  .bottom-bar[hidden] { display: none; }
  .bottom-bar__line { font-size: var(--text-sm); color: var(--color-text-muted); }
  .bottom-bar :global(.cta--wide) { inline-size: 100%; }
  @media (width >= 64rem) { .bottom-bar { display: none !important; } }
  @media (prefers-reduced-motion: no-preference) {
    .bottom-bar:not([hidden]) { animation: bar-in var(--dur-base) var(--ease-enter); }
    @keyframes bar-in { from { translate: 0 100%; } }
  }
</style>

<script>
  // CSSOM writes (style.setProperty) are not blocked by the meta CSP; only style attributes in markup are.
  const bar = document.querySelector<HTMLElement>('[data-bottom-bar]');
  // Shows once the hero CTA (or, on articles, the article header: data-sticky-after) has scrolled out of view.
  const heroCta = document.querySelector('[data-hero-cta], [data-sticky-after]');
  const band = document.querySelector('[data-cta-band]');
  if (bar && heroCta) {
    const mq = matchMedia('(width < 64rem)');
    let heroGone = false, bandIn = false, typing = false;
    const sync = () => { bar.hidden = !(mq.matches && heroGone && !bandIn && !typing); };
    // The bar's height reaches --bottom-bar-h through a ResizeObserver (0 while hidden), so showing it never forces a
    // synchronous layout inside a scroll frame, and <html> is only restyled when the value really changes.
    let barH = 0;
    new ResizeObserver(([e]) => {
      const h = Math.round(e.borderBoxSize[0]?.blockSize ?? 0);
      if (h !== barH) { barH = h; document.documentElement.style.setProperty('--bottom-bar-h', `${h}px`); }
    }).observe(bar);
    new IntersectionObserver(([e]) => { heroGone = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(heroCta);
    // Stay hidden once the closing band is reached (in view or scrolled past), so the bar never covers the footer.
    if (band) new IntersectionObserver(([e]) => { bandIn = e.isIntersecting || e.boundingClientRect.top < 0; sync(); }).observe(band);
    document.addEventListener('focusin', (e) => { typing = (e.target as Element).matches('input, select, textarea'); sync(); });
    document.addEventListener('focusout', () => { typing = false; sync(); });
    mq.addEventListener('change', sync);
  }
</script>
