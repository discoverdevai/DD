---
// Site header (06 §9.1, 04 §3.1). Always on the ink surface (06 §0.4). Two variants:
// default = logo, nav, Book a call, menu button; minimal (/book, /launch-check) = logo + Back.
// Oct 29 (Mohamed chose the floating capsule, .taste-skill/topbar-capsule.html): the bar is a glass capsule centred in the
// header strip; once the page scrolls, the strip turns clear and the capsule floats over the content. Links in the order a
// buyer asks: Build, Scale (what), Work (proof), How we work (how), Pricing (cost, once live). FAQ lives in the footer.
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import CtaLink from '../ui/CtaLink.astro';
import LangSwitch from './LangSwitch.astro';
import MobileMenu from './MobileMenu.astro';
import { t, localPath } from '../../i18n/t';
import { ROUTES, href, isLive, bookHref, type RouteKey } from '../../data/routes';

interface Props { variant?: 'default' | 'minimal'; current?: string }
const { variant = 'default', current = Astro.url.pathname } = Astro.props;

// Lean R1 (03 §16b.4): Build and Scale are top-level links; the Services menu only holds pages beyond them.
const SERVICE_LINKS = (['build', 'scale', 'pricing'] as const).filter(isLive).map((k) => ({ href: href(k), label: t(`nav.${k}`) }));
const SERVICES: { key: RouteKey; label: string; who: string }[] = (['validate', 'review', 'partners'] as const)
  .filter(isLive)
  .map((key) => ({ key, label: t(`nav.${key}`), who: t(`nav.${key}.who`) }));
// Nav links. A section that has no live page falls back to its anchor on home, so V1.0 (one-page site, 03 §2V1) reads:
// Services · How we work · Work · Reviews · FAQ, all jumping to home sections. Pages switch back in per release.
type NavLink = { href: string; label: string };
const lean = SERVICE_LINKS.length > 0;
const LEAN_LINKS: NavLink[] = [
  ...(['build', 'scale'] as const).filter(isLive).map((k) => ({ href: href(k), label: t(`nav.${k}`) })),
  { href: isLive('work') ? href('work') : localPath('/#work'), label: t('nav.work') }, // home's work section until /work ships
  { href: href('howWeWork'), label: t('nav.how') },
  ...(isLive('pricing') ? [{ href: href('pricing'), label: t('nav.pricing') }] : []),
  ...(isLive('insights') ? [{ href: href('insights'), label: t('nav.insights') }] : []),
];
const V1_LINKS: NavLink[] = [
  ...(SERVICES.length === 0 ? [{ href: localPath('/#services'), label: t('nav.services') }] : []),
  { href: isLive('howWeWork') ? href('howWeWork') : localPath('/#how-we-work'), label: t('nav.how') },
  { href: isLive('work') ? href('work') : localPath('/#work'), label: t('nav.work') },
  // Five items at most: the Reviews anchor gives its place to the service links once they are live.
  ...(isLive('insights') ? [{ href: href('insights'), label: t('nav.insights') }] : SERVICE_LINKS.length > 0 ? [] : [{ href: localPath('/#reviews'), label: t('nav.reviews') }]),
  ...(isLive('about') ? [{ href: href('about'), label: t('nav.about') }] : [{ href: localPath('/#faq'), label: t('nav.faq') }]),
];
const LINKS = lean ? LEAN_LINKS : V1_LINKS;
const isCurrent = (path: string) => current.replace(/\.html$/, '').replace(/\/$/, '') === path.replace(/\/$/, '');
const servicesCurrent = SERVICES.some((s) => isCurrent(ROUTES[s.key].path));
---
<header class="site-header" data-surface="ink" data-header>
  <div class="site-header__bar">
    <a href={localPath('/')} class="site-header__home" aria-label={t('logo.home')}><Logo /></a>

    {variant === 'default' && (
      <nav class="site-nav" aria-label={t('nav.label')}>
        <ul role="list" class="site-nav__list">
          {SERVICES.length > 0 && (
            <li class="site-nav__services">
              <button type="button" class="site-nav__toggle" aria-expanded="false" aria-controls="services-panel" aria-current={servicesCurrent ? 'true' : undefined} data-disclosure>
                {t('nav.services')}<Icon name="chevron-down" size={16} />
              </button>
              <ul role="list" id="services-panel" class="services-panel" data-surface="paper" hidden>
                {SERVICES.map((s) => (
                  <li><a href={href(s.key)} aria-current={isCurrent(ROUTES[s.key].path) ? 'page' : undefined}><span class="services-panel__label">{s.label}</span><span class="services-panel__who">{s.who}</span></a></li>
                ))}
              </ul>
            </li>
          )}
          {LINKS.map((l) => <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
        </ul>
      </nav>
    )}

    {variant === 'default' ? (
      <div class="site-header__actions">
        <LangSwitch class="site-header__lang" />
        <CtaLink href={bookHref('clarity')} ctaId="nav_book_clarity" tier="primary" position="nav" target="clarity" size="sm" variant="soft" class="site-header__book">{t('cta.clarity.short')}</CtaLink>
        <button type="button" class="site-header__menu" aria-haspopup="dialog" aria-controls="menu-sheet" commandfor="menu-sheet" command="show-modal" data-menu-open>
          <Icon name="menu" size={20} /><span class="sr-only">{t('menu.open')}</span>
        </button>
      </div>
    ) : (
      <a href={localPath('/')} class="site-header__back" data-back><Icon name="arrow-left" size={16} directional />{t('back')}</a>
    )}
  </div>
  {variant === 'default' && <MobileMenu services={SERVICES} links={LINKS} />}
</header>

<style>
  /* The strip is ink at the top of the page and clear once scrolled; the capsule carries its own glass. */
  .site-header { position: sticky; inset-block-start: 0; z-index: var(--z-header); display: flex; align-items: center; min-block-size: var(--header-h); padding-inline: var(--gutter); background: var(--color-bg); transition: translate var(--dur-slow) var(--ease-exit), background-color var(--dur-color); }
  .site-header[data-scrolled] { background: transparent; pointer-events: none; } /* the clear strip never blocks the page */
  .site-header__bar, .site-header :global(dialog) { pointer-events: auto; }
  .site-header[data-hidden] { translate: 0 -100%; }
  .site-header__bar { display: flex; align-items: center; gap: var(--space-2); inline-size: 100%; margin-inline: auto; min-block-size: calc(var(--header-h) - var(--space-4)); padding: var(--space-1); padding-inline-start: var(--space-4); border-radius: 999px; border: 1px solid color-mix(in oklab, var(--blue-300) 20%, transparent); background: color-mix(in oklab, var(--blue-950) 88%, transparent); box-shadow: 0 20px 40px -20px rgb(var(--black-rgb) / 0.8); }
  @supports (backdrop-filter: blur(1px)) { .site-header__bar { background: color-mix(in oklab, var(--blue-950) 70%, transparent); backdrop-filter: blur(14px) saturate(140%); } }
  @media (width >= 64rem) { .site-header__bar { inline-size: fit-content; gap: var(--space-3); padding-inline-start: var(--space-5); } }
  .site-header__home { display: inline-flex; padding-block: var(--space-2); border-radius: var(--radius-xs); }
  .site-nav { display: none; margin-inline-start: var(--space-4); }
  .site-nav__list { display: flex; align-items: center; gap: var(--space-1); }
  /* Capsule links: pills; the current page gets a soft fill instead of an underline. */
  .site-nav__list > li > a { padding-inline: var(--space-3); border-radius: 999px; }
  .site-nav a, .site-nav__toggle { display: inline-flex; align-items: center; gap: var(--space-1); min-block-size: 2.75rem; color: var(--color-text-muted); text-decoration: none; font-size: var(--text-sm); font-weight: var(--weight-medium); background: none; border: 0; cursor: pointer; padding: 0; position: relative; }
  .site-nav__list > li > a[aria-current] { background: color-mix(in oklab, var(--blue-300) 14%, transparent); color: var(--color-heading); }
  @media (hover: hover) { .site-nav a:hover, .site-nav__toggle:hover { color: var(--color-text); } }
  .site-nav__toggle :global(.icon) { transition: rotate var(--dur-base) var(--ease-standard); }
  .site-nav__toggle[aria-expanded='true'] :global(.icon) { rotate: 180deg; }
  .site-nav__services { position: relative; }
  .services-panel { position: absolute; inset-block-start: calc(100% + var(--space-2)); inset-inline-start: calc(var(--space-4) * -1); min-inline-size: 20rem; padding: var(--space-2); border-radius: var(--radius-md); box-shadow: var(--shadow-md); z-index: var(--z-dropdown); border: 1px solid var(--color-border-subtle); }
  .services-panel a { display: grid; gap: 2px; padding: var(--space-3); border-radius: var(--radius-sm); color: var(--color-text); text-decoration: none; min-block-size: 2.75rem; }
  .services-panel a::after { display: none; }
  @media (hover: hover) { .services-panel a:hover { background: var(--color-surface-alt); color: var(--color-text); } }
  .services-panel__label { font-weight: var(--weight-medium); }
  .services-panel__who { font-size: var(--text-sm); color: var(--color-text-muted); }
  .site-header__actions { margin-inline-start: auto; display: flex; align-items: center; gap: var(--space-2); }
  /* Phones: the language link lives in the menu sheet; the bar keeps the button and the menu. */
  @media (width < 36rem) { .site-header__actions :global(.site-header__lang) { display: none; } }
  .site-header__menu { inline-size: 2.75rem; block-size: 2.75rem; display: grid; place-items: center; border-radius: 999px; border: 0; background: color-mix(in oklab, var(--blue-300) 12%, transparent); color: var(--color-text); cursor: pointer; }
  .site-header__actions :global(.site-header__book) { border-radius: 999px; }
  .site-header__back { margin-inline-start: auto; padding-inline-end: var(--space-3); display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 2.75rem; color: var(--color-link); font-weight: var(--weight-medium); }
  @media (width < 22.5rem) { .site-header__actions :global(.site-header__book) { display: none; } }
  /* Desktop shows the full label from 80rem (03 §2V1, CRO review); narrower widths keep the short one. */
  /* One booking button at a time on phones: the sticky bar replaces the header button while it shows (UX audit P1-2). */
  @media (width < 64rem) { :global(:root[data-sticky-on]) .site-header__book { display: none; } }
  @media (width >= 64rem) { .site-nav { display: block; } .site-header__menu { display: none; } }
  @media (prefers-reduced-motion: reduce) { .site-header[data-hidden] { translate: none; } }
</style>

<script>
  // Services disclosure: click/Enter/Space toggles, Esc and outside click close, focus returns (04 §3.1, 06 §9.1).
  const toggle = document.querySelector<HTMLButtonElement>('[data-disclosure]');
  const panel = toggle && document.getElementById(toggle.getAttribute('aria-controls') ?? '');
  const setOpen = (open: boolean, refocus = false) => {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    if (!open && refocus) toggle.focus();
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setOpen(false, true); });
  document.addEventListener('click', (e) => { if (toggle && panel && !toggle.contains(e.target as Node) && !panel.contains(e.target as Node)) setOpen(false); });
  panel?.addEventListener('focusout', (e) => { const next = e.relatedTarget as Node | null; if (next && !panel.contains(next) && next !== toggle) setOpen(false); });

  // Minimal header "Back": history.back() for same-origin referrers, else home (04 §4.10).
  document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click', (e) => {
    try { if (document.referrer && new URL(document.referrer).origin === location.origin) { e.preventDefault(); history.back(); } } catch { /* keep href */ }
  });

  // Hide on scroll down past 400px, show on scroll up; never while focus is inside or a panel is open; never under reduced motion.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // lastY starts lazily on the first scroll event: reading scrollY at startup forced a style + layout before first paint.
  let lastY = -1;
  addEventListener('scroll', () => {
    if (!header) return;
    const y = scrollY;
    if (lastY < 0) lastY = y;
    header.toggleAttribute('data-scrolled', y > 8);
    const busy = header.contains(document.activeElement) || toggle?.getAttribute('aria-expanded') === 'true';
    if (reduce || busy || y < 400 || y < lastY) header.removeAttribute('data-hidden');
    else if (y > lastY + 4) header.setAttribute('data-hidden', '');
    lastY = y;
  }, { passive: true });
  header?.addEventListener('focusin', () => header.removeAttribute('data-hidden'));
</script>
