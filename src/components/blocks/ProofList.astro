---
// Anonymized proof items for service pages (04 §4.3 #8, 03 §0.7 [CONSENT]): what we did, where, optional detail.
// No names, logos or quotes. v3: home tiles with the region as a mono tag.
interface Item { title: string; where?: string; body?: string }
interface Props { items: readonly Item[] }
const { items } = Astro.props;
---
<ul role="list" class="proof reveal-stagger">
  {items.map((it) => (
    <li class="proof__item" data-spotlight>
      {it.where && <p class="tag">{it.where}</p>}
      <h3 class="h3 proof__title">{it.title}</h3>
      {it.body && <p class="proof__body">{it.body}</p>}
    </li>
  ))}
</ul>

<style>
  .proof { display: grid; gap: var(--space-4); }
  @media (width >= 48rem) { .proof { grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); } }
  .proof__item { display: grid; gap: var(--space-3); align-content: start; min-inline-size: 0; padding: var(--space-6) var(--space-6) var(--space-8); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: linear-gradient(180deg, color-mix(in oklab, var(--color-surface) 90%, var(--blue-800)), color-mix(in oklab, var(--color-surface) 40%, transparent)); }
  :global([data-surface='paper']) .proof__item, :global([data-surface='alt']) .proof__item { background: var(--neutral-0); border-color: var(--blue-100); border-block-start: 4px solid var(--blue-700); border-radius: 4px 4px var(--radius-md) var(--radius-md); }
  :global([data-surface='paper']) .proof__title { color: var(--neutral-950); }
  .proof__title { font-size: var(--text-lg); font-weight: var(--weight-semibold); letter-spacing: -0.015em; }
  .proof__body { color: var(--color-text-muted); }
</style>
