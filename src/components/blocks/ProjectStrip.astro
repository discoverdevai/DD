---
// One more project from idea to launch, as a slim bar under the case card (03 §16b.10, Oct 26): region tag, the
// anonymized project name, the path it took as steps in order, and the review rating with its Clutch link.
// Replaces a lone ProofList card that left most of its row empty. No client name ([CONSENT], 03 §0.7).
import ProofChip from '../ui/ProofChip.astro';
interface Props { c: { label: string; where: string; title: string; steps: readonly string[] } }
const { c } = Astro.props;
---
<article class="ps reveal">
  <div class="ps__main">
    <p class="ps__tag"><span class="tag">{c.where}</span><span class="ps__label">{c.label}</span></p>
    <h3 class="ps__title">{c.title}</h3>
    <ol role="list" class="ps__steps">{c.steps.map((s) => <li><span class="ps__step">{s}</span></li>)}</ol>
  </div>
  <ProofChip class="ps__rating" />
</article>

<style>
  .ps { display: grid; gap: var(--space-5) var(--space-10); align-items: center; padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: color-mix(in oklab, var(--blue-600) 10%, var(--color-surface)); }
  @media (width >= 64rem) { .ps { grid-template-columns: minmax(0, 1fr) auto; } .ps :global(.ps__rating) { padding-inline-start: var(--space-10); border-inline-start: 1px solid var(--color-hairline); align-self: stretch; display: flex; align-items: center; } }
  .ps__main { display: grid; gap: var(--space-3); }
  .ps__tag { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .ps__label { font-size: var(--text-sm); color: var(--color-text-muted); }
  .ps__title { font-family: var(--ff-heading); font-size: var(--text-lg); font-weight: var(--weight-bold); color: var(--color-heading); }
  /* The path in order: chips joined by an arrow that points the reading way. */
  .ps__steps { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .ps__steps li { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-text); }
  /* Arrow after each step (not before), so a wrapped line never starts with a lone arrow. */
  .ps__steps li:not(:last-child)::after { content: '→'; color: var(--color-text-muted); }
  :dir(rtl) .ps__steps li:not(:last-child)::after { content: '←'; }
  .ps__step { padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); border: 1px solid var(--color-hairline); background: color-mix(in oklab, var(--blue-300) 6%, transparent); }
</style>
