---
// Home hero visual (03 §2.2b, docs/home-teardown.md): a Review workspace. AI layer (mono, signal blue) flags findings;
// the human layer (green) verifies them and signs off. Final state is always in the DOM; the one-time sequence is
// a visual overlay (≤ 2.4s, plays once, reduced motion = final state).
import { workspace as c } from '../../content/copy/en/workspace';
const counts = { critical: 2, high: 1, medium: 2 };
---
<figure class="ws" data-ws>
  <div class="ws__bar">
    <span class="ws__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="ws__path"><bdi dir="ltr">{c.path}</bdi></span>
    <span class="ws__badge">{c.badge}</span>
  </div>
  <div class="ws__body">
    <nav class="ws__side" aria-label={c.sidebarTitle}>
      <p class="ws__label">{c.sidebarTitle}</p>
      <ul role="list">
        {c.areas.map((a, i) => <li class:list={{ 'is-active': i === 0 }}><span class="ws__pip" aria-hidden="true"></span>{a}</li>)}
      </ul>
    </nav>
    <div class="ws__main">
      <div class="ws__head">
        <p class="ws__title">{c.findingsTitle}</p>
        <ul role="list" class="ws__filters" aria-hidden="true">
          <li class="is-on">{c.filters[0]} <b>5</b></li><li>{c.filters[1]} <b>{counts.critical}</b></li><li>{c.filters[2]} <b>{counts.high}</b></li><li>{c.filters[3]} <b>{counts.medium}</b></li>
        </ul>
      </div>
      <ol role="list" class="ws__rows">
        {c.rows.map((r) => (
          <li class="ws__row" data-ws-row>
            <span class:list={['sev', `sev--${r.sev}`]}>{r.label}</span>
            <span class="ws__finding">{r.title}<span class="ws__area">{r.area}</span></span>
            <span class="ws__state"><span class="ws__pre" aria-hidden="true">{c.states.pending}</span><span class="ws__fin"><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>{c.states.done}</span></span>
          </li>
        ))}
      </ol>
    </div>
    <aside class="ws__run" aria-label={c.runTitle}>
      <p class="ws__label">{c.runTitle}</p>
      <ul role="list" class="ws__log">
        {c.runLines.map((l) => <li data-ws-line><span class="ws__dot" aria-hidden="true"></span><bdi dir="ltr">{l}</bdi><span class="ws__bar2" aria-hidden="true"><i></i></span></li>)}
      </ul>
      <div class="ws__sign" data-ws-sign>
        <span class="ws__check" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
        <p class="ws__verdict">{c.signoff.verdict}</p>
        <p class="ws__by">{c.signoff.by}</p>
        <p class="ws__quote">{c.signoff.quote}</p>
      </div>
    </aside>
  </div>
  <figcaption class="sr-only">{c.caption}</figcaption>
</figure>

<style>
  .ws { --ws-line: var(--color-hairline); --ws-raised: color-mix(in oklab, var(--color-surface) 70%, var(--blue-800)); position: relative; container-type: inline-size; border-radius: var(--radius-lg); background: linear-gradient(180deg, var(--ws-raised), var(--color-surface) 40%); border: 1px solid color-mix(in oklab, var(--blue-300) 22%, transparent); box-shadow: inset 0 1px 0 color-mix(in oklab, var(--neutral-0) 10%, transparent), 0 40px 120px -30px color-mix(in oklab, var(--blue-700) 70%, transparent), 0 0 0 1px color-mix(in oklab, var(--blue-975) 60%, transparent); overflow: hidden; text-align: start; font-size: var(--text-sm); }
  .ws__bar { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); border-block-end: 1px solid var(--ws-line); }
  .ws__dots { display: inline-flex; gap: 6px; } .ws__dots i { inline-size: 10px; block-size: 10px; border-radius: 50%; background: color-mix(in oklab, var(--blue-300) 28%, transparent); }
  .ws__path { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .ws__badge { margin-inline-start: auto; font-family: var(--ff-mono); font-size: 0.6875rem; padding: 2px 8px; border-radius: var(--radius-pill); border: 1px solid var(--ws-line); color: var(--color-text-muted); }
  .ws__body { display: grid; grid-template-columns: minmax(0, 1fr); }
  @container (inline-size >= 52rem) { .ws__body { grid-template-columns: 12rem minmax(0, 1fr) 16rem; } }
  .ws__side, .ws__run { display: none; }
  @container (inline-size >= 52rem) { .ws__side, .ws__run { display: grid; align-content: start; gap: var(--space-3); padding: var(--space-5) var(--space-4); } .ws__side { border-inline-end: 1px solid var(--ws-line); } .ws__run { border-inline-start: 1px solid var(--ws-line); background: color-mix(in oklab, var(--blue-975) 45%, transparent); } }
  @container (inline-size < 52rem) { .ws__run { display: grid; padding: var(--space-4); border-block-start: 1px solid var(--ws-line); } .ws__run > .ws__label, .ws__log { display: none; } }
  .ws__label { font-family: var(--ff-mono); font-size: 0.6875rem; color: var(--color-machine-text); }
  .ws__side ul { display: grid; gap: 2px; }
  .ws__side li { display: flex; align-items: center; gap: var(--space-2); padding: 7px var(--space-2); border-radius: var(--radius-sm); color: var(--color-text-muted); font-size: var(--text-xs); }
  .ws__side li.is-active { background: color-mix(in oklab, var(--blue-300) 10%, transparent); color: var(--color-text); }
  .ws__pip { inline-size: 6px; block-size: 6px; border-radius: 50%; background: var(--color-machine-mark); flex: none; }
  .ws__main { padding: var(--space-5); display: grid; gap: var(--space-4); align-content: start; min-inline-size: 0; }
  .ws__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .ws__title { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-base); color: var(--color-heading); }
  .ws__filters { display: flex; gap: var(--space-1); font-size: 0.6875rem; color: var(--color-text-muted); }
  .ws__filters li { padding: 3px 9px; border-radius: var(--radius-pill); border: 1px solid var(--ws-line); }
  .ws__filters li.is-on { color: var(--color-text); border-color: color-mix(in oklab, var(--blue-300) 40%, transparent); }
  .ws__filters b { font-weight: var(--weight-medium); color: var(--color-machine-text); margin-inline-start: 2px; }
  .ws__rows { display: grid; border: 1px solid var(--ws-line); border-radius: var(--radius-md); overflow: hidden; }
  .ws__row { display: grid; grid-template-columns: 4.75rem minmax(0, 1fr) auto; gap: var(--space-3); align-items: center; padding: var(--space-3) var(--space-4); border-block-end: 1px solid var(--ws-line); }
  .ws__row:last-child { border-block-end: 0; }
  @container (inline-size < 34rem) { .ws__row { grid-template-columns: auto 1fr; } .ws__finding { grid-column: 1 / -1; grid-row: 2; } .ws__state { justify-self: end; } .ws__main { padding: var(--space-4); } .ws__filters li:nth-child(n + 3) { display: none; } }
  .sev { justify-self: start; font-size: 0.6875rem; font-weight: var(--weight-semibold); padding: 2px 8px; border-radius: var(--radius-pill); }
  .sev--critical { color: var(--red-300); background: color-mix(in oklab, var(--red-300) 14%, transparent); }
  .sev--high { color: var(--amber-300); background: color-mix(in oklab, var(--amber-300) 14%, transparent); }
  .sev--medium { color: var(--blue-200); background: color-mix(in oklab, var(--blue-200) 12%, transparent); }
  .ws__finding { display: grid; gap: 2px; color: var(--color-text); font-weight: var(--weight-medium); line-height: 1.35; min-inline-size: 0; }
  .ws__area { font-weight: var(--weight-regular); font-size: var(--text-xs); color: var(--color-text-muted); }
  .ws__state { display: inline-grid; font-family: var(--ff-mono); font-size: 0.6875rem; text-align: end; }
  .ws__state > * { grid-area: 1 / 1; transition: opacity var(--dur-base); white-space: nowrap; }
  .ws__pre { color: var(--color-machine-text); opacity: 0; }
  .ws__fin { color: var(--color-human-text); display: inline-flex; align-items: center; gap: 4px; justify-self: end; }
  .ws__log { display: grid; gap: var(--space-3); }
  .ws__log li { display: grid; grid-template-columns: 0.5rem minmax(0, 1fr); gap: 4px var(--space-2); font-family: var(--ff-mono); font-size: 0.6875rem; line-height: 1.45; color: var(--color-text-muted); }
  .ws__dot { inline-size: 6px; block-size: 6px; border-radius: 50%; background: var(--color-machine-mark); margin-block-start: 5px; }
  .ws__bar2 { grid-column: 2; block-size: 2px; border-radius: 2px; background: color-mix(in oklab, var(--color-machine-mark) 18%, transparent); overflow: hidden; }
  .ws__bar2 i { display: block; block-size: 100%; background: var(--color-machine-mark); transform-origin: 0 50%; transition: transform 300ms var(--ease-standard); }
  :dir(rtl) .ws__bar2 i { transform-origin: 100% 50%; }
  .ws__sign { position: relative; display: grid; gap: 2px; margin-block-start: var(--space-2); padding: var(--space-4); border-radius: var(--radius-md); background: color-mix(in oklab, var(--color-human-mark) 9%, var(--color-surface)); border: 1px solid color-mix(in oklab, var(--color-human-mark) 35%, transparent); transition: opacity var(--dur-slow), translate var(--dur-slow) var(--ease-enter); }
  .ws__check { inline-size: 1.5rem; block-size: 1.5rem; border-radius: 50%; display: grid; place-items: center; background: var(--color-human-mark); color: var(--blue-975); margin-block-end: var(--space-2); }
  .ws__verdict { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-text); font-size: var(--text-sm); }
  .ws__by { color: var(--color-human-text); font-size: var(--text-xs); }
  .ws__quote { color: var(--color-text-muted); font-size: var(--text-xs); }
  /* One-time sequence (set by script; never present without JS or under reduced motion). */
  .ws[data-playing] .ws__pre { opacity: 1; } .ws[data-playing] .ws__fin { opacity: 0; }
  .ws[data-playing] .ws__bar2 i { transform: scaleX(0); }
  .ws[data-playing] .ws__sign { opacity: 0; translate: 0 8px; }
  .ws [data-done] .ws__pre { opacity: 0 !important; } .ws [data-done] .ws__fin { opacity: 1 !important; }
  .ws [data-done] .ws__bar2 i { transform: scaleX(1) !important; }
  .ws .ws__sign[data-done] { opacity: 1 !important; translate: 0 0 !important; }
</style>

<script>
  // 4 AI lines × 180ms, 5 rows × 220ms, sign-off at the end: ≈ 2.3s total (06 §9.6 cap 2.4s). Once, at 40% visible.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-ws]').forEach((ws) => {
    if (reduce || !('IntersectionObserver' in window)) return;
    ws.setAttribute('data-playing', '');
    const io = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      io.disconnect();
      let t = 150;
      ws.querySelectorAll<HTMLElement>('[data-ws-line]').forEach((el) => { t += 180; setTimeout(() => el.setAttribute('data-done', ''), t); });
      ws.querySelectorAll<HTMLElement>('[data-ws-row]').forEach((el) => { t += 220; setTimeout(() => el.setAttribute('data-done', ''), t); });
      const sign = ws.querySelector<HTMLElement>('[data-ws-sign]');
      setTimeout(() => sign?.setAttribute('data-done', ''), t + 250);
    }, { threshold: 0.4 });
    io.observe(ws);
  });
</script>
