---
// Selected work bento (03 §2A.8b, Oct 16): one featured case with its number, four smaller projects. Replaces the case
// block and the six-card grid on home. Each tile is one stretched link (case page, or /work for the rest).
import ProjectVisual from '../work/ProjectVisual.astro';
import { projects, showcase as c } from '../../content/copy/en/projects';
import { href, isLive } from '../../data/routes';
const fallback = ['health-app', 'support-agent'];
const tiles = [...c.ids, ...fallback].map((id) => projects.find((p) => p.id === id)).filter((p): p is NonNullable<typeof p> => Boolean(p)).slice(0, 5);
const [feat, ...rest] = tiles;
const target = (p: (typeof tiles)[number]) => (p.link && isLive(p.link) ? href(p.link) : href('work'));
const stageName = (s: keyof typeof c.stages) => c.stages[s];
---
<section id="selected-work" class="sc" data-surface="ink" aria-labelledby="sc-title">
  <div class="container">
    <div class="sc__head">
      <div>
        <p class="sc__label">{c.label}</p>
        <h2 id="sc-title" class="sc__title">{c.moreTitle}</h2>
      </div>
      {isLive('work') && <a class="sc__all" href={href('work')}>{c.allLink}<span class="icon--dir" aria-hidden="true"> →</span></a>}
    </div>
    <ul role="list" class="sc__bento">
      {feat && (
        <li class="sc__tile sc__tile--feat">
          <div class="sc__vis"><ProjectVisual project={feat} sizes="(min-width: 64rem) 45vw, 100vw" /></div>
          <div class="sc__body">
          <p class="sc__meta"><span class="sc__stage">{stageName(feat.stage)}</span>{feat.industry}{feat.where && ` · ${feat.where}`}</p>
          <h3 class="sc__h"><a href={target(feat)}>{feat.title}</a></h3>
          {feat.metric && <p class="sc__metric"><b>{feat.metric.value}</b><span>{feat.metric.label}</span></p>}
          {feat.result && <p class="sc__txt">{feat.result}</p>}
          {feat.link && <p class="sc__more" aria-hidden="true">{c.caseLink}<span class="icon--dir"> →</span></p>}
          </div>
        </li>
      )}
      {rest.map((p) => (
        <li class="sc__tile">
          <div class="sc__vis"><ProjectVisual project={p} sizes="(min-width: 64rem) 25vw, 100vw" /></div>
          <p class="sc__meta"><span class="sc__stage">{stageName(p.stage)}</span>{p.industry}{p.where && ` · ${p.where}`}</p>
          <h3 class="sc__h"><a href={target(p)}>{p.title}</a></h3>
          <p class="sc__txt">{p.result ?? p.did}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sc { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .sc__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-4); margin-block-end: var(--stack-lg); }
  .sc__label { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-sm); color: var(--color-machine-text); margin-block-end: var(--space-3); }
  .sc__title { font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem); font-weight: var(--weight-semibold); letter-spacing: -0.035em; line-height: 1.1; }
  .sc__all { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-link); }
  /* Bento: phones 1 column; tablets 2; desktop featured tile spans two rows beside a 2×2 of smaller tiles. */
  .sc__bento { display: grid; gap: var(--space-4); }
  @media (width >= 40rem) { .sc__bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } .sc__tile--feat { grid-column: 1 / -1; } }
  @media (width >= 72rem) { .sc__bento { grid-template-columns: minmax(0, 1.35fr) repeat(2, minmax(0, 1fr)); gap: var(--space-5); } .sc__tile--feat { grid-column: 1; grid-row: span 2; } }
  .sc__tile { position: relative; display: grid; gap: var(--space-2); align-content: start; padding: var(--space-4); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: var(--color-surface); transition: border-color var(--dur-base); }
  .sc__tile--feat { background: linear-gradient(160deg, color-mix(in oklab, var(--blue-700) 28%, var(--color-surface)), var(--color-surface) 60%); border-color: color-mix(in oklab, var(--blue-400) 40%, transparent); }
  .sc__vis { margin-block-end: var(--space-2); }
  .sc__body { display: grid; gap: var(--space-2); }
  /* Desktop: the featured drawing grows to fill the two-row height (no empty band). */
  @media (width >= 72rem) { .sc__tile--feat { grid-template-rows: minmax(0, 1fr) auto; } .sc__tile--feat .sc__vis { display: grid; align-items: center; border-radius: var(--radius-md); background: var(--blue-925); } }
  .sc__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .sc__stage { padding: 1px 7px; border-radius: var(--radius-xs, 4px); color: var(--blue-975); background: var(--blue-300); }
  .sc__h { font-family: var(--ff-heading); font-size: var(--text-lg); font-weight: var(--weight-bold); line-height: 1.3; color: var(--color-heading); text-wrap: balance; }
  .sc__tile--feat .sc__h { font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem); }
  .sc__h a { color: inherit; text-decoration: none; }
  .sc__h a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .sc__tile:has(a:focus-visible) { outline: var(--focus-width) solid var(--blue-300); outline-offset: var(--focus-offset); }
  .sc__h a:focus-visible { outline: none; }
  @media (hover: hover) { .sc__tile:hover { border-color: color-mix(in oklab, var(--blue-300) 45%, transparent); } }
  .sc__metric { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3); margin-block: var(--space-2); }
  .sc__metric b { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: clamp(2.75rem, 2rem + 2.4vw, 4rem); line-height: 1; letter-spacing: -0.045em; color: var(--color-heading); }
  .sc__metric span { color: var(--color-machine-text); }
  .sc__txt { font-size: 1rem; line-height: 1.55; color: var(--color-text-muted); }
  .sc__more { margin-block-start: var(--space-2); font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-link); }
</style>
