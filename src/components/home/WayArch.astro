---
// The DiscoverDev Way (03 §2A.4 v5 layout; 06 §0.8 A, the live thing): three moves scroll past a sticky arch.
// "Discover first" lays the footings, "Build with AI" the courses, "Seniors sign off" sets the keystone.
// CSS scroll-driven (a view timeline per move, shared through timeline-scope), zero JS. Without support, or with
// reduced motion, the finished arch shows. Below 56rem there is no sticky stage: each move carries a static glyph.
import Keystone from '../ui/Keystone.astro';
import CtaLink from '../ui/CtaLink.astro';
import { t } from '../../i18n/t';
import { bookHref } from '../../data/routes';
interface Move { title: string; does: string; get: string }
interface Panel { title: string; items: readonly string[] }
interface Props { label: string; title: string; body: string; moves: readonly Move[]; youGet: string; ai: Panel; human: Panel; line: string }
const { label, title, body, moves, youGet, ai, human, line } = Astro.props;
const lists = [undefined, ai, human] as const;
const check = 'M20 6 9 17l-5-5';
---
<section id="how-we-work" class="way" data-surface="ink" aria-labelledby="how-we-work-title">
  <div class="container">
    <header class="way__head">
      <p class="way__label">{label}</p>
      <h2 id="how-we-work-title" class="way__title">{title}</h2>
      <p class="way__body">{body}</p>
    </header>

    <div class="way__grid">
      <figure class="way__stage">
        <div class="way__arch"><Keystone id="way" count={9} courses={2} variant="build" ghost /></div>
        <figcaption class="way__line">{line}</figcaption>
      </figure>

      <ol role="list" class="way__moves">
        {moves.map((m, i) => (
          <li class:list={['way__move', `way__move--${i + 1}`]}>
            <div class="way__glyph"><Keystone id={`way-m${i + 1}`} count={9} courses={2} stage={i + 1} /></div>
            <h3 class="way__h3">
              {i === 2 && <span class="way__tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d={check} fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>}
              {m.title}
            </h3>
            <p class="way__does">{m.does}</p>
            <p class="way__get"><span class="way__get-label">{youGet}</span> {m.get}</p>
            {lists[i] && (
              <div class:list={['way__list', i === 1 ? 'way__list--ai' : 'way__list--human']}>
                <h4 class="way__list-title">{lists[i]!.title}</h4>
                <ul role="list">{lists[i]!.items.map((it) => <li>{it}</li>)}</ul>
              </div>
            )}
          </li>
        ))}
      </ol>
    </div>

    <p class="way__cta"><CtaLink href={bookHref('clarity')} ctaId="home_mid_clarity" tier="primary" position="mid" target="clarity">{t('cta.clarity')}</CtaLink></p>
  </div>
</section>

<style>
  .way { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); scroll-margin-block-start: var(--header-h); timeline-scope: --way-m1, --way-m2, --way-m3; }
  .way__head { display: grid; gap: var(--space-5); max-inline-size: 48rem; }
  .way__label { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-sm); color: var(--color-machine-text); }
  .way__title { font-size: clamp(2rem, 1.2rem + 3.2vw, 3.75rem); font-weight: var(--weight-bold); line-height: 1.04; letter-spacing: -0.04em; color: var(--color-heading); max-inline-size: 18ch; }
  .way__body { font-size: var(--text-lg); line-height: 1.6; color: var(--color-text-muted); max-inline-size: 42rem; text-wrap: pretty; }

  .way__grid { display: grid; gap: var(--space-10); margin-block-start: clamp(2.5rem, 1.5rem + 4vw, 5rem); }
  .way__stage { display: none; }
  .way__moves { display: grid; gap: var(--space-12); }
  .way__move { display: grid; gap: var(--space-3); align-content: start; padding-block-start: var(--space-6); border-block-start: 1px solid var(--color-hairline); }
  .way__glyph { inline-size: 5.5rem; margin-block-end: var(--space-2); }
  .way__h3 { display: flex; align-items: center; gap: var(--space-3); font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem); font-weight: var(--weight-bold); letter-spacing: -0.03em; color: var(--color-heading); }
  .way__tick { display: grid; place-items: center; inline-size: 1.75rem; block-size: 1.75rem; border-radius: 50%; background: var(--color-human-mark); color: var(--blue-975); flex: none; }
  .way__does { font-size: var(--text-lg); color: var(--color-text); max-inline-size: 34rem; }
  .way__get { color: var(--color-text-muted); max-inline-size: 34rem; }
  .way__get-label { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-machine-text); }
  .way__list { margin-block-start: var(--space-4); padding: var(--space-5) var(--space-6); background: var(--color-surface); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); max-inline-size: 34rem; }
  .way__list-title { font-size: var(--text-base); font-weight: var(--weight-bold); color: var(--color-heading); margin-block-end: var(--space-3); }
  .way__list li { display: flex; align-items: baseline; gap: var(--space-3); padding-block: var(--space-2); border-block-start: 1px solid var(--color-hairline); }
  .way__list li:first-child { border-block-start: 0; }
  .way__list li::before { content: ''; flex: none; inline-size: 8px; block-size: 8px; translate: 0 -1px; }
  .way__list--ai li::before { background: var(--color-machine-mark); }
  .way__list--human li::before { background: var(--color-human-mark); border-radius: 50%; }
  .way__line { margin-block-start: var(--space-6); font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-lg); letter-spacing: -0.015em; color: var(--color-human-text); text-align: center; text-wrap: balance; }
  .way__cta { margin-block-start: clamp(2.5rem, 1.5rem + 4vw, 4.5rem); }

  /* Wide screens: the sticky stage. Each move gets most of a screen so the arch builds as you read. */
  @media (width >= 56rem) {
    .way__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(3rem, 1rem + 5vw, 7rem); align-items: start; }
    .way__stage { display: block; position: sticky; inset-block-start: calc(var(--header-h) + 8vh); }
    .way__arch { inline-size: min(100%, 30rem); margin-inline: auto; }
    .way__glyph { display: none; }
    .way__moves { gap: 0; }
    .way__move { min-block-size: 62vh; align-content: center; padding-block: var(--space-12); }
    .way__move--1 { view-timeline-name: --way-m1; }
    .way__move--2 { view-timeline-name: --way-m2; }
    .way__move--3 { view-timeline-name: --way-m3; min-block-size: 56vh; }
  }

  @media (width >= 56rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (timeline-scope: --a) {
      .way__arch :global(.arch__c1) { animation: way-lay linear both; animation-timeline: --way-m1; animation-range: cover 15% cover 40%; }
      .way__arch :global(.arch__c2) { animation: way-lay linear both; animation-timeline: --way-m2; animation-range: cover 15% cover 40%; }
      .way__arch :global(.arch__c3) { animation: way-set linear both; animation-timeline: --way-m3; animation-range: cover 15% cover 38%; }
      .way__line { animation: way-show linear both; animation-timeline: --way-m3; animation-range: cover 30% cover 42%; }
      @keyframes way-lay { from { opacity: 0; translate: 0 -14px; } to { opacity: 1; translate: 0 0; } }
      @keyframes way-set { from { opacity: 0; translate: 0 -46px; } 50% { opacity: 1; } to { opacity: 1; translate: 0 0; } }
      @keyframes way-show { from { opacity: 0; } to { opacity: 1; } }
    }
  }
</style>
