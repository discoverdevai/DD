---
// Proof band under the hero (03 §2A.3): client cards OR project cards, never mixed.
// - 4+ clients with recorded consent (D-05, src/data/clients.ts) → client cards (logo in its own colours + name + one
//   line) in one slow moving row (Mohamed, Oct 16): two copies, the second aria-hidden, -50% loop; pauses on hover and
//   with a pause button (WCAG 2.2.2); reduced motion = still, wrapped.
// - Otherwise → four anonymized project cards (facts in 09).
// Then the §2.3 facts as a quiet row. Logos are read from assets/clients at build time and inlined as small WebP data
// URIs, only for consented entries, so an unconsented file never reaches dist. LOGO_MOCK=1 = local preview with all.
import path from 'node:path';
import sharp from 'sharp';
import Icon from '../ui/Icon.astro';
import { t } from '../../i18n/t';
import { clientLogos } from '../../data/clients';
interface Project { stage: string; href: string; what: string; where: string; proof: string }
interface Props {
  title: string; logosTitle: string; clientRoles: Record<string, string>; projects: readonly Project[];
  map: { label: string; regions: readonly string[] };
  items: readonly { icon: 'globe' | 'cpu' | 'languages' | 'map-pin'; text: string }[];
}
const { title, logosTitle, clientRoles, projects, items, map } = Astro.props;
// Facts map: equirectangular crop (lat 62..12, lon -125..60) on a 740x200 view box: x = (lon + 125) * 4, y = (62 - lat) * 4.
const P = (lat: number, lon: number) => ({ x: +((lon + 125) * 4).toFixed(1), y: +((62 - lat) * 4).toFixed(1) });
const clients = [P(37, -120), P(40.7, -74), P(52, -1), P(53, -8), P(40, -4), P(46.8, 8.2), P(42.5, 12.5), P(24.7, 46.7), P(29.4, 47.9)];
const homes = [P(31, -99), P(31.2, 29.9)];
const regionAt = [P(52, -112), P(60, 0), P(20, 15), P(36, 52)];

const MOCK = process.env.LOGO_MOCK === '1';
const MIN_LOGOS = 4;
const eligible = clientLogos.filter((l) => l.consent || MOCK);
const showLogos = eligible.length >= MIN_LOGOS;
const dir = path.join(process.cwd(), 'assets/clients');
const logos = showLogos
  ? await Promise.all(eligible.map(async (l) => {
      const buf = await sharp(path.join(dir, l.file))
        .resize(96, 96, { fit: l.fit === 'contain' ? 'contain' : 'cover', background: '#ffffff' })
        .webp({ quality: 75 })
        .toBuffer();
      return { ...l, src: `data:image/webp;base64,${buf.toString('base64')}` };
    }))
  : [];
---
<section class="pband" data-surface="ink" aria-labelledby="pband-title">
  <div class="container pband__head">
    <h2 id="pband-title" class="pband__label">{showLogos ? logosTitle : title}</h2>
    {showLogos && (
      <button type="button" class="pband__toggle" aria-pressed="false" aria-label={t('strip.pause')} data-pband-toggle hidden>
        <svg class="pband__i-pause" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none" /></svg>
        <svg class="pband__i-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
      </button>
    )}
  </div>

  {showLogos ? (
    <div class="pband__strip">
      <div class="pband__track">
        {[0, 1].map((copy) => (
          <ul role="list" class="pband__clients" aria-hidden={copy === 1 ? 'true' : undefined}>
            {logos.map((l) => (
              <li class="pband__client">
                <img src={l.src} alt="" width="44" height="44" loading="lazy" decoding="async" class:list={{ 'is-contain': l.fit === 'contain' }} />
                <p><strong>{l.name}</strong><span>{clientRoles[l.id]}</span></p>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  ) : (
    <div class="container">
      <ul role="list" class="pband__projects">
        {projects.map((p) => (
          <li class="pband__card">
            <p class="pband__stage">{p.stage}</p>
            <h3 class="pband__what"><a href={p.href}>{p.what}</a></h3>
            <p class="pband__proof">{p.proof}</p>
            <p class="pband__where"><Icon name="map-pin" size={16} />{p.where}</p>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="container pband__world">
    <ul role="list" class="pband__facts">
      {items.map((i) => <li><Icon name={i.icon} size={20} /><span>{i.text}</span></li>)}
    </ul>
    <svg class="pband__map" viewBox="0 0 740 200" role="img" aria-label={map.label}>
      <defs>
        <pattern id="pband-dots" width="10" height="10" patternUnits="userSpaceOnUse"><circle cx="5" cy="5" r="1.1" class="pband__dot" /></pattern>
        <linearGradient id="pband-arc" x1="0" x2="1"><stop offset="0" class="pband__stop-a" /><stop offset="1" class="pband__stop-b" /></linearGradient>
        <radialGradient id="pband-fade" cx="50%" cy="50%" r="60%"><stop offset="0.55" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></radialGradient>
        <mask id="pband-mask"><rect width="740" height="200" fill="url(#pband-fade)" /></mask>
      </defs>
      <rect width="740" height="200" fill="url(#pband-dots)" mask="url(#pband-mask)" />
      {map.regions.map((r, i) => <text x={regionAt[i].x} y={regionAt[i].y} class="pband__region">{r}</text>)}
      <path d={`M${homes[0].x} ${homes[0].y} Q ${(homes[0].x + homes[1].x) / 2} -20 ${homes[1].x} ${homes[1].y}`} class="pband__arc" pathLength="1" />
      {clients.map((c) => <circle cx={c.x} cy={c.y} r="4" class="pband__client-dot" />)}
      {homes.map((h) => (<g class="pband__home"><circle cx={h.x} cy={h.y} r="6" class="pband__home-ring" /><circle cx={h.x} cy={h.y} r="5" class="pband__home-dot" /></g>))}
    </svg>
  </div>
</section>

<style>
  .pband { border-block-start: 1px solid var(--color-hairline); /* bottom edge = next section's hairline */ padding-block: var(--space-12) var(--space-10); display: grid; gap: var(--space-6); }
  .pband__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .pband__label { font-family: var(--ff-heading); font-size: var(--text-sm); font-weight: var(--weight-bold); letter-spacing: 0.02em; color: var(--color-machine-text); }
  /* WCAG 2.2.2: the row moves on its own, so it gets a pause control (shown only when it moves and JS runs). */
  .pband__toggle { display: grid; place-items: center; inline-size: 2.25rem; block-size: 2.25rem; border-radius: 50%; border: 1px solid var(--color-hairline); background: transparent; color: var(--color-text); cursor: pointer; }
  .pband__toggle[hidden] { display: none; }
  .pband__toggle .pband__i-play, .pband__toggle[aria-pressed='true'] .pband__i-pause { display: none; }
  .pband__toggle[aria-pressed='true'] .pband__i-play { display: block; }
  @media (hover: hover) { .pband__toggle:hover { background: color-mix(in oklab, var(--blue-300) 10%, transparent); } }

  /* Client cards in one moving row; edges fade out. */
  .pband__strip { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .pband__track { display: flex; inline-size: max-content; }
  .pband__clients { display: flex; gap: var(--space-3); padding-inline-end: var(--space-3); }
  .pband__client { flex: none; display: flex; align-items: center; gap: var(--space-3); inline-size: 19.5rem; padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--color-hairline); background: color-mix(in oklab, var(--blue-300) 4%, transparent); }
  .pband__client img { flex: none; inline-size: 2.75rem; block-size: 2.75rem; border-radius: 50%; object-fit: cover; background: var(--neutral-0); }
  .pband__client img.is-contain { object-fit: contain; padding: 3px; }
  .pband__client p { display: grid; min-inline-size: 0; }
  .pband__client strong { font-family: var(--ff-heading); font-size: var(--text-sm); color: var(--color-heading); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pband__client span { font-size: var(--text-xs); color: var(--color-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (prefers-reduced-motion: no-preference) {
    .pband__track { animation: pband-scroll 55s linear infinite; }
    :dir(rtl) .pband__track { animation-name: pband-scroll-rtl; }
    .pband__strip:hover .pband__track, .pband[data-paused] .pband__track { animation-play-state: paused; }
    @keyframes pband-scroll { to { transform: translateX(-50%); } }
    @keyframes pband-scroll-rtl { to { transform: translateX(50%); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .pband__toggle { display: none !important; }
    .pband__strip { mask-image: none; }
    .pband__track { inline-size: auto; padding-inline: var(--gutter); }
    .pband__clients { flex-wrap: wrap; justify-content: center; padding-inline-end: 0; }
    .pband__clients[aria-hidden] { display: none; }
  }

  /* Projects (fallback): four equal cards; the title link covers the card (one link, one tab stop). */
  .pband__projects { display: grid; gap: var(--space-4); }
  @media (width >= 40rem) { .pband__projects { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (width >= 64rem) { .pband__projects { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .pband__card { position: relative; display: grid; grid-template-rows: auto auto 1fr auto; gap: var(--space-2); padding: var(--space-5); border-radius: var(--radius-md); border: 1px solid var(--color-hairline); background: color-mix(in oklab, var(--blue-300) 4%, transparent); transition: border-color var(--dur-base), background-color var(--dur-base); }
  .pband__stage { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .pband__what { font-family: var(--ff-heading); font-size: var(--text-base); font-weight: var(--weight-bold); line-height: 1.35; color: var(--color-heading); text-wrap: balance; }
  .pband__what a { color: inherit; text-decoration: none; }
  .pband__what a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .pband__card:has(a:focus-visible) { outline: var(--focus-width) solid var(--blue-300); outline-offset: var(--focus-offset); }
  .pband__what a:focus-visible { outline: none; }
  @media (hover: hover) { .pband__card:hover { border-color: color-mix(in oklab, var(--blue-300) 40%, transparent); background: color-mix(in oklab, var(--blue-300) 8%, transparent); } }
  .pband__proof { font-size: var(--text-sm); line-height: 1.5; color: var(--color-text-muted); }
  .pband__where { display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-xs); color: var(--color-text-muted); }
  .pband__where :global(.icon) { color: var(--color-machine-text); }

  /* Facts + map: facts list beside an abstract dot-grid map in brand colours (03 §2A.3). */
  .pband__world { display: grid; gap: var(--space-6); align-items: center; padding-block-start: var(--space-6); border-block-start: 1px solid var(--color-hairline); }
  @media (width >= 64rem) { .pband__world { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-10); } }
  .pband__facts { display: grid; gap: var(--space-4); }
  @media (width >= 48rem) and (width < 64rem) { .pband__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .pband__map { inline-size: 100%; block-size: auto; overflow: visible; }
  .pband__dot { fill: color-mix(in oklab, var(--blue-300) 34%, transparent); }
  .pband__region { font-family: var(--ff-mono); font-size: 11px; letter-spacing: 0.04em; fill: var(--color-text-muted); text-anchor: middle; }
  .pband__stop-a { stop-color: var(--blue-400); } .pband__stop-b { stop-color: var(--color-human-mark); }
  .pband__arc { fill: none; stroke: url(#pband-arc); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 0.01 0.012; }
  @media (width < 48rem) { .pband__region { font-size: 20px; } }
  .pband__client-dot { fill: var(--blue-400); stroke: var(--color-bg); stroke-width: 2; }
  .pband__home-dot { fill: var(--color-human-mark); stroke: var(--color-bg); stroke-width: 2; }
  .pband__home-ring { fill: none; stroke: var(--color-human-mark); stroke-width: 1.5; opacity: 0; transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .pband__home-ring { animation: pband-ping 2.8s var(--ease-standard) infinite; }
    .pband__home:nth-of-type(2) .pband__home-ring { animation-delay: 1.4s; }
    @keyframes pband-ping { from { transform: scale(1); opacity: 0.8; } to { transform: scale(3.2); opacity: 0; } }
  }
  @media (forced-colors: active) { .pband__dot { fill: GrayText; } .pband__client-dot, .pband__home-dot { fill: CanvasText; } .pband__arc { stroke: CanvasText; } }
  .pband__facts li { display: flex; align-items: center; gap: var(--space-3); padding-inline-start: var(--space-5); border-inline-start: 1px solid var(--color-hairline); color: var(--color-text-muted); font-size: var(--text-sm); font-weight: var(--weight-medium); }
  .pband__facts :global(.icon) { color: var(--color-machine-text); flex: none; }
</style>

<script>
  // Pause control for the moving client row (WCAG 2.2.2). Hidden without JS; the row still pauses on hover.
  document.querySelectorAll<HTMLButtonElement>('[data-pband-toggle]').forEach((btn) => {
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const paused = btn.closest('.pband')?.toggleAttribute('data-paused') ?? false;
      btn.setAttribute('aria-pressed', String(paused));
    });
  });
</script>
