---
// "Not at launch yet?" (03 §2.7): four tall tiles, one link each (stretched), with a mono index and a glyph per path.
import { ROUTES, isLive, type RouteKey } from '../../data/routes';
interface Card { key: RouteKey; who: string; title: string; body: string; linkLabel: string }
interface Props { title: string; cards: readonly Card[] }
const { title, cards } = Astro.props;
const live = cards.filter((c) => isLive(c.key));
---
{live.length > 0 && (
  <section id="paths" class="pt" data-surface="ink" aria-labelledby="pt-title">
    <div class="container">
      <h2 id="pt-title" class="pt__title reveal">{title}</h2>
      <ul role="list" class="pt__grid reveal-stagger">
        {live.map((c, i) => (
          <li class="pt__tile" data-spotlight>
            <span class="pt__idx" aria-hidden="true">0{i + 1}</span>
            <span class:list={['pt__glyph', `pt__glyph--${i}`]} aria-hidden="true"><i></i><i></i><i></i></span>
            <p class="pt__who">{c.who}</p>
            <h3 class="pt__h3"><a href={ROUTES[c.key].path} data-cta-id={`home_card_${c.key}`} data-cta-tier="secondary" data-cta-position="card" data-cta-target={c.key}>{c.title}<span class="sr-only">: {c.linkLabel}</span></a></h3>
            <p class="pt__body">{c.body}</p>
            <p class="pt__more" aria-hidden="true">{c.linkLabel}<span class="pt__arrow icon--dir">→</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .pt { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .pt__title { font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem); font-weight: var(--weight-semibold); letter-spacing: -0.035em; margin-block-end: var(--stack-lg); max-inline-size: 20ch; }
  .pt__grid { display: grid; gap: var(--space-4); }
  @media (width >= 40rem) { .pt__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (width >= 64rem) { .pt__grid { grid-template-columns: repeat(4, 1fr); } }
  .pt__tile { position: relative; display: grid; gap: var(--space-3); align-content: start; min-block-size: 20rem; padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: linear-gradient(180deg, color-mix(in oklab, var(--color-surface) 90%, var(--blue-800)), color-mix(in oklab, var(--color-surface) 40%, transparent)); transition: border-color var(--dur-color), background-color var(--dur-color); }
  .pt__idx { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .pt__glyph { display: flex; gap: 6px; block-size: 4rem; align-items: end; margin-block: var(--space-2) var(--space-4); }
  .pt__glyph i { display: block; inline-size: 14px; border-radius: 3px; background: color-mix(in oklab, var(--blue-300) 30%, transparent); }
  .pt__glyph--0 i:nth-child(1) { block-size: 30%; } .pt__glyph--0 i:nth-child(2) { block-size: 55%; background: var(--blue-700); } .pt__glyph--0 i:nth-child(3) { block-size: 20%; }
  .pt__glyph--1 i:nth-child(1) { block-size: 45%; } .pt__glyph--1 i:nth-child(2) { block-size: 70%; } .pt__glyph--1 i:nth-child(3) { block-size: 100%; background: var(--blue-700); }
  .pt__glyph--2 i { block-size: 80%; } .pt__glyph--2 i:nth-child(2) { background: var(--blue-700); } .pt__glyph--2 i:nth-child(3) { block-size: 95%; }
  .pt__glyph--3 i:nth-child(1) { block-size: 60%; background: var(--blue-700); } .pt__glyph--3 i:nth-child(2) { block-size: 60%; } .pt__glyph--3 i:nth-child(3) { block-size: 60%; }
  .pt__who { font-size: var(--text-sm); color: var(--color-machine-text); font-family: var(--ff-mono); }
  .pt__h3 { font-size: var(--text-xl); font-weight: var(--weight-semibold); letter-spacing: -0.02em; }
  .pt__h3 a { color: var(--color-heading); text-decoration: none; }
  .pt__h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; z-index: var(--z-raised); }
  .pt__h3 a:focus-visible { outline: none; }
  .pt__tile:has(a:focus-visible) { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-offset); }
  .pt__body { color: var(--color-text-muted); }
  .pt__more { margin-block-start: auto; padding-block-start: var(--space-4); display: inline-flex; gap: var(--space-2); color: var(--color-link); font-weight: var(--weight-medium); }
  @media (hover: hover) { .pt__tile:hover { border-color: color-mix(in oklab, var(--blue-300) 45%, transparent); } }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) { .pt__arrow { transition: translate var(--dur-base) var(--ease-standard); } .pt__tile:hover .pt__arrow { translate: 4px 0; } :dir(rtl) .pt__tile:hover .pt__arrow { translate: -4px 0; } }
</style>
