---
// FAQ (03 §2.12) in a two-column layout: sticky heading + help line at inline-start, accordion at inline-end.
import Faq from '../ui/Faq.astro';
import { t } from '../../i18n/t';
interface Props { title: string; items: readonly { id: string; q: string; a: string }[] }
const { title, items } = Astro.props;
---
<section id="faq" class="fs" data-surface="ink" aria-labelledby="fs-title">
  <div class="container fs__grid">
    <div class="fs__head">
      <h2 id="fs-title" class="fs__title">{title}</h2>
      <p class="fs__help">{t('contact.email.label')}: <a href={`mailto:${t('contact.email')}`} dir="ltr" data-link-context="contact">{t('contact.email')}</a></p>
    </div>
    <Faq items={items} />
  </div>
</section>

<style>
  .fs { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .fs__grid { display: grid; gap: var(--space-10); }
  @media (width >= 64rem) { .fs__grid { grid-template-columns: 4fr 7fr; gap: var(--space-16); align-items: start; } .fs__head { position: sticky; inset-block-start: calc(var(--header-h) + var(--space-8)); } }
  .fs__head { display: grid; gap: var(--space-4); }
  .fs__title { font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem); font-weight: var(--weight-semibold); letter-spacing: -0.035em; line-height: 1.1; }
  .fs__help { color: var(--color-text-muted); }
  .fs__grid :global(.faq) { max-inline-size: none; }
</style>
