---
// FAQ (03 §2.12) in a two-column layout: sticky heading + help line at inline-start, accordion at inline-end.
import Faq from '../ui/Faq.astro';
import CtaLink from '../ui/CtaLink.astro';
import { bookHref } from '../../data/routes';
import { t } from '../../i18n/t';
import type { RouteKey } from '../../data/routes';
// `ctaPage`: adds a clarity-call button under the heading (fills the column beside the questions; Oct 16 review).
interface Props { surface?: 'ink' | 'paper'; ctaPage?: string; title: string; items: readonly { id: string; q: string; a: string; link?: { label: string; to: RouteKey } }[] }
const { title, items, surface = 'ink', ctaPage } = Astro.props;
---
<section id="faq" class:list={['fs', { 'fs--paper': surface === 'paper' }]} data-surface={surface} aria-labelledby="fs-title">
  <div class="container fs__grid">
    <div class="fs__head">
      <h2 id="fs-title" class="fs__title">{title}</h2>
      {ctaPage && <p><CtaLink href={bookHref('clarity')} ctaId={`${ctaPage}_faq_clarity`} tier="primary" position="faq" target="clarity">{t('cta.clarity')}</CtaLink></p>}
      <p class="fs__help">{t('contact.email.label')}: <a href={`mailto:${t('contact.email')}`} dir="ltr" data-link-context="contact">{t('contact.email')}</a></p>
    </div>
    <Faq items={items} />
  </div>
</section>

<style>
  .fs { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .fs__grid { display: grid; gap: var(--space-10); }
  @media (width >= 64rem) { .fs__grid { grid-template-columns: 4fr 7fr; gap: var(--space-16); align-items: start; } .fs__head { position: sticky; inset-block-start: calc(var(--header-h) + var(--space-8)); } }
  .fs__head { display: grid; gap: var(--space-4); }
  .fs--paper { border-block-start: 1px solid var(--color-border-subtle); }
  .fs--paper .fs__title { color: var(--neutral-950); font-weight: var(--weight-bold); letter-spacing: -0.03em; }
  .fs__title { font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem); font-weight: var(--weight-semibold); letter-spacing: -0.035em; line-height: 1.1; }
  .fs__help { color: var(--color-text-muted); }
  .fs__grid :global(.faq) { max-inline-size: none; }
</style>
