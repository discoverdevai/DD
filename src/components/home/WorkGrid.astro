---
// Selected work (03 §2A.8b, Oct 16): six anonymized project cards (facts in 09; case names still need consent), each a
// single stretched link to its case or service page, plus "See all our work". 1 / 2 / 3 columns.
import Icon from '../ui/Icon.astro';
import { href, isLive } from '../../data/routes';
interface Item { stage: string; href: string; what: string; where: string; proof: string }
interface Props { label: string; title: string; allLink: string; items: readonly Item[] }
const { label, title, allLink, items } = Astro.props;
---
<section id="selected-work" class="wg" data-surface="ink" aria-labelledby="wg-title">
  <div class="container">
    <div class="wg__head">
      <div>
        <p class="wg__label">{label}</p>
        <h2 id="wg-title" class="wg__title">{title}</h2>
      </div>
      {isLive('work') && <a class="wg__all" href={href('work')}>{allLink}<span class="icon--dir" aria-hidden="true"> →</span></a>}
    </div>
    <ul role="list" class="wg__grid">
      {items.map((p) => (
        <li class="wg__card">
          <p class="wg__stage">{p.stage}</p>
          <h3 class="wg__what"><a href={p.href}>{p.what}</a></h3>
          <p class="wg__proof">{p.proof}</p>
          {p.where && <p class="wg__where"><Icon name="map-pin" size={16} />{p.where}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .wg { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .wg__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-4); margin-block-end: var(--stack-lg); }
  .wg__label { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-sm); color: var(--color-machine-text); margin-block-end: var(--space-3); }
  .wg__title { font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem); font-weight: var(--weight-semibold); letter-spacing: -0.035em; line-height: 1.1; max-inline-size: 22ch; }
  .wg__all { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-link); }
  .wg__grid { display: grid; gap: var(--space-4); }
  @media (width >= 40rem) { .wg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (width >= 64rem) { .wg__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .wg__card { position: relative; display: grid; grid-template-rows: auto auto 1fr auto; gap: var(--space-2); padding: var(--space-5); border-radius: var(--radius-md); border: 1px solid var(--color-hairline); background: color-mix(in oklab, var(--blue-300) 4%, transparent); transition: border-color var(--dur-base), background-color var(--dur-base); }
  .wg__stage { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .wg__what { font-family: var(--ff-heading); font-size: var(--text-lg); font-weight: var(--weight-bold); line-height: 1.3; color: var(--color-heading); text-wrap: balance; }
  .wg__what a { color: inherit; text-decoration: none; }
  .wg__what a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .wg__card:has(a:focus-visible) { outline: var(--focus-width) solid var(--blue-300); outline-offset: var(--focus-offset); }
  .wg__what a:focus-visible { outline: none; }
  @media (hover: hover) { .wg__card:hover { border-color: color-mix(in oklab, var(--blue-300) 40%, transparent); background: color-mix(in oklab, var(--blue-300) 8%, transparent); } }
  .wg__proof { font-size: 1rem; line-height: 1.55; color: var(--color-text-muted); }
  .wg__where { display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-xs); color: var(--color-text-muted); }
  .wg__where :global(.icon) { color: var(--color-machine-text); }
</style>
