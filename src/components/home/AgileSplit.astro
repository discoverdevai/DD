---
// DiscoverDev Way explainer (03 §2A.4), slotted under the Statement: the body, the journey visual (default slot) and the
// responsibility line. The "What AI does / What senior engineers own" panels were removed Oct 16 (batch 2): the hero
// board and the journey already say it.
// The closing line was dropped Oct 16 (it repeated the hero pill); `line` stays optional for reuse.
interface Props { body: string; line?: string }
const { body, line } = Astro.props;
---
<div class="ag">
  <p class="ag__body">{body}</p>
  <slot />
  {line && <p class="ag__line">{line}</p>}
</div>

<style>
  .ag { display: grid; gap: var(--stack-lg); margin-block-start: var(--space-8); }
  .ag__body { max-inline-size: 44rem; font-size: var(--text-lg); line-height: 1.6; color: var(--color-text-muted); text-wrap: pretty; }
  .ag__line { display: flex; align-items: baseline; gap: var(--space-3); font-family: var(--ff-mono); font-size: var(--text-sm); color: var(--color-human-text); }
  .ag__line::before { content: ''; inline-size: 8px; block-size: 8px; border-radius: 50%; translate: 0 -1px; background: var(--color-human-mark); box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-human-mark) 20%, transparent); flex: none; }
</style>
