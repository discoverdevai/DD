---
// Case highlight (03 §2A.8, anonymized per §0.7): metric card beside the story, then the five changes from the case
// study as one row underneath (Oct 16 review: the sticky card left empty space; each change now says what we did).
import CtaLink from '../ui/CtaLink.astro';
import { href, isLive } from '../../data/routes';
interface Props { c: { eyebrow: string; results: readonly string[]; levers: readonly { title: string; line: string }[]; title: string; body: string; metric: string; metricLabel: string; stack: readonly string[]; link: string; allLink: string } }
const { c } = Astro.props;
---
<section id="case" class="cm" data-surface="ink" aria-labelledby="cm-title">
  <div class="container">
    <div class="cm__grid">
      <div class="cm__metric reveal" data-spotlight>
        <p class="cm__num">{c.metric}</p>
        <p class="cm__label">{c.metricLabel}</p>
        <ul role="list" class="cm__results">{c.results.map((r) => <li>{r}</li>)}</ul>
        <ul role="list" class="cm__stack">{c.stack.map((s) => <li>{s}</li>)}</ul>
      </div>
      <div class="cm__copy">
        <p class="cm__eyebrow">{c.eyebrow}</p>
        <h2 id="cm-title" class="cm__title">{c.title}</h2>
        <p class="cm__body">{c.body}</p>
        <p class="cm__links">
          {isLive('workEdulens') && <CtaLink href={href('workEdulens')} ctaId="home_mid_case" tier="secondary" position="mid" target="case" variant="text">{c.link}</CtaLink>}
          {isLive('work') && <a href={href('work')} class="cm__all">{c.allLink}</a>}
        </p>
      </div>
    </div>
    <ol role="list" class="cm__levers reveal-stagger">
      {c.levers.map((l) => <li><strong>{l.title}</strong><span class="cm__lline">{l.line}</span></li>)}
    </ol>
  </div>
</section>

<style>
  .cm { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .cm__grid { display: grid; gap: var(--space-10); }
  @media (width >= 64rem) { .cm__grid { grid-template-columns: 5fr 7fr; gap: var(--space-16); align-items: stretch; } }
  .cm__metric { position: relative; display: flex; flex-direction: column; padding: clamp(var(--space-6), 1rem + 3vw, var(--space-10)) clamp(var(--space-5), 1rem + 2vw, var(--space-8)); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: radial-gradient(90% 90% at 20% 0%, color-mix(in oklab, var(--blue-700) 40%, transparent), transparent 70%), var(--color-surface); overflow: hidden; }
  .cm__num { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: clamp(3.25rem, 2rem + 4.6vw, 6rem); line-height: 0.95; white-space: nowrap; letter-spacing: -0.05em; color: var(--color-heading); font-variant-numeric: tabular-nums; }
  .cm__label { font-size: var(--text-lg); color: var(--color-text-muted); margin-block-start: var(--space-3); }
  .cm__results { display: grid; gap: var(--space-3); margin-block-start: var(--space-6); padding-block-start: var(--space-6); border-block-start: 1px solid var(--color-hairline); }
  .cm__results li { display: flex; align-items: baseline; gap: var(--space-3); color: var(--color-text); }
  .cm__results li::before { content: ''; flex: none; inline-size: 8px; block-size: 8px; border-radius: 50%; background: var(--color-human-mark); translate: 0 -1px; }
  .cm__stack { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-block-start: auto; padding-block-start: var(--space-6); }
  .cm__stack li { font-family: var(--ff-mono); font-size: var(--text-xs); padding: 3px 9px; border-radius: var(--radius-pill); border: 1px solid var(--color-hairline); color: var(--color-text-muted); }
  .cm__copy { display: grid; gap: var(--space-5); align-content: center; justify-items: start; }
  .cm__eyebrow { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .cm__title { font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem); font-weight: var(--weight-semibold); letter-spacing: -0.035em; line-height: 1.1; }
  .cm__body { color: var(--color-text-muted); font-size: var(--text-lg); line-height: 1.55; }
  .cm__links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-6); }
  .cm__all { color: var(--color-text-muted); }
  /* The five changes: a list on phones, one row of five on desktop, each with a blue rule on top. */
  .cm__levers { display: grid; gap: var(--space-5); margin-block-start: var(--space-10); }
  @media (width >= 40rem) { .cm__levers { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (width >= 64rem) { .cm__levers { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .cm__levers li { display: grid; gap: var(--space-2); align-content: start; padding-block-start: var(--space-4); border-block-start: 2px solid var(--color-machine-mark); }
  .cm__levers strong { font-weight: var(--weight-semibold); color: var(--color-heading); }
  .cm__lline { font-size: var(--text-sm); line-height: 1.5; color: var(--color-text-muted); }
</style>
