---
// Case highlight (03 §2.8, anonymized per §0.7): a big verified metric plus the five levers from the case study as a pipeline.
import CtaLink from '../ui/CtaLink.astro';
import { caseStudy } from '../../content/copy/en/work';
import { href, isLive } from '../../data/routes';
interface Props { c: { title: string; body: string; metric: string; metricLabel: string; stack: readonly string[]; link: string; allLink: string } }
const { c } = Astro.props;
const levers = caseStudy.approach.items.map((i) => i.title);
---
<section id="case" class="cm" data-surface="ink" aria-labelledby="cm-title">
  <div class="container cm__grid">
    <div class="cm__metric reveal" data-spotlight>
      <p class="cm__num">{c.metric}</p>
      <p class="cm__label">{c.metricLabel}</p>
      <ul role="list" class="cm__stack">{c.stack.map((s) => <li>{s}</li>)}</ul>
    </div>
    <div class="cm__copy">
      <h2 id="cm-title" class="cm__title">{c.title}</h2>
      <p class="cm__body">{c.body}</p>
      <ol role="list" class="cm__levers reveal-stagger">
        {levers.map((l, i) => <li><span class="cm__lnum">0{i + 1}</span>{l}</li>)}
      </ol>
      <p class="cm__links">
        {isLive('workEdulens') && <CtaLink href={href('workEdulens')} ctaId="home_mid_case" tier="secondary" position="mid" target="case" variant="text">{c.link}</CtaLink>}
        {isLive('work') && <a href={href('work')} class="cm__all">{c.allLink}</a>}
      </p>
    </div>
  </div>
</section>

<style>
  .cm { padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline); }
  .cm__grid { display: grid; gap: var(--space-10); align-items: start; }
  /* Desktop: the metric card tops out with the headline and stays in view while the levers scroll past. */
  @media (width >= 64rem) { .cm__grid { grid-template-columns: 5fr 7fr; gap: var(--space-16); } .cm__metric { position: sticky; inset-block-start: calc(var(--header-h) + var(--space-8)); } }
  .cm__metric { position: relative; padding: clamp(var(--space-6), 1rem + 3vw, var(--space-10)) clamp(var(--space-5), 1rem + 2vw, var(--space-8)); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); background: radial-gradient(90% 90% at 20% 0%, color-mix(in oklab, var(--blue-700) 40%, transparent), transparent 70%), var(--color-surface); overflow: hidden; }
  .cm__num { font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: clamp(3.25rem, 2rem + 4.6vw, 6rem); line-height: 0.95; white-space: nowrap; letter-spacing: -0.05em; color: var(--color-heading); font-variant-numeric: tabular-nums; }
  .cm__label { font-size: var(--text-lg); color: var(--color-text-muted); margin-block-start: var(--space-3); }
  .cm__stack { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-block-start: clamp(var(--space-5), 1rem + 2vw, var(--space-8)); }
  .cm__stack li { font-family: var(--ff-mono); font-size: var(--text-xs); padding: 3px 9px; border-radius: var(--radius-pill); border: 1px solid var(--color-hairline); color: var(--color-text-muted); }
  .cm__copy { display: grid; gap: var(--space-5); justify-items: start; }
  .cm__title { font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem); font-weight: var(--weight-semibold); letter-spacing: -0.035em; line-height: 1.1; }
  .cm__body { color: var(--color-text-muted); font-size: var(--text-lg); line-height: 1.55; }
  .cm__levers { display: grid; inline-size: 100%; border-block-start: 1px solid var(--color-hairline); }
  .cm__levers li { display: flex; align-items: baseline; gap: var(--space-4); padding-block: var(--space-3); border-block-end: 1px solid var(--color-hairline); font-weight: var(--weight-medium); }
  .cm__links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-6); }
  .cm__all { color: var(--color-text-muted); }
  .cm__lnum { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
</style>
