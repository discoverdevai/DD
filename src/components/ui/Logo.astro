---
// Official horizontal logo (assets/logo/svg, from the brand guidelines asset kit; D-33 resolved). Brand rules: whole
// logo only, never recoloured; on dark ink use the "for dark" version (white "Discover", blue gradient mark and "Dev");
// on white use the dark-text version; min 120 px wide. Decorative here: the link around it carries the name.
// `lazy` for copies below the fold (footer, mobile menu); the header copy loads eagerly.
interface Props { tone?: 'for-dark' | 'dark-text'; lazy?: boolean; class?: string }
const { tone = 'for-dark', lazy = false, class: cls } = Astro.props;
const src = tone === 'for-dark' ? '/brand/logo-horizontal-for-dark.svg' : '/brand/logo-horizontal-dark-text.svg';
---
<img class:list={['logo', cls]} src={src} alt="" width="825" height="175" decoding="async" loading={lazy ? 'lazy' : 'eager'} />

<style>
  /* viewBox 825×175 → height drives width; 30px tall = 141px wide (above the 120px minimum). */
  .logo { display: block; block-size: 1.875rem; inline-size: auto; }
  @media (width >= 64rem) { .logo { block-size: 2.125rem; } }
  @media (forced-colors: active) { .logo { forced-color-adjust: none; } }
</style>
