---
// Horizontal lockup (06 §9.24, §11). INTERIM: masks cut from the official PNG until the SVG set lands (D-33).
// Colour comes from the surface: colour on paper, reversed (mark + "Dev" blue-300, "Discover" white) on ink, navy and footer.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<span class:list={['logo', cls]} aria-hidden="true">
  <span class="logo__mark"></span>
  <span class="logo__discover"></span>
  <span class="logo__dev"></span>
</span>

<style>
  .logo { --logo-h: 1.5rem; display: inline-flex; align-items: center; gap: calc(var(--logo-h) * 0.3); block-size: var(--logo-h); }
  @media (width >= 40rem) { .logo { --logo-h: 1.75rem; } }
  @media (width >= 64rem) { .logo { --logo-h: 2rem; } }
  .logo > span { display: block; block-size: 100%; background: var(--logo-word, var(--neutral-950)); mask-repeat: no-repeat; mask-position: center; mask-size: contain; }
  .logo__mark { aspect-ratio: 90 / 96; background: var(--logo-accent, var(--blue-700)) !important; mask-image: url('/brand/mark.png'); }
  .logo__discover { block-size: 66% !important; aspect-ratio: 314 / 72; mask-image: url('/brand/wordmark-discover.png'); }
  .logo__dev { block-size: 66% !important; aspect-ratio: 150 / 72; margin-inline-start: calc(var(--logo-h) * -0.3); background: var(--logo-accent, var(--blue-700)) !important; mask-image: url('/brand/wordmark-dev.png'); }
  :global([data-surface='ink']) .logo, :global([data-surface='inverse']) .logo, :global([data-surface='footer']) .logo { --logo-word: var(--neutral-0); --logo-accent: var(--blue-300); }
  @media (forced-colors: active) { .logo > span { background: CanvasText !important; } }
</style>
