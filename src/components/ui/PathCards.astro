---
// Path cards (06 §9.8): one link per card (the title), stretched over the card. Only live destinations render.
import { ROUTES, isLive, type RouteKey } from '../../data/routes';
interface Card { key: RouteKey; who: string; title: string; body: string; linkLabel: string }
interface Props { cards: readonly Card[]; page: string }
const { cards, page } = Astro.props;
const live = cards.filter((c) => isLive(c.key));
const target = (k: RouteKey) => (['validate', 'build', 'scale', 'partners'].includes(k) ? k : 'case');
---
{live.length > 0 && (
  <ul role="list" class:list={['paths', `paths--${Math.min(live.length, 4)}`]}>
    {live.map((c) => (
      <li class="path">
        <p class="path__who">{c.who}</p>
        <h3 class="h3 path__title">
          <a href={ROUTES[c.key].path} data-cta-id={`${page}_card_${target(c.key)}`} data-cta-tier="secondary" data-cta-position="card" data-cta-target={target(c.key)}>{c.title}<span class="sr-only">: {c.linkLabel}</span></a>
        </h3>
        <p class="path__body">{c.body}</p>
        <p class="path__more" aria-hidden="true">{c.linkLabel}</p>
      </li>
    ))}
  </ul>
)}

<style>
  .paths { display: grid; gap: var(--grid-gap); }
  @media (width >= 40rem) { .paths { grid-template-columns: repeat(2, 1fr); } }
  @media (width >= 64rem) { .paths--4 { grid-template-columns: repeat(4, 1fr); } .paths--3 { grid-template-columns: repeat(3, 1fr); } }
  .path { position: relative; display: grid; gap: var(--space-3); align-content: start; padding: var(--space-6); background: var(--color-surface); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-md); transition: border-color var(--dur-color); }
  .path__who { font-size: var(--text-sm); color: var(--color-text-muted); }
  .path__title a { color: var(--color-heading); text-decoration: none; }
  .path__title a::after { content: ''; position: absolute; inset: 0; z-index: var(--z-raised); border-radius: inherit; }
  .path__title a:focus-visible { outline: none; }
  .path:has(a:focus-visible) { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-offset); }
  .path__body { color: var(--color-text-muted); }
  .path__more { font-weight: var(--weight-medium); color: var(--color-link); text-decoration: underline; text-underline-offset: 0.2em; }
  @media (hover: hover) { .path:hover { border-color: var(--color-border-interactive); } .path:hover .path__more { text-decoration-thickness: 2px; } }
  .path:active { border-width: 2px; }
</style>
