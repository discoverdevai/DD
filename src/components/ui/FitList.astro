---
// "Who it's for / not for" (04 §4.3 #2). Two columns from 48rem. Not-for items may link to the better path (live routes only).
import Icon from './Icon.astro';
import { ROUTES, isLive, type RouteKey } from '../../data/routes';
interface NotFor { text: string; link?: { label: string; to: RouteKey } }
interface Props { forTitle: string; forItems: readonly string[]; notTitle: string; notItems: readonly NotFor[] }
const { forTitle, forItems, notTitle, notItems } = Astro.props;
---
<div class="fit">
  <div class="fit__col">
    <h3 class="h3 fit__h">{forTitle}</h3>
    <ul role="list">{forItems.map((i) => <li><Icon name="check" size={20} class="fit__yes" /><span>{i}</span></li>)}</ul>
  </div>
  <div class="fit__col">
    <h3 class="h3 fit__h">{notTitle}</h3>
    <ul role="list">
      {notItems.map((i) => (
        <li><Icon name="x" size={20} class="fit__no" /><span>{i.text}{i.link && isLive(i.link.to) && <> <a href={ROUTES[i.link.to].path}>{i.link.label}</a></>}</span></li>
      ))}
    </ul>
  </div>
</div>

<style>
  .fit { display: grid; gap: var(--space-10); }
  @media (width >= 48rem) { .fit { grid-template-columns: 1fr 1fr; gap: var(--space-16); } }
  .fit__col { display: grid; gap: var(--space-4); align-content: start; }
  .fit__h { font-size: var(--text-lg); }
  .fit ul { display: grid; gap: var(--space-3); }
  .fit li { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: var(--space-3); }
  .fit :global(.icon) { margin-block-start: 0.2em; }
  .fit :global(.fit__yes) { color: var(--color-human-mark); }
  .fit :global(.fit__no) { color: var(--color-text-muted); }
</style>
