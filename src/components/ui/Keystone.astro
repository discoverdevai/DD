---
// Keystone arch (06 §0.8 A): many blue stones laid by AI, one keystone set last by a senior. Inline SVG from
// src/lib/arch.ts, decorative. `stage` draws only the courses laid so far over a ghost of the whole arch (glyphs on the
// method steps); `ghost` keeps that ghost under a complete arch (the scroll-built version on home).
// `hero` lays the stones once on load, springings first, and sets the keystone last. Reduced motion: finished arch.
import { arch } from '../../lib/arch';
interface Props {
  id: string; count?: number; courses?: number; sweep?: number; depth?: number;
  variant?: 'hero' | 'build' | 'glyph'; surface?: 'ink' | 'paper' | 'navy'; stage?: number; ghost?: boolean; class?: string;
}
const { id, count = 9, courses = 2, sweep, depth, variant = 'glyph', surface = 'ink', stage, ghost = stage !== undefined, class: cls } = Astro.props;
const a = arch({ count, courses, sweep, depth });
const gid = `arch-g-${id}`;
const laid = a.stones.filter((s) => stage === undefined || s.course <= stage);
---
<svg class:list={['arch', `arch--${variant}`, `arch--on-${surface}`, cls]} viewBox={a.viewBox} width={a.width} height={a.height} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={gid} gradientUnits="userSpaceOnUse" x1={a.grad.x1} y1={a.grad.y1} x2={a.grad.x2} y2={a.grad.y2}>
      <stop offset="0.13" class="arch__s1" />
      <stop offset="0.87" class="arch__s2" />
    </linearGradient>
  </defs>
  {ghost && <g class="arch__ghost">{a.stones.map((s) => <polygon points={s.points} />)}</g>}
  <g class="arch__laid">
    {laid.map((s) => <polygon points={s.points} class:list={['arch__stone', `arch__c${s.course}`, `arch__o${s.order}`, { arch__key: s.key }]} fill={s.key ? undefined : `url(#${gid})`} />)}
  </g>
</svg>

<style>
  .arch { --arch-mortar: var(--color-bg); display: block; inline-size: 100%; block-size: auto; overflow: visible; }
  /* Ink (the workshop): brand-blue stones, white keystone. Paper keeps the 06 §0.2 roles (navy keystone). */
  .arch--on-ink { --arch-stone-tint: rgb(162 193 254 / 0.09); --arch-key: var(--neutral-0); }
  .arch--on-navy { --arch-stone: var(--blue-300); --arch-stone-2: var(--blue-200); --arch-stone-tint: rgb(254 254 254 / 0.12); --arch-key: var(--neutral-0); }
  .arch__s1 { stop-color: var(--arch-stone); }
  .arch__s2 { stop-color: var(--arch-stone-2); }
  /* Mortar in screen pixels, so a 1,400px hero arch and a 64px glyph read with the same joint. */
  .arch polygon { stroke: var(--arch-mortar); stroke-width: 3px; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .arch__key { fill: var(--arch-key); }
  .arch__ghost polygon { fill: var(--arch-stone-tint); }
  .arch--glyph polygon { stroke-width: 2px; }
  /* Hero: deeper stones so the ring frames the headline without competing with it; the keystone stays bright. */
  .arch--hero { --arch-stone: var(--blue-800); --arch-stone-2: var(--blue-700); }

  @media (prefers-reduced-motion: no-preference) {
    .arch--hero .arch__stone { animation: arch-lay 520ms var(--ease-enter) both; animation-delay: calc(250ms + var(--o, 0) * 110ms); }
    .arch--hero .arch__o1 { --o: 1; } .arch--hero .arch__o2 { --o: 2; } .arch--hero .arch__o3 { --o: 3; }
    .arch--hero .arch__o4 { --o: 4; } .arch--hero .arch__o5 { --o: 5; } .arch--hero .arch__o6 { --o: 6; }
    .arch--hero .arch__o7 { --o: 7; } .arch--hero .arch__o8 { --o: 8; } .arch--hero .arch__o9 { --o: 9; }
    .arch--hero .arch__o10 { --o: 10; } .arch--hero .arch__o11 { --o: 11; } .arch--hero .arch__o12 { --o: 12; }
    /* The keystone (order = last) waits for the last course, then drops in: the senior's sign-off. Up to 25 stones. */
    .arch--hero .arch__key { animation: arch-set 800ms var(--ease-enter) both; animation-delay: calc(450ms + var(--o, 0) * 110ms); }
    @keyframes arch-lay { from { opacity: 0; translate: 0 6px; } to { opacity: 1; translate: 0 0; } }
    @keyframes arch-set { from { opacity: 0; translate: 0 -22px; } 55% { opacity: 1; } to { opacity: 1; translate: 0 0; } }
  }

  @media (forced-colors: active) {
    .arch polygon { stroke: Canvas; }
    .arch__stone { fill: CanvasText; }
    .arch__key { fill: Highlight; }
    .arch__ghost polygon { fill: Canvas; stroke: CanvasText; }
  }
</style>
