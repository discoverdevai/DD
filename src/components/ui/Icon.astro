const { name, size = 20, directional = false, class: cls } = Astro.props;
const stroke = size <= 20 ? 2 : 1.75;
---
<svg
  class:list={['icon', { 'icon--dir': directional }, cls]}
  width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true"
  focusable="false" set:html={ICONS[name]}
/>
