---
// `// comment` eyebrow (06 §9.22): mono, machine colour, at most 2 per page, never on consecutive sections.
interface Props { class?: string }
---
<p class:list={['eyebrow', Astro.props.class]}><slot /></p>

<style>
  .eyebrow { font-family: var(--ff-body); font-size: var(--text-sm); color: var(--color-text-muted); }
</style>
