---
// `// comment` eyebrow (06 §9.22): mono, machine colour, at most 2 per page, never on consecutive sections.
interface Props { class?: string }
---
<p class:list={['eyebrow', Astro.props.class]}><span class="eyebrow__slashes" aria-hidden="true">//</span> <slot /></p>

<style>
  .eyebrow { font-family: var(--ff-mono); font-size: var(--text-sm); color: var(--color-text-muted); }
  .eyebrow__slashes { color: var(--color-machine-text); }
</style>
