---
// ProcessSteps (06 §9.14) with layer chips (06 §0.5). A real sequence, so numbering is meaningful.
// v3: a track of nodes joined by a hairline (the last node is the green "live" node); horizontal from 64rem, vertical below.
import LayerChip, { type Chip } from './LayerChip.astro';
import { t } from '../../i18n/t';
interface Step { title: string; body: string; meta?: string; chip?: Chip }
interface Props { steps: readonly Step[] }
const { steps } = Astro.props;
---
<ol role="list" class="steps reveal-stagger">
  {steps.map((s, i) => (
    <li class="step">
      <span class="step__rail" aria-hidden="true"></span>
      <span class:list={['step__node', { 'is-last': i === steps.length - 1 }]} aria-hidden="true"></span>
      <span class="step__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="h3 step__title"><span class="sr-only">{t('steps.label', 'en', { n: i + 1 })} </span>{s.title}</h3>
      {s.meta && <p class="step__meta">{s.meta}</p>}
      <p class="step__body">{s.body}</p>
      {s.chip && <LayerChip kind={s.chip.kind}>{s.chip.label}</LayerChip>}
    </li>
  ))}
</ol>

<style>
  .steps { display: grid; gap: var(--space-8); }
  @media (width >= 64rem) { .steps { grid-auto-flow: column; grid-auto-columns: 1fr; gap: var(--space-6); } }
  .step { position: relative; display: grid; gap: var(--space-3); align-content: start; padding-inline-start: var(--space-8); min-inline-size: 0; }
  @media (width >= 64rem) { .step { padding-inline-start: 0; padding-block-start: var(--space-8); } }
  .step__rail { position: absolute; inset-block: 0.4rem calc(var(--space-8) * -1); inset-inline-start: 5px; inline-size: 1px; background: linear-gradient(180deg, color-mix(in oklab, var(--blue-300) 40%, transparent), color-mix(in oklab, var(--blue-300) 12%, transparent)); }
  .step:last-child .step__rail { display: none; }
  .step__node { position: absolute; inset-block-start: 0.15rem; inset-inline-start: 0; inline-size: 11px; block-size: 11px; border-radius: 50%; border: 2px solid var(--blue-400); background: var(--color-bg); }
  .step__node.is-last { border-color: var(--color-human-mark); background: var(--color-human-mark); box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-human-mark) 20%, transparent); }
  @media (width >= 64rem) {
    .step__rail { inset-block: 5px auto; inset-inline: 0 calc(var(--space-6) * -1); inline-size: auto; block-size: 1px; background: linear-gradient(90deg, color-mix(in oklab, var(--blue-300) 40%, transparent), color-mix(in oklab, var(--blue-300) 12%, transparent)); }
    :dir(rtl) .step__rail { background: linear-gradient(-90deg, color-mix(in oklab, var(--blue-300) 40%, transparent), color-mix(in oklab, var(--blue-300) 12%, transparent)); }
    .step__node { inset-block-start: 0; }
  }
  .step__n { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-machine-text); }
  .step__title { font-size: var(--text-xl); font-weight: var(--weight-semibold); letter-spacing: -0.02em; }
  .step__meta { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .step__body { color: var(--color-text-muted); }
</style>
