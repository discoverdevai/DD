---
// Booking embed container (06 §9.17, 07 §10.2). Reserved height stops CLS. Fallback links show until Cal's
// `linkReady`, and come back on `linkFailed` or after 10s. No JS → <noscript> links. Cal script loads from lib/cal.ts.
import { copy } from '../../content/copy';
import { t } from '../../i18n/t';
import { directLink, calUsername, type BookType } from '../../lib/cal';
import { isLive, href } from '../../data/routes';
const c = copy().book;
const types: BookType[] = isLive('review') ? ['review', 'clarity', 'partner'] : ['clarity']; // V1.0: the clarity call only (03 §2V1)
---
<div class="cal" data-cal data-cal-configured={calUsername ? 'true' : 'false'} data-iframe-title={c.calendar.title}>
  <p class="cal__tz">{c.calendar.timezone}</p>
  <div class="cal__frame">
    <div id="cal-inline" class="cal__inline" data-cal-inline></div>
    <div class="cal__fallback" data-cal-fallback>
      <p class="cal__loading" data-cal-loading>{c.calendar.loading}</p>
      <p class="cal__failed" role="status" data-cal-failed hidden>{c.calendar.failed}</p>
      {calUsername && (
        <ul role="list" class="cal__links">
          {types.map((ty) => <li data-cal-link={ty}><a href={directLink(ty)} data-link-context="contact">{c.calendar.direct}: {c.options[ty].tab}</a></li>)}
        </ul>
      )}
      <p><a href={`mailto:${t('contact.email')}`} data-link-context="contact" dir="ltr">{t('contact.email')}</a></p>
    </div>
  </div>
  <noscript>
    <p class="cal__noscript">{calUsername ? c.calendar.direct : c.calendar.failed}</p>
  </noscript>
  <p class="cal__cookies small">{c.calendar.cookies} {isLive('privacy') && <a href={href('privacy')}>{c.calendar.privacyLink}</a>}</p>
</div>

<style>
  .cal { display: grid; gap: var(--space-3); }
  .cal__tz { font-family: var(--ff-body); font-size: var(--text-xs); color: var(--color-machine-text); }
  .cal__frame { position: relative; min-block-size: 62rem; background: var(--color-surface); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); padding: var(--space-2); overflow: hidden; }
  @media (width >= 48rem) { .cal__frame { min-block-size: 46rem; } } /* the real booker is 980-1230px tall on phones: reserve it so the page below does not jump (final audit) */
  /* No calendar (not configured, or the embed failed): drop the reserved height so the direct links and the
     "what happens on the call" copy aren't pushed below an empty box. */
  .cal[data-cal-configured="false"] .cal__frame, .cal__frame:has([data-cal-failed]:not([hidden])) { min-block-size: 0; }
  .cal__inline { inline-size: 100%; min-block-size: inherit; }
  .cal__inline:empty { display: none; }
  .cal__fallback { position: absolute; inset-inline: 0; inset-block-start: 0; display: grid; gap: var(--space-3); align-content: start; padding: var(--space-6); } /* out of flow: removing it moves nothing */
  .cal[data-ready] .cal__fallback { display: none; }
  .cal__loading { color: var(--color-text-muted); }
  /* Loading state (UX audit P1-1): a skeleton of the booker holds the space; the direct links appear after 4 seconds so loading and failure look different. */
  .cal__loading::after { content: ''; display: block; margin-block-start: var(--space-5); block-size: 14rem; border-radius: var(--radius-md); background: linear-gradient(var(--color-border-subtle), var(--color-border-subtle)) 0 0 / 100% 2.25rem no-repeat, repeating-linear-gradient(90deg, color-mix(in oklab, var(--blue-300) 12%, transparent) 0 3.25rem, transparent 3.25rem 3.75rem) 0 3.5rem / 100% 7rem no-repeat; opacity: 0.5; }
  @media (prefers-reduced-motion: no-preference) { .cal__loading::after { animation: cal-pulse 1.6s ease-in-out infinite; } @keyframes cal-pulse { 50% { opacity: 0.25; } } }
  .cal__links, .cal__fallback > p:last-child { animation: cal-late 0s 4s backwards; }
  @keyframes cal-late { from { visibility: hidden; opacity: 0; } to { visibility: visible; opacity: 1; } }
  .cal__frame:has([data-cal-failed]:not([hidden])) .cal__links, .cal__frame:has([data-cal-failed]:not([hidden])) .cal__fallback > p:last-child, .cal[data-cal-configured="false"] .cal__links, .cal[data-cal-configured="false"] .cal__fallback > p:last-child { animation: none; }
  .cal__links { display: grid; gap: var(--space-1); }
  .cal__links a { display: inline-flex; align-items: center; min-block-size: 2.75rem; font-weight: var(--weight-medium); }
  .cal__cookies { color: var(--color-text-muted); max-inline-size: 68ch; }
</style>
