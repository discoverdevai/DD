---
// /about time-overlap strip (03 §12.4, 04 §4.9, 06 §10 diagrams). Locations in order, the hub highlighted, the shared band shaded.
// No hour ranges or seasonal claims (11 §5). The strip is aria-hidden; the figcaption is the real-text equivalent.
interface Place { name: string; hub: boolean }
interface Props { label: string; places: readonly Place[]; hubTag: string; text: string }
const { label, places, hubTag, text } = Astro.props;
---
<figure class="tz">
  <div class="tz__strip" aria-hidden="true">
    <p class="tz__dir"><span class="tz__slashes">//</span> {label}</p>
    <ol class="tz__track">
      {places.map((p) => (
        <li class:list={['tz__place', { 'tz__place--hub': p.hub }]}>
          <span class="tz__dot"></span>
          <span class="tz__name">{p.name}</span>
          {p.hub && <span class="tz__tag">{hubTag}</span>}
        </li>
      ))}
    </ol>
  </div>
  <figcaption class="tz__text">{text}</figcaption>
</figure>

<style>
  .tz { display: grid; gap: var(--space-4); margin: 0; }
  .tz__strip { display: grid; gap: var(--space-4); padding: var(--space-6); background: var(--color-surface); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); }
  .tz__dir { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .tz__slashes { color: var(--color-machine-text); }
  .tz__track { position: relative; display: grid; gap: var(--space-4); padding-block: var(--space-3); padding-inline: var(--space-3); border-radius: var(--radius-md); background: color-mix(in oklab, var(--color-machine-mark) 12%, transparent); }
  /* connector: vertical at inline-start on small screens, horizontal through the dots from 40rem */
  .tz__track::before { content: ''; position: absolute; inset-block: var(--space-6); inset-inline-start: calc(var(--space-3) + 0.4375rem); inline-size: 1px; background: var(--color-machine-mark); }
  .tz__place { position: relative; display: flex; align-items: center; gap: var(--space-3); min-inline-size: 0; }
  .tz__dot { flex: none; inline-size: 0.875rem; block-size: 0.875rem; border-radius: var(--radius-pill); background: var(--color-surface); border: 2px solid var(--color-machine-mark); }
  .tz__name { font-family: var(--ff-mono); font-size: var(--text-sm); color: var(--color-text); }
  .tz__tag { font-family: var(--ff-mono); font-size: var(--text-xs); color: var(--color-human-text); }
  .tz__place--hub .tz__dot { background: var(--color-action-bg); border-color: var(--color-action-bg); }
  .tz__place--hub .tz__name { font-weight: var(--weight-medium); color: var(--color-heading); }
  @media (width >= 40rem) {
    .tz__track { grid-template-columns: repeat(5, minmax(0, 1fr)); padding-block: var(--space-5); }
    .tz__track::before { inset-block: auto; inset-block-start: calc(var(--space-5) + 0.4375rem); inset-inline: 10%; inline-size: auto; block-size: 1px; }
    .tz__place { flex-direction: column; align-items: center; text-align: center; gap: var(--space-2); }
  }
  .tz__text { font-size: var(--text-sm); color: var(--color-text-muted); }
</style>
