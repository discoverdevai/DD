---
// /build and /ar/build (03 §16b.1 + §16b.6, lean R1; home-style redesign Oct 26 from
// docs/research-sitemap/build-page-inspiration.md). Seven sections, all on the ink theme like home:
// hero (NJWAR's real screens, the number row and the two ways in; Phase 3, 03 §16b.38) → the plan (Validate and Build on one timeline, the decision and every
// senior sign-off on it, "You get" under each phase) → AI-built prototype (one findings report) → what you get (one
// statement-of-work card) → proof (NJWAR leads, EduLens as one number) → FAQ (buyer order) → close (a question).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../sections/PageHero.astro';
import FaqSplit from '../sections/FaqSplit.astro';
import CtaBand from '../sections/CtaBand.astro';
import Journey from '../sections/Journey.astro';
import JourneyStop from '../sections/JourneyStop.astro';
import BuildShot from '../scenes/BuildShot.astro';
import BuildProof from '../sections/BuildProof.astro';
import Quote from '../blocks/Quote.astro';
import WeekTrack from '../sections/WeekTrack.astro';
import WhatYouGet from '../sections/WhatYouGet.astro';
import ReviewSection from '../sections/ReviewSection.astro';
import { copy } from '../../content/copy';
import { getLocale } from '../../i18n/t';
import { graph, orgStub, webPage, canonical, faqPage, service } from '../../lib/seo';

const c = copy().build;
const path = getLocale() === 'ar' ? '/ar/build' : '/build';
const url = canonical(path);
const serviceLd = service(url, {
  name: 'Build', serviceType: 'MVP development', description: c.seo.description,
  audience: 'Founders ready to build',
  offers: { url: `${url}#pricing`, description: c.pricing.answer },
});
const faqLd = faqPage(`${url}#faq`, c.faq.items);
const jsonLd = graph(orgStub, serviceLd, webPage(path, c.seo.title, c.seo.description, 'WebPage', { mainEntity: { '@id': `${url}#service` } }), faqLd);
---
<BaseLayout title={c.seo.title} description={c.seo.description} pageType="service" jsonLd={jsonLd}>
  <PageHero page="build" eyebrow={c.hero.eyebrow} h1={c.hero.h1} lead={c.hero.body} meta={c.hero.nums} cta="clarity">
    <p slot="link" class="ways">{c.hero.ways.map((w) => <a href={`#${w.anchor}`}>{w.label}<span class="icon--dir" aria-hidden="true">→</span></a>)}</p>
    <BuildShot slot="aside" c={c.hero.shot} />
  </PageHero>

  <!-- Journey (03 §16b.7): one line from idea to launch. Each stop marks the section after it; the background deepens
       slowly down the page instead of alternating bands. The line and stops are decorative; headings carry the meaning. -->
  <Journey>
    <JourneyStop label={c.stages.plan} />
    <WeekTrack title={c.plan.title} example={c.plan.example} weeks={c.plan.weeks} weekLabel={c.plan.weekLabel} demoLabel={c.plan.demoLabel} liveLabel={c.plan.liveLabel} phases={c.plan.phases} spans={c.plan.spans} fork={c.plan.fork} signLabel={c.plan.signLabel} getLabel={c.plan.getLabel} />
    <div class="container voice"><Quote text={c.plan.quote.text} name={c.plan.quote.name} role={c.plan.quote.role} /></div>

    <JourneyStop label={c.stages.review} />
    <ReviewSection />

    <JourneyStop label={c.stages.terms} />
    <WhatYouGet c={c.get} />

    <JourneyStop label={c.stages.proof} />
    <BuildProof c={c.proof} />

    <JourneyStop label={c.stages.faq} />
    <FaqSplit title={c.faq.title} items={c.faq.items} ctaPage="build" openFirst />

    <JourneyStop label={c.stages.close} end />
    <CtaBand title={c.band.title} body={c.band.body} kind="clarity" page="build" />
  </Journey>
</BaseLayout>


