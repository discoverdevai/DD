---
// /build and /ar/build (03 §16b.1 + §16b.6, lean R1; home-style redesign Oct 26 from
// docs/research-sitemap/build-page-inspiration.md). Seven sections, all on the ink theme like home:
// hero (the path window and the two ways in) → the plan (Validate and Build on one timeline, the decision and every
// senior sign-off on it) → AI-built prototype (a finding being fixed, the sample report) → what you get and terms (one
// statement of work) → proof (one big number, client words) → FAQ (buyer order) → close (a question).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../sections/PageHero.astro';
import Section from '../sections/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import ProofList from '../blocks/ProofList.astro';
import FaqSplit from '../sections/FaqSplit.astro';
import CtaBand from '../sections/CtaBand.astro';
import CtaLink from '../ui/CtaLink.astro';
import CtaTerms from '../ui/CtaTerms.astro';
import BuildPath from '../scenes/BuildPath.astro';
import CodeFinding from '../scenes/CodeFinding.astro';
import ReviewSnapshot from '../scenes/ReviewSnapshot.astro';
import CaseResult from '../scenes/CaseResult.astro';
import Quote from '../blocks/Quote.astro';
import WeekTrack from '../sections/WeekTrack.astro';
import TermsDoc from '../sections/TermsDoc.astro';
import { copy } from '../../content/copy';
import { t, getLocale } from '../../i18n/t';
import { bookHref } from '../../data/routes';
import { graph, orgStub, webPage, canonical, faqPage, service } from '../../lib/seo';

const c = copy().build;
const path = getLocale() === 'ar' ? '/ar/build' : '/build';
const url = canonical(path);
const serviceLd = service(url, {
  name: 'Build', serviceType: 'MVP development', description: c.seo.description,
  audience: 'Founders ready to build',
  offers: { url: `${url}#pricing`, description: c.pricing.answer },
});
const faqLd = faqPage(`${url}#faq`, c.faq.items);
const jsonLd = graph(orgStub, serviceLd, webPage(path, c.seo.title, c.seo.description, 'WebPage', { mainEntity: { '@id': `${url}#service` } }), faqLd);
---
<BaseLayout title={c.seo.title} description={c.seo.description} pageType="service" jsonLd={jsonLd}>
  <PageHero page="build" eyebrow={c.hero.eyebrow} h1={c.hero.h1} lead={c.hero.body} cta="clarity">
    <p slot="link" class="ways">{c.hero.ways.map((w) => <a href={`#${w.anchor}`}>{w.label}<span class="icon--dir" aria-hidden="true">→</span></a>)}</p>
    <BuildPath slot="aside" c={c.hero.path} />
  </PageHero>

  <WeekTrack title={c.plan.title} example={c.plan.example} weeks={c.plan.weeks} weekLabel={c.plan.weekLabel} demoLabel={c.plan.demoLabel} liveLabel={c.plan.liveLabel} phases={c.plan.phases} spans={c.plan.spans} fork={c.plan.fork} signLabel={c.plan.signLabel} />

  <section id="review" class="review" data-surface="ink" data-raised aria-labelledby="review-title">
    <div class="container review__grid">
      <div class="review__copy">
        <SectionHead id="review-title" title={c.review.title} measure={22} />
        <p class="review__body">{c.review.body}</p>
        <dl class="review__facts">{c.review.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
        <p class="review__guarantee">{c.review.guarantee}</p>
        <p class="review__credit">{c.review.credit}</p>
        <div class="review__cta">
          <CtaLink href={bookHref('clarity')} ctaId="build_mid_clarity" tier="secondary" position="mid" target="clarity">{t('cta.clarity')}</CtaLink>
          <CtaTerms kind="clarity" />
        </div>
      </div>
      <div class="review__visuals">
        <CodeFinding c={c.review.finding} />
        <div class="review__report" data-surface="paper"><ReviewSnapshot /></div>
      </div>
    </div>
  </section>

  <TermsDoc title={c.terms.title} docTitle={c.terms.docTitle} docMeta={c.terms.docMeta} layout="rows" cols={[
    { title: c.gets.title, body: c.gets.body },
    { title: c.timeline.title, body: c.timeline.body },
    { id: 'pricing', title: c.pricing.title, body: c.pricing.answer },
    { title: c.team.title, body: c.team.body, link: c.team.link },
    { title: c.ownership.title, body: c.ownership.body },
  ]} />

  <Section id="proof" surface="raised" title={c.proof.title}>
    <div class="proof">
      <CaseResult c={c.proof.case} low={10} high={40} quote={c.proof.case.quote} big={c.proof.case.big} />
      <div class="proof__more">
        <ProofList items={c.proof.items} />
        <Quote text={c.proof.quote.text} name={c.proof.quote.name} role={c.proof.quote.role} />
      </div>
    </div>
  </Section>

  <FaqSplit title={c.faq.title} items={c.faq.items} ctaPage="build" />

  <CtaBand title={c.band.title} body={c.band.body} kind="clarity" page="build" />
</BaseLayout>

<style>
  .ways { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-block-start: var(--space-2); }
  .ways a { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-link); text-decoration: none; }
  .ways a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .ways .icon--dir { margin-inline-start: var(--space-1); }

  .review { padding-block: var(--section-y); }
  .review__grid { display: grid; gap: var(--space-10); align-items: start; }
  @media (width >= 64rem) { .review__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-16); } }
  .review__copy { display: grid; gap: var(--space-4); }
  .review__body { font-size: var(--text-lg); line-height: 1.55; color: var(--color-text-muted); max-inline-size: var(--measure-lead); }
  .review__facts { display: flex; flex-wrap: wrap; gap: var(--space-8); margin: var(--space-2) 0 0; }
  .review__facts div { display: grid; gap: var(--space-1); }
  .review__facts dt { order: 2; font-size: var(--text-sm); color: var(--color-text-muted); }
  .review__facts dd { order: 1; margin: 0; font-family: var(--ff-heading); font-weight: var(--weight-bold); font-size: var(--text-3xl); line-height: 1; letter-spacing: -0.03em; color: var(--color-heading); }
  .review__guarantee { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-human-mark); }
  .review__credit { font-size: var(--text-sm); color: var(--color-text-muted); }
  .review__cta { display: grid; gap: var(--space-3); justify-items: start; margin-block-start: var(--space-2); }
  .review__visuals { display: grid; gap: var(--space-6); min-inline-size: 0; }
  .review__report { border-radius: var(--radius-lg); }
  @media (width >= 64rem) { .review__report { inline-size: 88%; justify-self: end; } }

  .proof { display: grid; gap: var(--space-10); }
  .proof__more { display: grid; gap: var(--space-8); }
</style>
