---
// 404 (04 §4.14, 03 §16). Served with HTTP 404 by wrangler `not_found_handling: "404-page"`. noindex, no JSON-LD.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaLink from '../../components/ui/CtaLink.astro';
import CtaTerms from '../../components/ui/CtaTerms.astro';
import { copy } from '../../content/copy';
import { t, localPath } from '../../i18n/t';
import { bookHref, isLive, href } from '../../data/routes';

const c = copy().notFound;
const links = [
  { label: c.links.home, path: localPath('/'), live: true },
  { label: c.links.review, path: href('review'), live: isLive('review') },
  { label: c.links.work, path: href('work'), live: isLive('work') },
  { label: c.links.insights, path: href('insights'), live: isLive('insights') },
].filter((l) => l.live);
---
<BaseLayout title={c.title} pageType="404" noindex stickyBar={false} footerCore={false}>
  <section class="section nf" data-surface="ink" aria-labelledby="nf-title">
    <div class="container--narrow nf__inner">
      <p class="nf__cmd" aria-hidden="true"><span>$</span> cd /page-not-found</p>
      <h1 id="nf-title" class="h1">{c.h1}</h1>
      <p class="lead">{c.body}</p>
      <div class="nf__cta">
        {isLive('review')
          ? <><CtaLink href={bookHref('review')} ctaId="notfound_end_review" tier="primary" position="end" target="review" wide>{t('cta.review')}</CtaLink><CtaTerms kind="review" /></>
          : <><CtaLink href={bookHref('clarity')} ctaId="notfound_end_clarity" tier="primary" position="end" target="clarity" wide>{t('cta.clarity')}</CtaLink><CtaTerms kind="clarity" /></>}
      </div>
      <ul role="list" class="nf__links">
        {links.map((l) => <li><a href={l.path}>{l.label}</a></li>)}
      </ul>
      <p class="small muted">{c.help} <a href={`mailto:${t('contact.email')}`} dir="ltr">{t('contact.email')}</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { min-block-size: 70vh; }
  .nf__inner { display: grid; gap: var(--space-6); justify-items: start; }
  .nf__cmd { font-family: var(--ff-mono); font-size: var(--text-sm); padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); background: var(--color-surface); border: 1px solid var(--color-hairline); }
  .nf__cmd span { color: var(--color-code-prompt); }
  .nf__links { display: grid; gap: var(--space-1); }
  .nf__links a { display: inline-flex; align-items: center; min-block-size: 2.75rem; font-weight: var(--weight-medium); }
  .nf__cta { display: grid; gap: var(--space-3); justify-items: start; }
</style>
