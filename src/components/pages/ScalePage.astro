---
// /scale and /ar/scale (03 §7 + §16b.2, lean R1): a team that stays, with the Partners page folded in as one section
// (white-label or staff augmentation, compared). All on the ink theme like home (Oct 26).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../sections/PageHero.astro';
import Section from '../sections/Section.astro';
import FitQuiz from '../sections/FitQuiz.astro';
import ProofList from '../blocks/ProofList.astro';
import FaqSplit from '../sections/FaqSplit.astro';
import CtaBand from '../sections/CtaBand.astro';
import ServiceGlance from '../scenes/ServiceGlance.astro';
import SquadGrowth from '../sections/SquadGrowth.astro';
import SquadPieces from '../sections/SquadPieces.astro';
import WhatYouGet from '../sections/WhatYouGet.astro';
import OptionCards from '../partners/OptionCards.astro';
import CtaLink from '../ui/CtaLink.astro';
import CtaTerms from '../ui/CtaTerms.astro';
import { bookHref } from '../../data/routes';
import Quote from '../blocks/Quote.astro';
import Journey from '../sections/Journey.astro';
import JourneyStop from '../sections/JourneyStop.astro';
import { copy } from '../../content/copy';
import { t, getLocale } from '../../i18n/t';
import { graph, orgStub, webPage, canonical, faqPage, service } from '../../lib/seo';

const c = copy().scale;
const path = getLocale() === 'ar' ? '/ar/scale' : '/scale';
const url = canonical(path);
const serviceLd = service(url, {
  name: 'Scale', serviceType: 'Dedicated development team', description: c.seo.description,
  audience: 'Startups with a live product',
  offers: { url: `${url}#pricing`, description: c.pricing.answer },
});
// Software houses book the same call; the interest shows on /book and in the Cal.com notes (03 §16b.23).
const partnerHref = bookHref('clarity').startsWith('mailto:') ? bookHref('clarity') : `${bookHref('clarity')}&interest=scale-house`;
const faqLd = faqPage(`${url}#faq`, c.faq.items);
const jsonLd = graph(orgStub, serviceLd, webPage(path, c.seo.title, c.seo.description, 'WebPage', { mainEntity: { '@id': `${url}#service` } }), faqLd);
---
<BaseLayout title={c.seo.title} description={c.seo.description} pageType="service" jsonLd={jsonLd}>
  <PageHero page="scale" eyebrow={c.hero.eyebrow} h1={c.hero.h1} lead={c.hero.body} cta="clarity">
    <p slot="link" class="ways">{c.hero.ways.map((w) => <a href={`#${w.anchor}`}>{w.label}<span class="icon--dir" aria-hidden="true">→</span></a>)}</p>
    <ServiceGlance slot="aside" name={t('nav.scale')} label={c.process.title} steps={c.process.steps} meta={c.hero.meta} />
  </PageHero>

  <!-- Journey (shared with Build, Oct 27): one line from joining to a team that stays; even gaps between stops. -->
  <Journey>
  <JourneyStop label={c.stages.squad} />
  <SquadGrowth c={c.growth} chip={c.process.steps[1].chip} />

  <JourneyStop label={c.stages.outcomes} />
  <SquadPieces c={c.pieces} />

  <JourneyStop label={c.stages.fit} />
  <FitQuiz c={c.quiz} />

  <JourneyStop label={c.stages.terms} />
  <WhatYouGet id="terms" page="scale" c={c.get} />

  <JourneyStop label={c.stages.partners} />
  <Section id="partners" surface="raised" title={c.partners.title} lead={c.partners.answer}>
    <OptionCards caption={c.partners.caption} columns={c.partners.columns} bestLabel={c.partners.bestLabel} bestFor={c.partners.bestFor} rows={c.partners.rows} />
    <div class="partners__cta">
      <CtaLink href={partnerHref} ctaId="scale_mid_clarity_partners" tier="secondary" position="mid" target="clarity">{t('cta.clarity')}</CtaLink>
      <CtaTerms kind="clarity" />
    </div>
    <div class="partners__quote"><Quote text={c.partners.quote.text} name={c.partners.quote.name} role={c.partners.quote.role} /></div>
  </Section>

  <JourneyStop label={c.stages.proof} />
  <Section id="proof" surface="ink" title={c.proof.title}>
    <ProofList items={c.proof.items} />
    <p class="retention">{c.proof.retention}</p>
  </Section>

  <JourneyStop label={c.stages.faq} />
  <FaqSplit title={c.faq.title} items={c.faq.items} ctaPage="scale" />

  <JourneyStop label={c.stages.close} end />
  <CtaBand title={c.band.title} kind="clarity" page="scale" />
  </Journey>
</BaseLayout>

<style>
  .partners__cta { display: grid; gap: var(--space-2); justify-items: start; margin-block-start: var(--space-6); }
  .partners__quote { margin-block-start: var(--space-10); }
  .retention { margin-block: var(--space-8) var(--space-2); font-size: var(--text-lg); font-weight: var(--weight-medium); color: var(--color-heading); }
</style>
