---
// Breadcrumbs (06 §9.20, 04 §3.5): depth-2 pages only. Separator is CSS (mirrors in RTL). Last item is aria-current.
interface Crumb { label: string; href?: string }
interface Props { items: readonly Crumb[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol role="list">
    {items.map((c, i) => (
      <li>{c.href && i < items.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--space-2); font-size: var(--text-sm); }
  .crumbs li { display: inline-flex; align-items: center; gap: var(--space-2); }
  .crumbs li + li::before { content: '›'; color: var(--color-text-muted); }
  :dir(rtl) .crumbs li + li::before { content: '‹'; }
  .crumbs a { display: inline-flex; align-items: center; min-block-size: 1.5rem; }
  .crumbs [aria-current] { color: var(--color-text-muted); }
</style>
