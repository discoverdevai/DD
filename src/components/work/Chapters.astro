---
// Project chapters (03 §2A.8a, Oct 16): one product per full screen in the site theme (ink, brand-blue light,
// Manrope), huge product name, real screens from our Figma on 3D devices. Layouts by screen mix: web + 1 phone,
// web + 2 phones, 3 phones. Held chapters (e.g. Rushr, D-07) render only in a preview build, from assets/projects-held
// as inline data so their files never reach the live build. On home (`only` given) the chapters sit in ONE sideways row, one chapter per page
// (scroll-snap, swipe, two arrows, no counter; Mohamed, Oct 21: gentler and easier than a tall stack). It turns a page by itself every 10 seconds and never pauses
// (Mohamed, Oct 21: it keeps sliding); a swipe or arrow press only restarts the timer; off screen or reduced motion = it stays put. Devices are decorative frames; each screen has alt text.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import path from 'node:path';
import sharp from 'sharp';
import { chapters, chapterCopy as c, showcase as sc } from '../../content/copy/en/projects';
import { href, isLive } from '../../data/routes';
import Device from '../ui/Device.astro';
import SectionHead from '../ui/SectionHead.astro';
import { t } from '../../i18n/t';
import SliderArrows from '../ui/SliderArrows.astro';
// `only`: chapter ids to show (home shows NJWAR; /work shows all).
interface Props { headingLevel?: 'h2' | 'h3'; only?: readonly string[] }
const { headingLevel = 'h2', only } = Astro.props;
// Home passes `only`: the chapter then sits under the section title ("Selected work", an h2 rendered here so it comes first) and its name is an h3.
const head = only !== undefined;
const H = head ? 'h3' : headingLevel;
const files = import.meta.glob<{ default: ImageMetadata }>('/assets/projects/*.{png,jpg,jpeg,webp}');
const load = async (file: string, held: boolean, width: number) => held
  ? `data:image/webp;base64,${(await sharp(path.join(process.cwd(), 'assets/projects-held', file)).resize({ width }).webp({ quality: 78 }).toBuffer()).toString('base64')}`
  : (await files[`/assets/projects/${file}`]()).default;
const rows = await Promise.all(chapters.filter((ch) => !only || only.includes(ch.id)).map(async (ch) => ({
  ...ch,
  layout: ch.web ? (ch.phones.length > 1 ? 'web2' : 'web1') : 'phones',
  webSrc: ch.web ? await load(ch.web.file, !!ch.hold, 1440) : undefined,
  phoneSrcs: await Promise.all(ch.phones.map((p) => load(p.file, !!ch.hold, 600))),
})));
---
{rows.length > 0 && head && (
  <div class="wh" data-surface="ink">
    <div class="container wh__in">
      <SectionHead id="work-title" title={sc.moreTitle} />
      {isLive('work') && <a class="wh__all" href={href('work')}>{sc.allLink}<span class="icon--dir" aria-hidden="true"> →</span></a>}
      {rows.length > 1 && (
        <SliderArrows ns="ch" controls="ch-rail" prevLabel={t('chapters.prev')} nextLabel={t('chapters.next')} />
      )}
    </div>
  </div>
)}
{rows.length > 0 && (
  <div class:list={['chs', { 'chs--headed': head, 'chs--rail': head && rows.length > 1 }]} id={head && rows.length > 1 ? 'ch-rail' : undefined} role={head && rows.length > 1 ? 'region' : undefined} aria-label={head && rows.length > 1 ? t('chapters.region') : undefined} tabindex={head && rows.length > 1 ? 0 : undefined} data-ch-rail={head && rows.length > 1 ? '' : undefined}>
    {rows.map((ch) => (
      <section class:list={['ch', `ch--${ch.layout}`]} data-surface="ink" aria-labelledby={`ch-${ch.id}`} id={`chapter-${ch.id}`}>
        <div class="ch__copy">
          <ul role="list" class="ch__tags">{ch.tags.map((t, i) => <li class:list={['tag', { 'tag--stage': i === 0 }]}>{t}</li>)}</ul>
          <H id={`ch-${ch.id}`} class="ch__name">{ch.name}</H>
          <p class="ch__line">{ch.line}</p>
          <div class="ch__acts">
            {isLive('work') && <a class="ch__view" href={`${href('work')}#project-${ch.project}`}>{c.view}<span class="icon--dir" aria-hidden="true">&nbsp;→</span></a>}
            {ch.tryIt && <a class="ch__try" href={ch.tryIt.href} target="_blank" rel="noopener" data-link-context="ar_demo">{ch.tryIt.label}<span aria-hidden="true">&nbsp;↗</span></a>}
          </div>
          {ch.note && <p class="ch__note">{ch.note}</p>}
        </div>
        <div class="ch__scene">
          {ch.webSrc && ch.web && (
            <div class="ch__laptop"><Device kind="laptop">
              {typeof ch.webSrc === 'string'
                ? <img src={ch.webSrc} alt={ch.web.alt} width="1440" height="900" loading="lazy" decoding="async" />
                : <Image src={ch.webSrc} alt={ch.web.alt} widths={[640, 960, 1440]} sizes="(min-width: 64rem) 50vw, 90vw" loading="lazy" decoding="async" />}
            </Device></div>
          )}
          {ch.phoneSrcs.map((src, i) => (
            <div class:list={['ch__phone', `ch__phone--${i + 1}`]}><Device kind="phone">
              {typeof src === 'string'
                ? <img src={src} alt={ch.phones[i].alt} width="375" height="812" loading="lazy" decoding="async" />
                : <Image src={src} alt={ch.phones[i].alt} widths={[300, 600]} sizes="(min-width: 64rem) 18vw, 40vw" loading="lazy" decoding="async" />}
            </Device></div>
          ))}
        </div>
      </section>
    ))}
  </div>
)}

<style>
  /* Section title (home): the h2 comes first, then the chapter. The chapter drops its own seam and top gap under it. */
  .wh { padding-block: var(--section-y) 0; border-block-start: 1px solid var(--color-hairline); }
  .wh__in { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-4); }
  .chs--rail:focus-visible { outline: var(--focus-width) solid var(--blue-300); outline-offset: var(--focus-offset); }
  /* One chapter per page in a sideways row: snap, swipe, arrows. The scrollbar is hidden. */
  .chs--rail { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; }
  .chs--rail::-webkit-scrollbar { display: none; }
  .chs--rail > .ch { flex: 0 0 100%; min-inline-size: 0; scroll-snap-align: start; scroll-snap-stop: always; }
  /* Pages of different content heights must line up: titles share one top edge and the devices share one bottom edge (design review, Oct 21). */
  @media (width < 64rem) { .chs--rail > .ch { grid-template-rows: auto 1fr; align-content: stretch; align-items: start; } .chs--rail .ch__copy { align-content: start; } .chs--rail .ch__scene { align-self: end; inline-size: 100%; } }
  @media (prefers-reduced-motion: no-preference) { .chs--rail { scroll-behavior: smooth; } }
  .wh__all { font-family: var(--ff-heading); font-weight: var(--weight-bold); color: var(--color-link); }
  .chs--headed .ch { border-block-start: 0; padding-block-start: var(--space-8); }
  @media (width >= 64rem) { .chs--headed .ch { padding-block-start: var(--space-4); align-items: start; } .chs--headed .ch__copy { padding-block-start: var(--space-10); } .chs--headed .ch__scene { min-block-size: 30rem; } }
  .ch { position: relative; overflow: clip; display: grid; gap: var(--space-10); align-items: center; padding-block: var(--section-y); border-block-start: 1px solid var(--color-hairline);
    background: radial-gradient(52% 64% at 74% 56%, rgb(var(--blue-700-rgb) / 0.5), rgb(var(--blue-800-rgb) / 0.16) 55%, transparent 75%), var(--color-bg); }
  @media (width >= 64rem) { .ch { grid-template-columns: minmax(0, 42fr) minmax(0, 58fr); gap: 0; padding-block: var(--section-y); padding-inline-start: max(var(--gutter), (100% - var(--container)) / 2); } }
  @media (width < 64rem) { .ch { padding-inline: var(--gutter); } }
  /* Wide screens: the scene stops at the wide container instead of bleeding to the window edge. */
  @media (width >= 90rem) { .ch__scene { max-inline-size: calc(var(--container-wide) * 0.58); } }
  .ch__copy { position: relative; z-index: 3; display: grid; gap: var(--space-5); align-content: center; }
  .ch__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .ch__name { font-family: var(--ff-heading); font-size: clamp(1.75rem, 1.2rem + 1.4vw, 2.25rem); /* project title: below the 48px section H2 (layout audit) */ font-weight: var(--weight-bold); line-height: 1.05; letter-spacing: -0.04em; color: var(--color-heading); text-wrap: balance; }
  .ch__line { max-inline-size: 31ch; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.3125rem); line-height: 1.5; color: var(--blue-200); }
  .ch__acts { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-4); margin-block-start: var(--space-1); }
  .ch__view, .ch__try { display: inline-flex; align-items: center; min-block-size: 3rem; padding-inline: var(--space-6); border-radius: var(--radius-sm); font-family: var(--ff-heading); font-weight: var(--weight-bold); text-decoration: none; }
  .ch__view { background: var(--color-action-bg); color: var(--color-action-text); }
  .ch__try { border: 1px solid color-mix(in oklab, var(--blue-300) 50%, transparent); color: var(--color-heading); }
  @media (hover: hover) { .ch__view:hover { background: var(--color-action-bg-hover); } .ch__try:hover { background: color-mix(in oklab, var(--blue-300) 10%, transparent); } }
  .ch__note { max-inline-size: 44ch; font-size: var(--text-sm); color: var(--color-machine-text); }

  /* Scene: one coordinate box, devices placed in %; 3D tilt shared by every device. */
  .ch__scene { position: relative; aspect-ratio: 4 / 3; perspective: 2000px; container-type: inline-size; }
  @media (width >= 64rem) { .ch__scene { aspect-ratio: auto; block-size: 100%; min-block-size: 36rem; } }
  .ch__laptop, .ch__phone { position: absolute; transform: rotateY(-18deg) rotateX(8deg) rotateZ(2deg); }

  /* web + 1 phone (NJWAR, RTL web: phone on the start side so the Arabic headline shows) */
  .ch--web1 .ch__laptop { inset-inline-start: 26%; inset-block-start: 14%; inline-size: 66%; }
  .ch--web1 .ch__phone--1 { inset-inline-start: 4%; inset-block-start: 8%; inline-size: 30%; z-index: 2; }
  /* Phones: pull the laptop in so the Arabic hero copy is not cut at the screen edge. */
  @media (width < 64rem) { .ch--web1 .ch__laptop { inset-inline-start: 18%; inline-size: 80%; } }
  /* web + 2 phones (Yawmy) */
  .ch--web2 .ch__laptop { inset-inline-start: 2%; inset-block-start: 14%; inline-size: 90%; }
  .ch--web2 .ch__phone--1 { inset-inline-start: 54%; inset-block-start: 10%; inline-size: 29%; z-index: 3; }
  .ch--web2 .ch__phone--2 { inset-inline-start: 72%; inset-block-start: 4%; inline-size: 26%; z-index: 2; opacity: 0.92; }
  /* 3 phones (Rushr) */
  .ch--phones .ch__phone--1 { inset-inline-start: 4%; inset-block-start: 10%; inline-size: 28%; z-index: 1; }
  .ch--phones .ch__phone--2 { inset-inline-start: 31%; inset-block-start: 2%; inline-size: 34%; z-index: 3; }
  .ch--phones .ch__phone--3 { inset-inline-start: 62%; inset-block-start: 12%; inline-size: 28%; z-index: 2; }
  @media (width >= 64rem) {
    .ch--web1 .ch__laptop, .ch--web2 .ch__laptop { inset-block-start: 24%; }
    .ch--web1 .ch__phone--1 { inset-block-start: 22%; }
    .ch--web2 .ch__phone--1 { inset-block-start: 26%; } .ch--web2 .ch__phone--2 { inset-block-start: 18%; }
    .ch--phones .ch__phone--1 { inset-block-start: 20%; } .ch--phones .ch__phone--2 { inset-block-start: 10%; } .ch--phones .ch__phone--3 { inset-block-start: 22%; }
  }
  @media (width >= 90rem) { .ch--web1 .ch__laptop { inline-size: 74%; } }
  :dir(rtl) .ch__laptop, :dir(rtl) .ch__phone { transform: rotateY(18deg) rotateX(8deg) rotateZ(-2deg); }
</style>

<script>
  // Sideways chapters: the arrows turn one page and grey out at the ends. Hidden until the script runs (no script = a plain swipe row).
  const rail = document.querySelector<HTMLElement>('[data-ch-rail]');
  const ctrl = document.querySelector<HTMLElement>('[data-ch-ctrl]');
  const prev = document.querySelector<HTMLButtonElement>('[data-ch-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-ch-next]');
  if (rail && ctrl && prev && next) {
    const total = rail.children.length;
    const rtl = () => getComputedStyle(rail).direction === 'rtl';
    const index = () => Math.min(total - 1, Math.max(0, Math.round(Math.abs(rail.scrollLeft) / rail.clientWidth)));
    const sync = () => {
      const i = index();
      prev.disabled = i === 0;
      next.disabled = i === total - 1;
    };
    const go = (dir: 1 | -1) => rail.scrollBy({ left: dir * (rtl() ? -1 : 1) * rail.clientWidth });
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    rail.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(rail);
    ctrl.hidden = false;
    sync();

    // Auto turn (Mohamed, Oct 21: it keeps sliding and never pauses): one page every 10 seconds while the row is on screen. Hover, focus and
    // taps do not stop it. A swipe, arrow or key press only restarts the 10-second timer, so it does not flip right after you moved it.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const EVERY = 10000;
      let inView = false;
      let nextAt = performance.now() + EVERY;
      const restart = () => { nextAt = performance.now() + EVERY; };
      for (const el of [prev, next]) el.addEventListener('click', restart);
      rail.addEventListener('wheel', restart, { passive: true });
      rail.addEventListener('touchstart', restart, { passive: true });
      rail.addEventListener('keydown', restart);
      new IntersectionObserver(([en]) => { inView = en.isIntersecting; if (inView) nextAt = Math.max(nextAt, performance.now() + 2500); }, { threshold: 0.5 }).observe(rail);
      setInterval(() => {
        if (!inView || document.hidden || performance.now() < nextAt) return;
        const i = index();
        restart();
        rail.scrollTo({ left: i >= total - 1 ? 0 : (i + 1) * rail.clientWidth * (rtl() ? -1 : 1) });
      }, 500);
    }
  }
</script>
