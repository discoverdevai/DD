---
// Project visual: an approved real product screen (assets/projects/, added only after the client approves screens,
// D-05) or the text-free drawing of the product type.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ProjectArt from './ProjectArt.astro';
import type { Project } from '../../content/copy/en/projects';
interface Props { project: Project; sizes?: string }
const { project, sizes = '(min-width: 64rem) 40vw, 100vw' } = Astro.props;
const screens = import.meta.glob<{ default: ImageMetadata }>('/assets/projects/*.{png,jpg,jpeg,webp}', { eager: true });
const screen = project.screen ? screens[`/assets/projects/${project.screen}`]?.default : undefined;
---
{screen
  ? <Image src={screen} alt="" widths={[480, 800, 1200]} sizes={sizes} class="pv__img" loading="lazy" decoding="async" />
  : <ProjectArt name={project.art} />}

<style>
  .pv__img { display: block; inline-size: 100%; block-size: auto; border-radius: var(--radius-md); }
</style>
