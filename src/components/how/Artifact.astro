<style>
  .art { display: block; inline-size: 100%; block-size: auto; }
  .art :global(.a-card) { fill: var(--blue-925); stroke: var(--color-hairline); }
  .art :global(.a-b) { fill: var(--blue-400); }
  .art :global(.a-b2) { fill: var(--blue-300); }
  .art :global(.a-b3) { fill: var(--blue-200); }
  .art :global(.a-g) { fill: var(--color-human-mark); }
  .art :global(.a-ring) { stroke: var(--color-bg); stroke-width: 2; }
  .art :global(.a-stroke) { fill: none; stroke: var(--blue-300); stroke-width: 2; }
  .art :global(.a-dash) { fill: none; stroke: var(--color-hairline); stroke-dasharray: 3 3; }
  .art :global(.a-dash-g) { fill: none; stroke: var(--color-human-mark); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .art :global(.a-thin) { fill: none; stroke: var(--color-hairline); stroke-width: 1.5; }
  .art :global(.a-tick) { fill: none; stroke: var(--color-bg); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .art :global(.a-line-g) { fill: none; stroke: var(--color-human-mark); stroke-width: 2; stroke-linecap: round; }
  .art :global(.a-line-b) { fill: none; stroke: var(--blue-400); stroke-width: 2; stroke-linecap: round; }
  .art :global(.a-track) { fill: none; stroke: var(--color-hairline); stroke-width: 5; }
  .art :global(.a-arc-b) { fill: none; stroke: var(--blue-400); stroke-width: 5; stroke-linecap: round; }
  .art :global(.a-arc-g) { fill: none; stroke: var(--color-human-mark); stroke-width: 5; stroke-linecap: round; }
  @media (forced-colors: active) { .art { forced-color-adjust: auto; } }
</style>
